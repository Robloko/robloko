local status = { now = "Ready", goal = "Pick a mode and press a button", queue = {} }

local function renderStatus()
    if ui.now then
        pcall(function()
            ui.now.Text = status.now
            ui.goal.Text = status.goal
            ui.queue.Text = #status.queue > 0 and ("Next: " .. table.concat(status.queue, "\n         ")) or ""
        end)
    end
end

local function setGoal(text, queue)
    status.goal = text or ""
    status.queue = queue or {}
    renderStatus()
end

local function setNow(text)
    status.now = text or ""
    renderStatus()
end

local function say(text, tone)
    setNow(text)
    if uiLog then
        pcall(uiLog, tone or "info", text)
    end
    print("[COCOON] " .. tostring(text))
end

-- ================= HELPERS =================
local function findFirstAvailablePlayer()
    for _, name in ipairs(TARGET_PLAYER_NAMES) do
        local p = Players:FindFirstChild(name)
        if p then
            return p
        end
    end
    return nil
end

local function getPlayerData()
    local ok, clientData = pcall(function()
        return require(ReplicatedStorage.ClientModules.Core.ClientData)
    end)
    if not ok then
        return nil
    end
    local ok2, data = pcall(function() return clientData.get_data() end)
    if not ok2 then
        return nil
    end
    return data and data[player.Name] or nil
end

local function findTargetItems(targetList)
    local found = {}
    local data = getPlayerData()
    if not data or not data.inventory then
        return found
    end
    for _, invType in ipairs({ "pets", "gifts" }) do
        if data.inventory[invType] then
            for uid, itemData in pairs(data.inventory[invType]) do
                if itemData.id then
                    local id = string.lower(itemData.id)
                    for _, target in ipairs(targetList) do
                        if id == target then
                            table.insert(found, { uid = uid, name = itemData.id, amount = itemData.amount or 1 })
                            break
                        end
                    end
                end
            end
        end
    end
    return found
end

local function findGifts()
    local gifts = {}
    local data = getPlayerData()
    if data and data.inventory and data.inventory.gifts then
        for uid, giftData in pairs(data.inventory.gifts) do
            if giftData.id and string.lower(giftData.id) == GIFT_TYPE then
                table.insert(gifts, { uid = uid, amount = giftData.amount or 1 })
            end
        end
    end
    return gifts
end

local function giveItem(targetPlayer, uid)
    local ok, result = pcall(function()
        return ReplicatedStorage:WaitForChild("API"):WaitForChild("TradeAPI/GiveItem"):InvokeServer(targetPlayer, uid)
    end)
    if ok then
        say("Gave item to " .. targetPlayer.Name, "ok")
        return true
    end
    say("Failed to give item: " .. tostring(result), "bad")
    return false
end

-- ================= TRAVEL (goTo Nursery etc.) =================
local interiorsM = nil

local function waitUntil(predicate, seconds)
    local deadline = os.clock() + seconds
    while os.clock() < deadline do
        local ok, result = pcall(predicate)
        if ok and result then
            return true
        end
        task.wait(0.1)
    end
    return false
end

local function currentPlace()
    local data = getPlayerData()
    local interior = data and data.house_interior
    if type(interior) ~= "table" then
        return nil
    end
    if type(interior.interior_name) == "string" then
        return interior.interior_name
    end
    return interior.house_pos ~= nil and "housing" or nil
end

local function isAt(place)
    local now = currentPlace()
    return type(now) == "string" and string.sub(now, 1, #place) == place
end

local function goTo(place)
    if not place or isAt(place) then
        return true
    end
    if not interiorsM then
        local ok, module = pcall(function()
            return require(ReplicatedStorage.ClientModules.Core.InteriorsM.InteriorsM)
        end)
        if not ok or type(module) ~= "table" or type(module.enter) ~= "function" then
            return false, "travel module not found"
        end
        interiorsM = module
    end
    say("Heading to " .. place .. "...")
    task.spawn(pcall, interiorsM.enter, place, "MainDoor", {})
    if waitUntil(function() return isAt(place) end, ARRIVAL_TIMEOUT) then
        task.wait(1)
        return true
    end
    return false, "could not reach " .. place .. " (still in " .. tostring(currentPlace()) .. ")"
end

-- ================= POTION RELEASER =================
local function findPetAgePotion()
    local data = getPlayerData()
    if data and data.inventory and data.inventory.food then
        for uniqueId, itemData in pairs(data.inventory.food) do
            if itemData.id == "pet_age_potion" then
                return uniqueId
            end
        end
    end
    return nil
end

local function safelyUnequipFood(itemId)
    pcall(function()
        ReplicatedStorage:WaitForChild("API"):WaitForChild("ToolAPI/Unequip"):InvokeServer(itemId)
    end)
end

local function equipTool(itemId)
    local ok = pcall(function()
        ReplicatedStorage:WaitForChild("API"):WaitForChild("ToolAPI/Equip"):InvokeServer(itemId, {
            use_sound_delay = true,
            equip_as_last = false
        })
    end)
    return ok
end

local function findPetsNeedingPotions()
    local petsNeedingPotions = {}
    local data = getPlayerData()
    if data and data.inventory and data.inventory.pets then
        for petUniqueId, petData in pairs(data.inventory.pets) do
            if petData.id and petData.properties then
                local petName = string.lower(petData.id)
                local petAge = petData.properties.age or 0
                for _, targetPet in ipairs(TARGET_PETS_FOR_POTIONS) do
                    if petName == targetPet and petAge < POTION_TARGET_AGE then
                        table.insert(petsNeedingPotions, {
                            uid = petUniqueId,
                            name = petData.id,
                            age = petAge,
                        })
                        break
                    end
                end
            end
        end
    end
    table.sort(petsNeedingPotions, function(a, b)
        return a.age < b.age
    end)
    return petsNeedingPotions
end

local function getPetAge(petUniqueId)
    local data = getPlayerData()
    if data and data.inventory and data.inventory.pets then
        for uid, petData in pairs(data.inventory.pets) do
            if uid == petUniqueId or petData.unique == petUniqueId then
                return petData.properties and petData.properties.age or 0, petData.id or "Unknown"
            end
        end
    end
    return nil, nil
end

local function usePotionOnPet(petUniqueId)
    local currentAge, petName = getPetAge(petUniqueId)
    if not currentAge or currentAge >= POTION_TARGET_AGE then
        say("Pet no longer needs potion: " .. tostring(petName), "warn")
        return false
    end

    if not equipTool(petUniqueId) then
        say("Failed to equip pet: " .. tostring(petName), "bad")
        return false
    end
    say("Equipped pet: " .. tostring(petName))
    task.wait(1)

    local potionId = findPetAgePotion()
    if not potionId then
        say("No potions found!", "bad")
        return false
    end
    if not equipTool(potionId) then
        say("Failed to equip potion", "bad")
        return false
    end
    task.wait(1)

    local startOk = pcall(function()
        ReplicatedStorage:WaitForChild("API"):WaitForChild("ToolAPI/ServerUseTool"):InvokeServer(potionId, "START")
    end)
    if not startOk then
        safelyUnequipFood(potionId)
        say("Failed to start using potion", "bad")
        return false
    end
    task.wait(1)

    local consumeOk = pcall(function()
        ReplicatedStorage:WaitForChild("API"):WaitForChild("PetObjectAPI/CreatePetObject"):InvokeServer(
            "__Enum_PetObjectCreatorType_2",
            {
                additional_consume_uniques = {},
                pet_unique = petUniqueId,
                unique_id = potionId,
            }
        )
    end)
    if not consumeOk then
        safelyUnequipFood(potionId)
        say("Failed to create pet object for consumption", "bad")
        return false
    end

    say("Waiting 9 s for potion to feed " .. tostring(petName) .. "...")
    local startTime = tick()
    repeat
        task.wait(0.1)
    until tick() - startTime >= 9
    say("Potion feed complete for " .. tostring(petName), "ok")

    safelyUnequipFood(potionId)
    return true
end

local function startPotionReleaser()
    while PotionMode do
        local petsNeedingPotions = findPetsNeedingPotions()
        if #petsNeedingPotions == 0 then
            say("No pets need potions. Waiting 30 s...", "warn")
            task.wait(30)
            continue
        end
        if not findPetAgePotion() then
            say("No potions available", "bad")
            task.wait(30)
            continue
        end

        say(#petsNeedingPotions .. " pets need potions")
        for _, petData in ipairs(petsNeedingPotions) do
            if not PotionMode then
                break
            end
            local currentAge = getPetAge(petData.uid)
            if currentAge and currentAge >= POTION_TARGET_AGE then
                say(petData.name .. " no longer needs potion (age: " .. currentAge .. ")", "warn")
                continue
            end
            if not usePotionOnPet(petData.uid) then
                task.wait(2)
            end
        end
        task.wait(5)
    end
end

-- ================= PET RECYCLER =================
local function findPetsToRecycle()
    local toRecycle = {}
    local data = getPlayerData()
    if data and data.inventory and data.inventory.pets then
        for petUniqueId, petData in pairs(data.inventory.pets) do
            if petData.id then
                local id = string.lower(petData.id)
                for _, target in ipairs(TARGET_PETS_FOR_RECYCLE) do
                    if id == target then
                        table.insert(toRecycle, { uid = petUniqueId, name = petData.id })
                        break
                    end
                end
            end
        end
    end
    return toRecycle
end

local function collectTickets()
    local ok, result = pcall(function()
        return ReplicatedStorage:WaitForChild("API"):FindFirstChild("PetRecyclerAPI/TicketsCollected"):InvokeServer()
    end)
    if not ok then
        say("Ticket collection failed: " .. tostring(result), "bad")
        return false
    end
    say("Tickets collected via PetRecyclerAPI", "ok")
    return true
end

local function recyclePets(pets)
    local character = player.Character
    if not character then
        say("No character found", "bad")
        return false
    end

    local ok, why = goTo("Nursery")
    if not ok then
        say("Could not reach the Nursery: " .. tostring(why), "bad")
        return false
    end

    pcall(function()
        ReplicatedStorage:WaitForChild("API"):FindFirstChild("AchievementsAPI/CompleteAchievement"):FireServer("visit_the_pet_releaser")
    end)
    task.wait(0.5)
    pcall(function()
        ReplicatedStorage:WaitForChild("API"):FindFirstChild("AchievementsAPI/CompleteAchievement"):FireServer("open_backpack")
    end)
    task.wait(0.5)

    local uniques = {}
    for _, pet in ipairs(pets) do
        uniques[pet.uid] = true
    end

    local recycleOk, result = pcall(function()
        return ReplicatedStorage:WaitForChild("API"):FindFirstChild("HousingAPI/ActivateInteriorFurniture"):InvokeServer(
            "f-3", "UseBlock", { uniques = uniques }, character)
    end)
    if not recycleOk then
        say("Recycle failed: " .. tostring(result), "bad")
        return false
    end

    say("Recycled " .. #pets .. " pets. Collecting tickets...", "ok")
    task.wait(3)
    if collectTickets() then
        task.wait(1)
        collectTickets()
    end
    return true
end

local function startPetRecycler()
    while RecycleMode do
        local pets = findPetsToRecycle()
        if #pets < RECYCLE_MIN_PETS then
            say(#pets .. "/" .. RECYCLE_MIN_PETS .. " recycle pets found. Waiting 30 s...", "warn")
            task.wait(30)
            continue
        end
        if not recyclePets(pets) then
            say("Retrying recycle in 10 s...", "warn")
            task.wait(10)
        else
            task.wait(5)
        end
    end
end

-- ================= EGG TRADING =================
local function addEggsToTrade(eggs)
    local maxEggs = math.min(#eggs, 18)
    local added = 0
    for i = 1, maxEggs do
        local success = pcall(function()
            ReplicatedStorage:WaitForChild("API"):WaitForChild("TradeAPI/AddItemToOffer"):FireServer(eggs[i].uid)
        end)
        if success then
            added += 1
            say("Added egg " .. i .. "/" .. maxEggs .. ": " .. eggs[i].name)
        end
        task.wait(0.2)
    end
    return added
end

local function tradeEggsWithPlayer(targetPlayer)
    say("Sending trade request to " .. targetPlayer.Name)
    local ok1 = pcall(function()
        ReplicatedStorage:WaitForChild("API"):WaitForChild("TradeAPI/SendTradeRequest"):FireServer(targetPlayer)
    end)
    if not ok1 then
        return false
    end
    task.wait(3)
    local ok2 = pcall(function()
        return ReplicatedStorage:WaitForChild("API"):WaitForChild("TradeAPI/AcceptOrDeclineTradeRequest"):InvokeServer(targetPlayer, true)
    end)
    if not ok2 then
        say("Failed to accept trade request", "bad")
        return false
    end
    task.wait(3)
    local eggs = findTargetItems(TARGET_EGGS)
    if #eggs == 0 then
        return false
    end
    local added = addEggsToTrade(eggs)
    if added == 0 then
        return false
    end
    task.wait(3)
    pcall(function()
        ReplicatedStorage:WaitForChild("API"):WaitForChild("TradeAPI/AcceptNegotiation"):FireServer()
    end)
    task.wait(6)
    local ok4 = pcall(function()
        ReplicatedStorage:WaitForChild("API"):WaitForChild("TradeAPI/ConfirmTrade"):FireServer()
    end)
    if ok4 then
        say("Trade completed: " .. added .. " eggs to " .. targetPlayer.Name, "ok")
        return true
    end
    say("Failed to confirm trade", "bad")
    return false
end

local function startEggTrader()
    while EggMode do
        local eggs = findTargetItems(TARGET_EGGS)
        if #eggs == 0 then
            say("No eggs left! Stopping.", "warn")
            EggMode = false
            break
        end
        local target = findFirstAvailablePlayer()
        if not target then
            say("No target player. Waiting...")
            task.wait(10)
            continue
        end
        if tradeEggsWithPlayer(target) then
            task.wait(math.random(8, 12))
        else
            say("Trade failed. Retrying in 15 s...", "warn")
            task.wait(15)
        end
    end
end

