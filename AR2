local function create(className, props, parent)
    local object = Instance.new(className)
    for key, value in pairs(props) do
        object[key] = value
    end
    object.Parent = parent
    return object
end

local function corner(parent, radius)
    create("UICorner", { CornerRadius = UDim.new(0, radius or 6) }, parent)
end

local function makeDraggable(handle, target)
    local dragging, startInput, startPos
    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging, startInput, startPos = true, input.Position, target.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - startInput
            target.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
end

local function text(parent, x, y, width, height, value, size, color, bold)
    return create("TextLabel", { Position = UDim2.fromOffset(x, y), Size = UDim2.fromOffset(width, height),
        BackgroundTransparency = 1, Text = value or "", TextColor3 = color or THEME.text, TextSize = size or 12,
        Font = bold and Enum.Font.GothamMedium or Enum.Font.Gotham, TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd }, parent)
end

local function toggleButton(parent, x, y, width, label, color, onClick)
    local b = create("TextButton", { Position = UDim2.fromOffset(x, y), Size = UDim2.fromOffset(width, 24),
        BackgroundColor3 = color, BorderSizePixel = 0, Text = label, TextColor3 = THEME.text,
        Font = Enum.Font.GothamMedium, TextSize = 11, AutoButtonColor = true }, parent)
    corner(b, 4)
    create("UIStroke", { Color = THEME.line, Thickness = 1 }, b)
    b.MouseButton1Click:Connect(function()
        pcall(onClick, b)
    end)
    return b
end

local function avatarImage()
    if type(getcustomasset) == "function" and type(writefile) == "function" then
        local file = GC.LogFolder .. "/" .. GC.AvatarUser .. ".png"
        local ok, image = pcall(function()
            if not (type(isfile) == "function" and isfile(file)) then
                if type(isfolder) == "function" and not isfolder(GC.LogFolder) then
                    makefolder(GC.LogFolder)
                end
                local data = game:HttpGet(GC.AvatarUrl)
                if type(data) ~= "string" or (string.sub(data, 1, 8) ~= "\137PNG\r\n\26\n" and string.sub(data, 1, 3) ~= "\255\216\255") then
                    error("not a picture")
                end
                writefile(file, data)
            end
            return getcustomasset(file)
        end)
        if ok and type(image) == "string" and image ~= "" then
            return image
        end
    end
    local ok, image = pcall(function()
        local userId = Players:GetUserIdFromNameAsync(GC.AvatarUser)
        return (Players:GetUserThumbnailAsync(userId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size48x48))
    end)
    return ok and type(image) == "string" and image or ""
end

local function window(width, height)
    if ui.screen and ui.screen.Parent then
        ui.screen:Destroy()
    end
    ui.screen = create("ScreenGui", { Name = "COCOON", ResetOnSpawn = false, DisplayOrder = 999 }, guiParent())
    local frame = create("Frame", { Size = UDim2.fromOffset(width, height), Position = UDim2.new(0, 16, 0.5, -height / 2),
        BackgroundColor3 = THEME.bg, BorderSizePixel = 0 }, ui.screen)
    corner(frame, 8)
    create("UIStroke", { Color = THEME.line, Thickness = 1 }, frame)
    local header = create("Frame", { Size = UDim2.new(1, 0, 0, 26), BackgroundTransparency = 1 }, frame)
    makeDraggable(header, frame)
    local avatar = create("ImageLabel", { Position = UDim2.fromOffset(8, 5), Size = UDim2.fromOffset(16, 16),
        BackgroundColor3 = THEME.field, BorderSizePixel = 0, Image = "" }, header)
    corner(avatar, 8)
    task.spawn(function()
        local image = avatarImage()
        if avatar.Parent then
            avatar.Image = image
        end
    end)
    text(header, 30, 0, width - 58, 26, "COCOON", 13, THEME.text, true)
    local close = create("TextButton", { Position = UDim2.fromOffset(width - 26, 1), Size = UDim2.fromOffset(22, 22),
        BackgroundTransparency = 1, Text = "×", TextColor3 = THEME.dim, Font = Enum.Font.GothamMedium, TextSize = 16 }, header)
    close.MouseButton1Click:Connect(function()
        EggMode, PetMode, GiftMode, TradeRequestMode, PotionMode, RecycleMode = false, false, false, false, false, false
        uiLog = nil
        ui.now = nil
        frame:Destroy()
    end)
    create("Frame", { Position = UDim2.fromOffset(0, 26), Size = UDim2.new(1, 0, 0, 1), BackgroundColor3 = THEME.line,
        BorderSizePixel = 0 }, frame)
    return frame
end

local function mainWindow()
    local width = 210
    local height = 265
    local frame = window(width, height)

    -- ============ MONEY / TICKET DISPLAY ============
    local statsBg = create("Frame", { Position = UDim2.fromOffset(8, 29), Size = UDim2.fromOffset(width - 16, 18),
        BackgroundColor3 = THEME.field, BorderSizePixel = 0 }, frame)
    corner(statsBg, 4)
    local moneyLabel = text(statsBg, 5, 1, (width - 26) / 2, 16, "💵 $0", 11, THEME.money, true)
    local ticketLabel = text(statsBg, (width - 16) / 2 + 3, 1, (width - 26) / 2, 16, "🎟️ 0", 11, THEME.ticket, true)

    task.spawn(function()
        while frame.Parent do
            local ok, d = pcall(function()
                local cd = require(ReplicatedStorage.ClientModules.Core.ClientData)
                return cd.get_data()[player.Name] or {}
            end)
            if ok and d then
                local money = d.money or 0
                local tickets = d.pet_recycler_tickets_2026 or 0
                moneyLabel.Text = "💵 $" .. tostring(money)
                ticketLabel.Text = "🎟️ " .. tostring(tickets)
            end
            task.wait(2)
        end
    end)

    -- ============ STATUS ============
    text(frame, 8, 51, 26, 13, "Now", 10, THEME.accent, true)
    ui.now = text(frame, 34, 51, width - 42, 13, status.now, 11, THEME.text, true)
    ui.goal = text(frame, 8, 66, width - 16, 12, status.goal, 10, THEME.dim)
    local logBox = create("TextLabel", { Position = UDim2.fromOffset(8, 80), Size = UDim2.fromOffset(width - 16, 40),
        BackgroundTransparency = 1, Text = "", RichText = true, TextColor3 = THEME.dim, Font = Enum.Font.Gotham, TextSize = 10,
        TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, TextWrapped = false,
        ClipsDescendants = true }, frame)
    renderStatus()
    local shown = {}
    local TONES = { ok = "#5ac878", bad = "#e65a5a", warn = "#d6a046", info = "#9a9aae" }
    uiLog = function(tone, message)
        local safe = string.gsub(string.gsub(string.gsub(tostring(message), "&", "&amp;"), "<", "&lt;"), ">", "&gt;")
        table.insert(shown, '<font color="' .. (TONES[tone] or TONES.info) .. '">' .. safe .. "</font>")
        while #shown > 3 do
            table.remove(shown, 1)
        end
        logBox.Text = table.concat(shown, "\n")
    end
    create("Frame", { Position = UDim2.fromOffset(8, 123), Size = UDim2.new(1, -16, 0, 1), BackgroundColor3 = THEME.line,
        BorderSizePixel = 0 }, frame)

    -- ============ COMPACT BUTTON GRID (2x3) ============
    local half = (width - 20) / 2
    local function gridButton(x, y, label, color, modeGet, starter, setName)
        local btn = toggleButton(frame, x, y, half, label .. " [OFF]", color, function(b)
            local on = not modeGet()
            setName(on)
            b.Text = label .. (on and " [ON]" or " [OFF]")
            b.BackgroundColor3 = on and THEME.ok or color
            if on then
                task.spawn(starter)
                say(label .. " started", "ok")
            else
                say(label .. " stopped", "warn")
            end
            return b
        end)
        return btn
    end

    local eggButton = gridButton(8, 130, "EGGS", MODE_COLORS.egg, function() return EggMode end, startEggTrader,
        function(on) EggMode = on end)
    local petButton = gridButton(12 + half, 130, "PETS", MODE_COLORS.pet, function() return PetMode end, startPetGiver,
        function(on) PetMode = on end)
    local giftButton = gridButton(8, 159, "GIFTS", MODE_COLORS.gift, function() return GiftMode end, startGiftGiver,
        function(on) GiftMode = on end)
    local reqButton = gridButton(12 + half, 159, "TRADE REQ", MODE_COLORS.req, function() return TradeRequestMode end,
        startTradeRequester, function(on) TradeRequestMode = on end)
    local potionButton = gridButton(8, 188, "POTIONS", MODE_COLORS.potion, function() return PotionMode end, startPotionReleaser,
        function(on) PotionMode = on end)
    local recycleButton = gridButton(12 + half, 188, "RECYCLE", MODE_COLORS.recycle, function() return RecycleMode end,
        startPetRecycler, function(on) RecycleMode = on end)

    task.spawn(function()
        local labels = { { eggButton, "EGGS", MODE_COLORS.egg, function() return EggMode end },
            { petButton, "PETS", MODE_COLORS.pet, function() return PetMode end },
            { giftButton, "GIFTS", MODE_COLORS.gift, function() return GiftMode end },
            { reqButton, "TRADE REQ", MODE_COLORS.req, function() return TradeRequestMode end },
            { potionButton, "POTIONS", MODE_COLORS.potion, function() return PotionMode end },
            { recycleButton, "RECYCLE", MODE_COLORS.recycle, function() return RecycleMode end } }
        while frame.Parent do
            task.wait(2)
            for _, entry in ipairs(labels) do
                local btn, label, color, get = entry[1], entry[2], entry[3], entry[4]
                if not get() and string.find(btn.Text, "ON", 1, true) then
                    btn.Text = label .. " [OFF]"
                    btn.BackgroundColor3 = color
                end
            end
        end
    end)

    text(frame, 8, 219, width - 16, 14, "Targets: " .. table.concat(TARGET_PLAYER_NAMES, ", "), 10, THEME.dim)
    create("Frame", { Position = UDim2.fromOffset(8, 236), Size = UDim2.new(1, -16, 0, 1), BackgroundColor3 = THEME.line,
        BorderSizePixel = 0 }, frame)
end

env.COCOON = {
    Stop = function()
        EggMode, PetMode, GiftMode, TradeRequestMode, PotionMode, RecycleMode = false, false, false, false, false, false
    end,
}

mainWindow()
say("Loaded. Targets: " .. table.concat(TARGET_PLAYER_NAMES, ", "), "ok")
