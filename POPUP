local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

local function guiPath(inst)
    local parts = {}
    while inst and inst ~= workspace do
        table.insert(parts, 1, inst.Name)
        if inst == PlayerGui then break end
        inst = inst.Parent
    end
    return table.concat(parts, ".")
end

local hooked = {}

local function hookAll(guiObject)
    for _, d in ipairs(guiObject:GetDescendants()) do
        if d:IsA("GuiButton") and not hooked[d] then
            hooked[d] = true
            d.MouseButton1Click:Connect(function()
                print("[Popup path] " .. guiPath(d))
            end)
        end
    end
end

-- watch the whole PlayerGui tree for new buttons (popups included)
local function watch(container)
    hookAll(container)
    container.DescendantAdded:Connect(function(d)
        if d:IsA("GuiButton") and not hooked[d] then
            hooked[d] = true
            d.MouseButton1Click:Connect(function()
                print("[Popup path] " .. guiPath(d))
            end)
        end
    end)
end

watch(PlayerGui)

-- your existing auto-clicker stays as-is
local function clickDialogButton()
    local button = PlayerGui:FindFirstChild("DialogApp")
        and PlayerGui.DialogApp:FindFirstChild("Dialog")
        and PlayerGui.DialogApp.Dialog:FindFirstChild("NormalDialog")
        and PlayerGui.DialogApp.Dialog.NormalDialog:FindFirstChild("Buttons")
        and PlayerGui.DialogApp.Dialog.NormalDialog.Buttons:FindFirstChild("ButtonTemplate")

    if button and button.Visible and button.Active and button:IsA("GuiButton") then
        if firesignal then
            firesignal(button.MouseButton1Down)
            task.wait(0.05)
            firesignal(button.MouseButton1Up)
            firesignal(button.MouseButton1Click)
        else
            button.MouseButton1Click:Fire()
        end
        task.wait(2)
    end
end

while task.wait(0.5) do
    pcall(clickDialogButton)
end
