local INVITE_DELAY      = 1.0
local FURNITURE_DWELL   = 20      -- default seconds per furniture
local BETWEEN_SUBJECTS  = 0.8
local BETWEEN_FURNITURE = 0.4
local HOLD_TIMEOUT      = 45      -- max seconds to keep retrying a pickup
local EJECT_TIME        = 0.4
local MAX_CONCURRENT    = 2       -- game allows holding 2 objects at once

