-- ================= STATUS / LOG =================
local ui = {}
local uiLog = nil
local status = { now = "Ready", goal = "Pick an action", queue = {} }

local function renderStatus()
    if ui.now then
        pcall(function()
            ui.now.Text = status.now
            ui.goal.Text = status.goal
            ui.queue.Text = #status.queue > 0 and ("Next: " .. table.concat(status.queue, "\n         ")) or ""
        end)
    end
end
local function setGoal(t, q) status.goal = t or ""; status.queue = q or {}; renderStatus() end
local function setNow(t) status.now = t or ""; renderStatus() end
local function say(text, tone)
    setNow(text)
    if uiLog then pcall(uiLog, tone or "info", text) end
    print("[COCOON] " .. tostring(text))
end

-- ================= COUNTERS =================
local function countPlayers() local n = 0; for _ in Players:GetPlayers() do n += 1 end; return n end
local function countPets()
    local f = workspace:FindFirstChild("Pets"); if not f then return 0 end
    local n = 0; for _ in f:GetChildren() do n += 1 end; return n
end
local function otherPlayers()
    local list = {}
    for _, p in ipairs(Players:GetPlayers()) do if p ~= player then table.insert(list, p) end end
    return list
end
local function petsOnServer()
    local f = workspace:FindFirstChild("Pets"); if not f then return {} end
    return f:GetChildren()
end

-- ================= API HELPERS =================
local function api(name) return ReplicatedStorage:WaitForChild("API"):FindFirstChild(name) end
local function callAPI(name, args, fire)
    local node = api(name)
    if not node then say("API missing: " .. name, "bad"); return false end
    local ok, err = pcall(function()
        if fire then node:FireServer(unpack(args)) else node:InvokeServer(unpack(args)) end
    end)
    if not ok then say("Call failed " .. name .. ": " .. tostring(err), "bad") end
    return ok
end

-- ================= BUTTON 1: CREATE FAMILY + INVITE ALL =================
local FamilyMode = false
local function createFamilyAndInvite()
    FamilyMode = true
    say("Creating family...", "info")
    if not callAPI("FamilyAPI/CreateFamily", {}) then
        say("Family creation failed (already in a family?)", "bad"); FamilyMode = false; return
    end
    say("Family created. Inviting everyone...", "ok")
    task.wait(1)
    local targets = otherPlayers()
    setGoal("Inviting " .. #targets .. " player(s)")
    for _, p in ipairs(targets) do
        if not FamilyMode then break end
        setGoal("Inviting " .. #targets, { p.Name })
        callAPI("FamilyAPI/InvitePlayer", { p })
        say("Family invite -> " .. p.Name, "ok")
        task.wait(INVITE_DELAY)
    end
    say("Family invite pass finished", "ok")
    FamilyMode = false
end

-- ================= BUTTON 2: CONCURRENT WORKER POOL =================
local TasksMode = false
local queue = {}
local heldSubjects = {}     -- [workerIndex] = object currently held by that worker
local activeWorkers = 0
local doneCount, totalCount = 0, 0

-- Invoke HoldBaby and CHECK THE RESULT. The server refuses while the pet is
-- still busy on food/drink or the hold cap (2) is full, so keep retrying
-- until it accepts, up to HOLD_TIMEOUT seconds.
local function holdWithRetry(obj, why)
    if not obj then return false end
    local node = api("AdoptAPI/HoldBaby")
    if not node then say("API missing: AdoptAPI/HoldBaby", "bad"); return false end

    local waited = 0
    while waited < HOLD_TIMEOUT do
        if not TasksMode then return false end
        local ok, res = pcall(node.InvokeServer, node, obj)
        if ok and res ~= false and res ~= nil then
            task.wait(0.5)
            return true
        end
        -- refused: show why, wait and try again
        setNow(string.format("%s: pickup refused (%d/%ds), retrying...",
            why, waited, HOLD_TIMEOUT))
        task.wait(1.5)
        waited += 1.5
    end
    say(why .. ": pickup FAILED after " .. HOLD_TIMEOUT .. "s", "bad")
    return false
end

local function eject(obj)
    if obj then
        callAPI("AdoptAPI/EjectBaby", { obj }, true)
    end
    task.wait(EJECT_TIME)
end

-- force-eject anything still held (stop button, X button, loop end)
local function ejectAllHeld()
    for id, obj in pairs(heldSubjects) do
        if obj then
            say("Force eject: " .. (obj.Name or "?"), "warn")
            pcall(eject, obj)
        end
        heldSubjects[id] = nil
    end
end

-- Worker: hold subject, run it through furniture list, ALWAYS eject at the end.
-- offset staggers which furniture this worker starts on so concurrent
-- subjects never sit on the same furniture at the same time.
local function processSubject(kind, obj, fList, offset, workerIndex)
    if not obj or not obj.Parent then return end
    local name = obj.Name or "?"
    heldSubjects[workerIndex] = obj   -- register so ejectAllHeld can free it

    say(kind .. ": " .. name .. " (held)", "info")
    if not holdWithRetry(obj, kind .. " " .. name .. " hold") then
        pcall(eject, obj)
        heldSubjects[workerIndex] = nil
        return
    end

    local n = #fList
    for i = 1, n do
        if not TasksMode then break end
        local f = fList[((i - 1 + offset) % n) + 1]
        setGoal(kind .. " " .. name .. " -> " .. f.label, { f.id })
        if kind == "Pet" then
            callAPI("HousingAPI/ActivateFurniture", { player, f.id, f.mode, { cframe = f.cframe }, obj })
        else
            callAPI("InteractablesAPI/MakeBabyUseFurniture", { obj, f.id, f.mode }, true)
        end
        local seconds = f.dwell or FURNITURE_DWELL
        local t = 0
        while t < seconds and TasksMode do
            setNow(string.format("%s %s on %s — %.0f/%ds", kind, name, f.label, t, seconds))
            task.wait(1); t += 1
        end
        task.wait(BETWEEN_FURNITURE)

        -- UNSTICK: pick the subject back up before moving to next furniture.
        -- Retries automatically if the server says it's still busy.
        if i < n then   -- no pickup needed before the final eject
            if not holdWithRetry(obj, kind .. " " .. name .. " unstick from " .. f.label) then
                -- couldn't pick it up: eject so the worker doesn't stall forever
                say(kind .. " " .. name .. ": unstick failed, ejecting", "warn")
                break
            end
            task.wait(0.3)
        end
    end
    -- ALWAYS eject, even if we broke out early (stopped / error)
    eject(obj)
    say(kind .. ": " .. name .. " ejected", "ok")
    heldSubjects[workerIndex] = nil
    task.wait(BETWEEN_SUBJECTS)
end

-- Worker loop: pull next subject from the shared queue
local function workerLoop(workerIndex)
    while TasksMode do
        local item = table.remove(queue, 1)
        if not item then break end
        activeWorkers += 1
        local ok, err = pcall(function()
            processSubject(item.kind, item.obj, item.flist, workerIndex, workerIndex)
        end)
        if not ok then
            say("Worker error: " .. tostring(err), "bad")
            -- safety net: make sure it got ejected even after an error
            pcall(eject, item.obj)
            heldSubjects[workerIndex] = nil
        end
        activeWorkers -= 1
        doneCount += 1
        say(string.format("Done %d/%d", doneCount, totalCount), "ok")
    end
end

local function startAllTasks()
    TasksMode = true
    doneCount, totalCount = 0, 0
    table.clear(queue)
    table.clear(heldSubjects)

    -- build queue: babies first, then pets
    local babies = otherPlayers()
    for _, p in ipairs(babies) do
        if p.Character then
            table.insert(queue, { kind = "Baby", obj = p.Character, flist = BABY_FURNITURE })
        end
    end
    for _, pet in ipairs(petsOnServer()) do
        table.insert(queue, { kind = "Pet", obj = pet, flist = PET_FURNITURE })
    end
    totalCount = #queue
    say(string.format("Queued %d subjects (%d babies, %d pets), %d workers",
        totalCount, #babies, totalCount - #babies, MAX_CONCURRENT), "info")

    -- spawn workers
    for i = 1, MAX_CONCURRENT do
        task.spawn(workerLoop, i)
    end

    -- wait until queue empty and all workers idle
    while TasksMode and (#queue > 0 or activeWorkers > 0) do
        setNow(string.format("Active: %d | Queue: %d | Done: %d/%d",
            activeWorkers, #queue, doneCount, totalCount))
        task.wait(1)
    end

    -- always run cleanup, whether finished normally or stopped
    TasksMode = false
    table.clear(queue)
    ejectAllHeld()
    say("Task loop finished, all subjects ejected", "ok")
end

