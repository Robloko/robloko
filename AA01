-- ================= MODES =================
local EggMode, PetMode, GiftMode, TradeRequestMode = false, false, false, false

-- ================= STATUS / LOG =================
local uiLog = nil
local ui = {}
local status = { now = "Ready", goal = "Pick a mode and press a button", queue = {} }

local function renderStatus()
    if ui.now then
        pcall(function()
            ui.now.Text = status.now
            ui.goal.Text = status.goal
            ui.queue.Text = #status.queue > 0 and ("Next: " .. table.concat(status.queue, "\n         ")) or ""
        end)
    end
end

local function setGoal(text, queue)
    status.goal = text or ""
    status.queue = queue or {}
    renderStatus()
end

local function setNow(text)
    status.now = text or ""
    renderStatus()
end

local function say(text, tone)
    setNow(text)
    if uiLog then
        pcall(uiLog, tone or "info", text)
    end
    print("[AutoGiver] " .. tostring(text))
end

local function show(title, desc, detail)
    setGoal(title or "", {})
    setNow((detail and detail ~= "") and detail or (desc or ""))
end

-- ================= HELPERS =================
local function findFirstAvailablePlayer()
    for _, name in ipairs(TARGET_PLAYER_NAMES) do
        local p = Players:FindFirstChild(name)
        if p then
            return p
        end
    end
    return nil
end

local function getPlayerData()
    local ok, clientData = pcall(function()
        return require(ReplicatedStorage.ClientModules.Core.ClientData)
    end)
    if not ok then
        return nil
    end
    local ok2, data = pcall(function() return clientData.get_data() end)
    if not ok2 then
        return nil
    end
    return data and data[LocalPlayer.Name] or nil
end

local function findTargetItems(targetList)
    local found = {}
    local data = getPlayerData()
    if not data or not data.inventory then
        return found
    end
    for _, invType in ipairs({ "pets", "gifts" }) do
        if data.inventory[invType] then
            for uid, itemData in pairs(data.inventory[invType]) do
                if itemData.id then
                    local id = string.lower(itemData.id)
                    for _, target in ipairs(targetList) do
                        if id == target then
                            table.insert(found, { uid = uid, name = itemData.id, amount = itemData.amount or 1 })
                            break
                        end
                    end
                end
            end
        end
    end
    return found
end

local function findGifts()
    local gifts = {}
    local data = getPlayerData()
    if data and data.inventory and data.inventory.gifts then
        for uid, giftData in pairs(data.inventory.gifts) do
            if giftData.id and string.lower(giftData.id) == GIFT_TYPE then
                table.insert(gifts, { uid = uid, amount = giftData.amount or 1 })
            end
        end
    end
    return gifts
end

local function giveItem(targetPlayer, uid)
    local ok, result = pcall(function()
        return ReplicatedStorage:WaitForChild("API"):WaitForChild("TradeAPI/GiveItem"):InvokeServer(targetPlayer, uid)
    end)
    if ok then
        say("Gave item to " .. targetPlayer.Name, "ok")
        return true
    end
    say("Failed to give item: " .. tostring(result), "bad")
    return false
end

-- ================= EGG TRADING =================
local function addEggsToTrade(eggs)
    local maxEggs = math.min(#eggs, 18)
    local added = 0
    for i = 1, maxEggs do
        local success = pcall(function()
            ReplicatedStorage:WaitForChild("API"):WaitForChild("TradeAPI/AddItemToOffer"):FireServer(eggs[i].uid)
        end)
        if success then
            added += 1
            say("Added egg " .. i .. "/" .. maxEggs .. ": " .. eggs[i].name)
        end
        task.wait(0.2)
    end
    return added
end

local function tradeEggsWithPlayer(targetPlayer)
    say("Sending trade request to " .. targetPlayer.Name)
    local ok1 = pcall(function()
        ReplicatedStorage:WaitForChild("API"):WaitForChild("TradeAPI/SendTradeRequest"):FireServer(targetPlayer)
    end)
    if not ok1 then
        return false
    end
    task.wait(3)
    local ok2 = pcall(function()
        return ReplicatedStorage:WaitForChild("API"):WaitForChild("TradeAPI/AcceptOrDeclineTradeRequest"):InvokeServer(targetPlayer, true)
    end)
    if not ok2 then
        say("Failed to accept trade request", "bad")
        return false
    end
    task.wait(3)
    local eggs = findTargetItems(TARGET_EGGS)
    if #eggs == 0 then
        return false
    end
    local added = addEggsToTrade(eggs)
    if added == 0 then
        return false
    end
    task.wait(3)
    pcall(function()
        ReplicatedStorage:WaitForChild("API"):WaitForChild("TradeAPI/AcceptNegotiation"):FireServer()
    end)
    task.wait(6)
    local ok4 = pcall(function()
        ReplicatedStorage:WaitForChild("API"):WaitForChild("TradeAPI/ConfirmTrade"):FireServer()
    end)
    if ok4 then
        say("Trade completed: " .. added .. " eggs to " .. targetPlayer.Name, "ok")
        return true
    end
    say("Failed to confirm trade", "bad")
    return false
end

local function startEggTrader()
    while EggMode do
        local eggs = findTargetItems(TARGET_EGGS)
        if #eggs == 0 then
            say("No eggs left! Stopping.", "warn")
            EggMode = false
            break
        end
        local target = findFirstAvailablePlayer()
        if not target then
            say("No target player. Waiting...")
            task.wait(10)
            continue
        end
        if tradeEggsWithPlayer(target) then
            task.wait(math.random(8, 12))
        else
            say("Trade failed. Retrying in 15 s...", "warn")
            task.wait(15)
        end
    end
end

-- ================= PET GIVER =================
local function startPetGiver()
    while PetMode do
        local target = findFirstAvailablePlayer()
        if not target then
            say("No target player. Waiting...")
            task.wait(10)
            continue
        end
        local pets = findTargetItems(TARGET_PETS)
        if #pets == 0 then
            say("No target pets left! Stopping.", "warn")
            PetMode = false
            break
        end
        if giveItem(target, pets[1].uid) then
            task.wait(9)
        else
            task.wait(3)
        end
    end
end

-- ================= GIFT GIVER =================
local function startGiftGiver()
    while GiftMode do
        local target = findFirstAvailablePlayer()
        if not target then
            say("No target player. Waiting...")
            task.wait(10)
            continue
        end
        local gifts = findGifts()
        if #gifts == 0 then
            say("All " .. GIFT_TYPE .. " given away! Stopping.", "warn")
            GiftMode = false
            break
        end
        local stack = gifts[1]
        if giveItem(target, stack.uid) then
            say("Gave " .. stack.amount .. "x " .. GIFT_TYPE .. " to " .. target.Name, "ok")
            task.wait(9)
        else
            task.wait(3)
        end
    end
end

-- ================= TRADE REQUEST ONLY =================
local function startTradeRequester()
    while TradeRequestMode do
        local target = findFirstAvailablePlayer()
        if not target then
            say("No target player. Waiting...")
            task.wait(10)
            continue
        end
        local ok = pcall(function()
            ReplicatedStorage:WaitForChild("API"):WaitForChild("TradeAPI/SendTradeRequest"):FireServer(target)
        end)
        if ok then
            say("Trade request sent to " .. target.Name, "ok")
        else
            say("Failed to send trade request", "bad")
        end
        task.wait(math.random(8, 15))
    end
end

-- ================= UI (AutoAchievements style) =================
local THEME = {
    bg = Color3.fromRGB(18, 18, 22), line = Color3.fromRGB(40, 40, 48), field = Color3.fromRGB(28, 28, 34),
    text = Color3.fromRGB(230, 230, 235), dim = Color3.fromRGB(130, 130, 145), accent = Color3.fromRGB(150, 120, 255),
    ok = Color3.fromRGB(90, 200, 120), bad = Color3.fromRGB(230, 90, 90),
}

local function guiParent()
    local ok, hui = pcall(function() return gethui and gethui() end)
    if ok and hui then
        return hui
    end
    local okCore, core = pcall(function() return game:GetService("CoreGui") end)
    if okCore and core then
        return core
    end
    return LocalPlayer:WaitForChild("PlayerGui")
end

local function create(className, props, parent)
    local object = Instance.new(className)
    for key, value in pairs(props) do
        object[key] = value
    end
    object.Parent = parent
    return object
end

local function corner(parent, radius)
    create("UICorner", { CornerRadius = UDim.new(0, radius or 6) }, parent)
end

local function makeDraggable(handle, target)
    local dragging, startInput, startPos
    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging, startInput, startPos = true, input.Position, target.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - startInput
            target.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
end

local function text(parent, x, y, width, height, value, size, color, bold)
    return create("TextLabel", { Position = UDim2.fromOffset(x, y), Size = UDim2.fromOffset(width, height),
        BackgroundTransparency = 1, Text = value or "", TextColor3 = color or THEME.text, TextSize = size or 12,
        Font = bold and Enum.Font.GothamMedium or Enum.Font.Gotham, TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd }, parent)
end

-- Button style copied from the AutoAchievements script:
-- dark field bg, 5px corner, 1px stroke, colored text, 24px tall.
local function button(parent, x, y, width, value, color, onClick)
    local b = create("TextButton", { Position = UDim2.fromOffset(x, y), Size = UDim2.fromOffset(width, 24),
        BackgroundColor3 = THEME.field, BorderSizePixel = 0, Text = value, TextColor3 = color or THEME.text,
        Font = Enum.Font.GothamMedium, TextSize = 12, AutoButtonColor = true }, parent)
    corner(b, 5)
    create("UIStroke", { Color = THEME.line, Thickness = 1 }, b)
    b.MouseButton1Click:Connect(function()
        pcall(onClick)
    end)
    return b
end

local function window(width, height, onClose)
    if ui.screen and ui.screen.Parent then
        ui.screen:Destroy()
    end
    ui.screen = create("ScreenGui", { Name = "AutoGiver", ResetOnSpawn = false, DisplayOrder = 999 }, guiParent())
    local frame = create("Frame", { Size = UDim2.fromOffset(width, height), Position = UDim2.new(0, 16, 0.5, -height / 2),
        BackgroundColor3 = THEME.bg, BorderSizePixel = 0 }, ui.screen)
    corner(frame, 8)
    create("UIStroke", { Color = THEME.line, Thickness = 1 }, frame)
    local header = create("Frame", { Size = UDim2.new(1, 0, 0, 30), BackgroundTransparency = 1 }, frame)
    makeDraggable(header, frame)
    text(header, 10, 0, width - 48, 30, "Auto Giver", 13, THEME.text, true)
    local close = create("TextButton", { Position = UDim2.fromOffset(width - 28, 3), Size = UDim2.fromOffset(24, 24),
        BackgroundTransparency = 1, Text = "×", TextColor3 = THEME.dim, Font = Enum.Font.GothamMedium, TextSize = 18 }, header)
    close.MouseButton1Click:Connect(function()
        frame:Destroy()
        if onClose then
            pcall(onClose)
        end
    end)
    create("Frame", { Position = UDim2.fromOffset(0, 30), Size = UDim2.new(1, 0, 0, 1), BackgroundColor3 = THEME.line,
        BorderSizePixel = 0 }, frame)
    return frame
end

local function footer(frame, width, y)
    text(frame, 10, y, width - 20, 16, "Targets: " .. table.concat(TARGET_PLAYER_NAMES, ", "), 11, THEME.dim)
end

-- ================= MAIN WINDOW =================
local function mainWindow()
    local width = 270
    local frame = window(width, 320, function()
        EggMode, PetMode, GiftMode, TradeRequestMode = false, false, false, false
        uiLog = nil
        ui.now = nil
    end)

    text(frame, 10, 36, 40, 16, "Now", 11, THEME.accent, true)
    ui.now = text(frame, 48, 36, width - 58, 16, status.now, 12, THEME.text, true)
    text(frame, 10, 54, 40, 14, "Goal", 11, THEME.accent, true)
    ui.goal = text(frame, 48, 54, width - 58, 14, status.goal, 11, THEME.text)
    ui.queue = create("TextLabel", { Position = UDim2.fromOffset(10, 72), Size = UDim2.fromOffset(width - 20, 22),
        BackgroundTransparency = 1, Text = "", TextColor3 = THEME.dim, Font = Enum.Font.Gotham, TextSize = 11,
        TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, TextWrapped = false,
        ClipsDescendants = true }, frame)
    create("Frame", { Position = UDim2.fromOffset(10, 98), Size = UDim2.new(1, -20, 0, 1), BackgroundColor3 = THEME.line,
        BorderSizePixel = 0 }, frame)
    renderStatus()

    local logBox = create("TextLabel", { Position = UDim2.fromOffset(10, 104), Size = UDim2.fromOffset(width - 20, 56),
        BackgroundTransparency = 1, Text = "", RichText = true, TextColor3 = THEME.dim, Font = Enum.Font.Gotham, TextSize = 11,
        TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Bottom, TextWrapped = false,
        ClipsDescendants = true }, frame)
    local shown = {}
    local TONES = { ok = "#5ac878", bad = "#e65a5a", warn = "#d6a046", info = "#9a9aae" }
    uiLog = function(tone, message)
        local safe = string.gsub(string.gsub(string.gsub(tostring(message), "&", "&amp;"), "<", "&lt;"), ">", "&gt;")
        table.insert(shown, '<font color="' .. (TONES[tone] or TONES.info) .. '">' .. safe .. "</font>")
        while #shown > 4 do
            table.remove(shown, 1)
        end
        logBox.Text = table.concat(shown, "\n")
    end

    -- Mode accent colors (used as the OFF text color)
    local MODE_COLORS = {
        egg = Color3.fromRGB(220, 170, 60), pet = Color3.fromRGB(90, 170, 230),
        gift = Color3.fromRGB(210, 130, 210), req = Color3.fromRGB(200, 130, 90),
    }

    -- Generic mode toggle using the AutoAchievements button style
    local function modeButton(y, label, color, getMode, setMode, starter)
        local b = button(frame, 10, y, width - 20, label, color, function()
            local on = not getMode()
            setMode(on)
            b.Text = label .. (on and " [ON]" or " [OFF]")
            b.TextColor3 = on and THEME.ok or color
            if on then
                task.spawn(starter)
                say(label .. " started", "ok")
            else
                say(label .. " stopped", "warn")
            end
        end)
        return b, label
    end

    local eggButton, eggLabel = modeButton(168, "TRADE EGGS", MODE_COLORS.egg,
        function() return EggMode end, function(v) EggMode = v end, startEggTrader)
    local petButton, petLabel = modeButton(198, "GIVE PETS", MODE_COLORS.pet,
        function() return PetMode end, function(v) PetMode = v end, startPetGiver)
    local giftButton, giftLabel = modeButton(228, "GIVE GIFTS", MODE_COLORS.gift,
        function() return GiftMode end, function(v) GiftMode = v end, startGiftGiver)
    local reqButton, reqLabel = modeButton(258, "SEND TRADE REQ", MODE_COLORS.req,
        function() return TradeRequestMode end, function(v) TradeRequestMode = v end, startTradeRequester)

    -- Stop All button, same style
    button(frame, 10, 288, width - 20, "Stop All", THEME.bad, function()
        EggMode, PetMode, GiftMode, TradeRequestMode = false, false, false, false
        show("Stopped", "All modes off", "")
    end)

    -- Keep buttons in sync when a loop stops itself (out of items)
    task.spawn(function()
        local pairs_ = {
            { eggButton, eggLabel, MODE_COLORS.egg, function() return EggMode end },
            { petButton, petLabel, MODE_COLORS.pet, function() return PetMode end },
            { giftButton, giftLabel, MODE_COLORS.gift, function() return GiftMode end },
            { reqButton, reqLabel, MODE_COLORS.req, function() return TradeRequestMode end },
        }
        while true do
            task.wait(2)
            for _, entry in ipairs(pairs_) do
                local b, label, color, getMode = entry[1], entry[2], entry[3], entry[4]
                if not getMode() and b.Text == label .. " [ON]" then
                    b.Text = label .. " [OFF]"
                    b.TextColor3 = color
                end
            end
        end
    end)

    footer(frame, width, 316)
end

env.AutoGiver = {
    Stop = function()
        EggMode, PetMode, GiftMode, TradeRequestMode = false, false, false, false
    end,
}

mainWindow()
