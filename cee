local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

local function clickDialogButton()
    local button = PlayerGui:FindFirstChild("DialogApp")
        and PlayerGui.DialogApp:FindFirstChild("Dialog")
        and PlayerGui.DialogApp.Dialog:FindFirstChild("NormalDialog")
        and PlayerGui.DialogApp.Dialog.NormalDialog:FindFirstChild("Buttons")
        and PlayerGui.DialogApp.Dialog.NormalDialog.Buttons:FindFirstChild("ButtonTemplate")

    if button then
        if button.Visible and button.Active and button:IsA("GuiButton") then

            if firesignal then
                firesignal(button.MouseButton1Down)
                task.wait(0.05)
                firesignal(button.MouseButton1Up)
                firesignal(button.MouseButton1Click)
                print("Successfully clicked ButtonTemplate!")
            else
                button.MouseButton1Click:Fire()
                print("Successfully clicked ButtonTemplate!")
            end

            task.wait(2)
        end
    end
end

while task.wait(0.5) do
    pcall(clickDialogButton)
