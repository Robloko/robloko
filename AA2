-- ==================================================================
-- SECTION 2: Giver subsystem (rewritten to use Script 1 helpers)
-- ==================================================================
do
    -- ---- config (your accounts) ----
    local TARGET_PLAYER_NAMES = { "Ndalynna", "Veronnau" }
    local GIFT_TYPE = "2d_tuesdays_2025_box"

    local TARGET_EGGS = {
        "halloween_2026_stray_cat_dragon","halloween_2026_poltergeist_box","halloween_2026_skelicorn",
        "fairytale_egg_2026_fairytale_egg","pet_progression_2026_purrowl","admin_abuse_egg_2026_egg",
        "winter_2024_frostclaw","halloween_2024_scarebear","endangered_2026_endangered_egg",
        "lny_2026_fire_foal","lny_2026_fire_mare","lny_2026_fire_stallion","aztec_egg_2025_aztec_egg",
        "winter_2025_angus_cow","winter_2025_angus_calf","winter_2025_angus_bull","halloween_2025_bat_cat",
        "basic_egg_2022_alicorn","basic_egg_2022_ancient_dragon","basic_egg_2022_dragonfly",
        "pet_recycler_2025_basic_egg","pet_recycler_2025_crystal_egg","summer_2026_acorn_box",
    }
    local TARGET_PETS = {
        "halloween_2026_pandaguin_glooptodog","halloween_2026_stitches","halloween_2026_tomb_spider",
        "halloween_2026_jump_scare","roblox_anniversary_2026_blue_cat","roblox_anniversary_2026_pink_dog",
        "birthday_2026_birthday_butterfly","summer_2026_sheepdog","summer_2026_river_otter",
        "summer_2026_snake_tail_dragonfly","journey_2026_sheepdog_duck","journey_2026_pilot_gull",
        "summerfest_2024_cow_calf","halloween_2023_slime","sugarfest_2026_jiggly_jerboa",
        "sugarfest_2026_wyrm_placeholder","sugarfest_2026_cocoadile","egg_teaser_2026_dire_wolf",
        "lny_2026_fire_foal","valentines_2026_cherub_chipmunk","inspector_shepherd_2026_magpie",
        "winter_2024_frostbite_cub","winter_2025_angus_cow","winter_2025_angus_calf",
        "winter_2025_maine_coon","winter_2025_turtle_doves","winter_2025_xmas_tree_sasquatch",
        "winter_2025_humbug","basic_egg_2022_ant","basic_egg_2022_mouse","basic_egg_2022_camel",
        "basic_egg_2022_poodle","basic_egg_2022_donkey","basic_egg_2022_zebra",
        "basic_egg_2022_orangutan","basic_egg_2022_parakeet","basic_egg_2022_swordfish",
        "basic_egg_2022_robot","basic_egg_2022_corgi",
    }

    local eggMode, petMode, giftMode = false, false, false

    local function dbg(msg) print("[Giver] " .. msg) end
    local function anyMode() return eggMode or petMode or giftMode end

    -- Reuse Script 1's helpers: `getKey`, `itemsOf`, `isEgg`, `isTemporary`,
    -- `goTo`, `currentPlace`, `LocalPlayer`. These are in scope because
    -- Section 2 is pasted inside the same file, after mainWindow().
    -- (They are locals, so we must run this section in the same chunk —
    --  which is the case: everything is one file.)

    local function targetPlayer()
        for _, name in ipairs(TARGET_PLAYER_NAMES) do
            local p = Players:FindFirstChild(name)
            if p and p ~= LocalPlayer then return p end
        end
        return nil
    end

    -- Egg: must be in "pets" inventory, be an egg, and be tradeable.
    local function eligibleEggs()
        local set = {}
        for _, id in ipairs(TARGET_EGGS) do set[id] = true end
        local out = {}
        for _, pet in ipairs(itemsOf("pets", set)) do
            if isEgg(pet.id) and not isTemporary(pet.id) then
                table.insert(out, pet)
            end
        end
        return out
    end

    -- Pet: in "pets", not an egg, not temporary, not equipped, not in pen.
    local function eligiblePets()
        local set = {}
        for _, id in ipairs(TARGET_PETS) do set[id] = true end
        local out = {}
        local inPen = penPets()
        for _, pet in ipairs(itemsOf("pets", set)) do
            if not isEgg(pet.id) and not isTemporary(pet.id)
                and not inPen[pet.unique] and not isEquipped(pet.unique) then
                table.insert(out, pet)
            end
        end
        return out
    end

    -- Gift: in "gifts" inventory matching GIFT_TYPE.
    local function eligibleGifts()
        local out = {}
        for _, item in ipairs(itemsOf("gifts", { [GIFT_TYPE] = true })) do
            table.insert(out, item)
        end
        return out
    end

    -- ---- trade flow (fixed) ----
    local function addEggsToTrade(eggs)
        local api = ReplicatedStorage:WaitForChild("API", 15)
        local add = api:FindFirstChild("TradeAPI/AddItemToOffer")
        if not add then return 0 end
        local n = math.min(#eggs, 18)
        local added = 0
        for i = 1, n do
            local ok = pcall(function() add:FireServer(eggs[i].unique) end)
            if ok then added += 1 end
            task.wait(0.2)
        end
        return added
    end

    local function tradeEggsWithPlayer(target)
        local api = ReplicatedStorage:WaitForChild("API", 15)
        local sendReq  = api:FindFirstChild("TradeAPI/SendTradeRequest")
        local acceptReq= api:FindFirstChild("TradeAPI/AcceptOrDeclineTradeRequest")
        local addItem  = api:FindFirstChild("TradeAPI/AddItemToOffer")
        local acceptN  = api:FindFirstChild("TradeAPI/AcceptNegotiation")
        local confirm  = api:FindFirstChild("TradeAPI/ConfirmTrade")
        if not (sendReq and acceptReq and addItem and acceptN and confirm) then
            dbg("trade remotes missing"); return false
        end

        dbg("requesting trade with " .. target.Name)
        local ok1 = pcall(function() sendReq:FireServer(target) end)
        if not ok1 then dbg("send request failed"); return false end
        task.wait(3)

        -- target must have accepted; poll accept/decline with true
        local accepted = false
        for _ = 1, 6 do
            local ok, res = pcall(function() return acceptReq:InvokeServer(target, true) end)
            if ok and res ~= false then accepted = true; break end
            task.wait(2)
        end
        if not accepted then dbg("target did not accept"); return false end
        task.wait(2)

        local eggs = eligibleEggs()
        if #eggs == 0 then dbg("no eligible eggs"); return false end
        local added = addEggsToTrade(eggs)
        if added == 0 then dbg("no eggs added"); return false end
        task.wait(3)

        if not pcall(function() acceptN:FireServer() end) then
            dbg("negotiation accept failed"); return false
        end
        task.wait(6)

        local done = pcall(function() confirm:FireServer() end)
        dbg(done and ("traded " .. added .. " eggs") or "confirm failed")
        return done
    end

    local function startEggTrader()
        while eggMode do
            if running then dbg("achievements running — pausing giver"); task.wait(5); continue end
            if #eligibleEggs() == 0 then dbg("no eggs left"); eggMode = false; break end
            local t = targetPlayer()
            if not t then dbg("no target online"); task.wait(10); continue end
            if tradeEggsWithPlayer(t) then task.wait(math.random(8, 12))
            else task.wait(15) end
        end
    end

    -- ---- instant give (pets + gifts) ----
    local function giveItem(target, unique)
        local api = ReplicatedStorage:WaitForChild("API", 15)
        local give = api:FindFirstChild("TradeAPI/GiveItem")
        if not give then dbg("GiveItem missing"); return false end
        local ok, res = pcall(function() return give:InvokeServer(target, unique) end)
        dbg(ok and "gave item" or ("give failed: " .. tostring(res)))
        return ok
    end

    local function startPetGiver()
        while petMode do
            if running then task.wait(5); continue end
            local t = targetPlayer()
            if not t then task.wait(10); continue end
            local pets = eligiblePets()
            if #pets == 0 then dbg("no target pets left"); petMode = false; break end
            if giveItem(t, pets[1].unique) then task.wait(9) else task.wait(3) end
        end
    end

    local function startGiftGiver()
        while giftMode do
            if running then task.wait(5); continue end
            local t = targetPlayer()
            if not t then task.wait(10); continue end
            local gifts = eligibleGifts()
            if #gifts == 0 then dbg("all gifts given"); giftMode = false; break end
            if giveItem(t, gifts[1].unique) then task.wait(9) else task.wait(3) end
        end
    end

    -- ---- giver UI, added to the shared ScreenGui ----
    local THEME = { -- matches Script 1's palette
        bg = Color3.fromRGB(18,18,22), line = Color3.fromRGB(40,40,48),
        field = Color3.fromRGB(28,28,34), text = Color3.fromRGB(230,230,235),
        dim = Color3.fromRGB(130,130,145), accent = Color3.fromRGB(150,120,255),
        ok = Color3.fromRGB(90,200,120), bad = Color3.fromRGB(230,90,90),
        egg = Color3.fromRGB(200,150,0), pet = Color3.fromRGB(0,120,200),
        gift = Color3.fromRGB(200,100,200),
    }

    local function create(cls, props, parent)
        local o = Instance.new(cls)
        for k, v in pairs(props) do o[k] = v end
        o.Parent = parent
        return o
    end
    local function corner(p, r)
        create("UICorner", { CornerRadius = UDim.new(0, r or 6) }, p)
    end

    -- Parent to the same ScreenGui Script 1 created (ui.screen is a local,
    -- but the ScreenGui is findable by name in CoreGui/PlayerGui).
    local function sharedScreen()
        if ui and ui.screen then return ui.screen end
        local parent = (gethui and gethui()) or game:GetService("CoreGui") or LocalPlayer:WaitForChild("PlayerGui")
        local existing = parent:FindFirstChild("CombinedTools")
        if existing then return existing end
        return create("ScreenGui", { Name = "CombinedTools", ResetOnSpawn = false, DisplayOrder = 998 }, parent)
    end

    local screen = sharedScreen()
    local frame = create("Frame", {
        Size = UDim2.fromOffset(200, 160),
        Position = UDim2.new(0, 300, 0.5, -80),  -- offset from achievements panel
        BackgroundColor3 = THEME.bg, BorderSizePixel = 0,
    }, screen)
    corner(frame, 8)
    create("UIStroke", { Color = THEME.line, Thickness = 1 }, frame)

    -- draggable
    local drag, ds, sp = false, nil, nil
    frame.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            drag, ds, sp = true, i.Position, frame.Position
            i.Changed:Connect(function()
                if i.UserInputState == Enum.UserInputState.End then drag = false end
            end)
        end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if drag and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
            local d = i.Position - ds
            frame.Position = UDim2.new(sp.X.Scale, sp.X.Offset + d.X, sp.Y.Scale, sp.Y.Offset + d.Y)
        end
    end)

    create("TextLabel", {
        Size = UDim2.new(1,0,0,24), BackgroundTransparency = 1,
        Text = "Giver (your accounts)", TextColor3 = THEME.text,
        Font = Enum.Font.GothamMedium, TextSize = 12,
    }, frame)

    local function makeBtn(y, label, color, get, set, starter)
        local b = create("TextButton", {
            Position = UDim2.fromOffset(12, y), Size = UDim2.new(1, -24, 0, 28),
            BackgroundColor3 = color, BorderSizePixel = 0,
            Text = label .. " [OFF]", TextColor3 = THEME.text,
            Font = Enum.Font.GothamMedium, TextSize = 12,
        }, frame)
        corner(b, 4)
        create("UIStroke", { Color = THEME.line, Thickness = 1 }, b)
        b.MouseButton1Click:Connect(function()
            if running then
                setNow("Stop achievements first")
                return
            end
            local on = not get()
            set(on)
            b.Text = label .. (on and " [ON]" or " [OFF]")
            b.BackgroundColor3 = on and THEME.ok or color
            if on then task.spawn(starter) end
        end)
        return b
    end

    makeBtn(32, "TRADE EGGS", THEME.egg,
        function() return eggMode end, function(v) eggMode = v end, startEggTrader)
    makeBtn(68, "GIVE PETS", THEME.pet,
        function() return petMode end, function(v) petMode = v end, startPetGiver)
    makeBtn(104, "GIVE GIFTS", THEME.gift,
        function() return giftMode end, function(v) giftMode = v end, startGiftGiver)

    create("TextLabel", {
        Position = UDim2.fromOffset(12, 136), Size = UDim2.new(1,-24,0,16),
        BackgroundTransparency = 1, Text = "→ " .. table.concat(TARGET_PLAYER_NAMES, ", "),
        TextColor3 = THEME.dim, Font = Enum.Font.Gotham, TextSize = 10,
    }, frame)

    env.AutoAchievements = env.AutoAchievements or {}
    env.AutoAchievements.Giver = {
        Stop = function() eggMode, petMode, giftMode = false, false, false end,
    }
end

mainWindow()
