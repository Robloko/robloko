-- ==================================================================
-- COCOON v13 — Pair-based bathtub placement
-- 2 players per step -> different tubs -> repeat -> 15s -> hold+eject
-- Hold:   AdoptAPI/HoldBaby:InvokeServer(unpack({ [1] = Char }))
-- Eject:  AdoptAPI/EjectBaby:FireServer(unpack({ [1] = Char }))
-- Place:  InteractablesAPI/MakeBabyUseFurniture:FireServer(Char, folderId, partName)
-- ==================================================================
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")
local player = Players.LocalPlayer

local env = getgenv and getgenv() or {}
if env.COCOON and env.COCOON.Stop then pcall(env.COCOON.Stop) end

-- ================= CONFIG =================
local INVITE_DELAY     = 1.0
local FAMILY_SETTLE    = 2.0
local BATCH_DWELL      = 15
local HOLD_STEP_DELAY  = 0.8
local PLACE_STEP_DELAY = 0.6
local EJECT_STEP_DELAY = 0.6
local BETWEEN_PAIRS    = 2.0    -- pause between (hold2 -> place2) groups

local BATHTUB_NAME = "CheapPetBathtub"

-- ================= STATUS / LOG =================
local ui = {}
local uiLog = nil
local status = { now = "Ready", goal = "Pick an action", queue = {} }

local function renderStatus()
    if ui.now then
        pcall(function()
            ui.now.Text  = status.now
            ui.goal.Text = status.goal
            ui.queue.Text = #status.queue > 0 and ("Next: " .. table.concat(status.queue, "\n         ")) or ""
        end)
    end
end
local function setGoal(t, q) status.goal = t or ""; status.queue = q or {}; renderStatus() end
local function setNow(t) status.now = t or ""; renderStatus() end
local function say(text, tone)
    setNow(text)
    if uiLog then pcall(uiLog, tone or "info", text) end
    print("[COCOON] " .. tostring(text))
end

-- ================= COUNTERS / ROSTER =================
local function countPlayers() return #Players:GetPlayers() end
local function countPets()
    local f = workspace:FindFirstChild("Pets"); if not f then return 0 end
    return #f:GetChildren()
end
local function otherPlayers()
    local list = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player then table.insert(list, p) end
    end
    return list
end
local function allCharacters()
    local list = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Character then table.insert(list, p.Character) end
    end
    return list
end

-- ================= API HELPERS =================
local API_ROOT = ReplicatedStorage:WaitForChild("API")
local function api(name) return API_ROOT:FindFirstChild(name) end

local function inviteMethodA(name)
    if type(name) ~= "string" or name == "" then return false end
    local target = game:GetService("Players"):FindFirstChild(name); if not target then return false end
    local node = api("FamilyAPI/InvitePlayer"); if not node then return false end
    return pcall(function() node:InvokeServer(unpack({ [1] = target })) end)
end
local function inviteMethodB(name)
    if type(name) ~= "string" or name == "" then return false end
    local target = game:GetService("Players")[name]; if not target then return false end
    local node = api("FamilyAPI/InvitePlayer"); if not node then return false end
    return pcall(function() node:InvokeServer(unpack({ [1] = target })) end)
end

-- ==================================================================
-- FURNITURE / BATHTUB DISCOVERY
-- ==================================================================
local function ownerFromFolder(folderName) return (string.match(folderName, "^([^/]+)/") or folderName) end
local function folderIdFromFolder(folderName) return (string.match(folderName, "f%-%d+") or folderName) end

local function resolveActivation(model)
    if not model then return nil end
    local function tryName(container, name)
        local p = container and container:FindFirstChild(name)
        if p and p:IsA("BasePart") then
            return { partName = name, cframe = p.CFrame, position = p.Position }
        end
        return nil
    end
    local useBlocks = model:FindFirstChild("UseBlocks")
    if useBlocks then
        for _, name in ipairs({ "Seat1", "UseBlock" }) do
            local r = tryName(useBlocks, name); if r then return r end
        end
    end
    for _, name in ipairs({ "Seat1", "UseBlock" }) do
        local r = tryName(model, name); if r then return r end
    end
    for _, d in ipairs(model:GetDescendants()) do
        if d:IsA("BasePart") then
            return { partName = d.Name, cframe = d.CFrame, position = d.Position }
        end
    end
    return nil
end

-- Returns a flat list of every CheapPetBathtub found across ALL houses.
-- Each entry is a UNIQUE tub: { owner, folderId, folderName, modelName, partName, cframe, model, path }
local function findAllBathtubs()
    local out = {}
    local hi = Workspace:FindFirstChild("HouseInteriors"); if not hi then return out end
    local furniture = hi:FindFirstChild("furniture"); if not furniture then return out end

    for _, folder in ipairs(furniture:GetChildren()) do
        local owner = ownerFromFolder(folder.Name)
        local folderId = folderIdFromFolder(folder.Name)

        local function walk(node, prefix)
            for _, child in ipairs(node:GetChildren()) do
                if child.Name:lower() == BATHTUB_NAME:lower()
                    and (child:IsA("Model") or child:IsA("Folder")) then
                    local act = resolveActivation(child)
                    if act then
                        table.insert(out, {
                            owner = owner,
                            folderId = folderId,
                            folderName = folder.Name,
                            modelName = child.Name,
                            model = child,
                            partName = act.partName,
                            cframe = act.cframe,
                            path = prefix .. "." .. child.Name,
                        })
                    end
                end
                if child:IsA("Folder") or child:IsA("Model") then
                    walk(child, prefix .. "." .. child.Name)
                end
            end
        end
        walk(folder, "HouseInteriors.furniture." .. folder.Name)
    end
    return out
end

-- ==================================================================
-- FAMILY BUILDER
-- ==================================================================
local FamilyMode = false

local function ensureFamily()
    local node = api("FamilyAPI/CreateFamily"); if not node then return false end
    local ok = pcall(function() node:InvokeServer() end)
    if ok then say("Family created", "ok") else say("CreateFamily failed — continuing", "warn") end
    task.wait(FAMILY_SETTLE); return true
end

local function inviteAll()
    local targets = otherPlayers()
    if #targets == 0 then say("No other players to invite", "warn"); return end
    setGoal("Inviting " .. #targets)
    local half = math.floor(#targets / 2)
    for i, p in ipairs(targets) do
        if not FamilyMode then break end
        if p.Parent == Players then
            local useA = (i <= half) or (half == 0 and i == 1)
            local ok = useA and inviteMethodA(p.Name) or inviteMethodB(p.Name)
            if not ok then task.wait(1.5); ok = useA and inviteMethodB(p.Name) or inviteMethodA(p.Name) end
            say("Invite -> " .. p.Name .. (ok and " ok" or " FAILED"), ok and "ok" or "bad")
        end
        task.wait(INVITE_DELAY)
    end
end

local function createFamilyAndInvite()
    if FamilyMode then return end
    FamilyMode = true
    ensureFamily()
    if FamilyMode then inviteAll() end
    FamilyMode = false
end

-- ==================================================================
-- CORE API SHAPES
-- ==================================================================
local TasksMode = false
local BathtubMode = false

local function holdSubject(char)
    local node = api("AdoptAPI/HoldBaby"); if not node then return false end
    return pcall(function() node:InvokeServer(unpack({ [1] = char })) end)
end
local function ejectSubject(char)
    local node = api("AdoptAPI/EjectBaby"); if not node then return false end
    return pcall(function() node:FireServer(unpack({ [1] = char })) end)
end
local function fireBabyFurniture(char, folderId, partName)
    local node = api("InteractablesAPI/MakeBabyUseFurniture"); if not node then return false end
    return pcall(function() node:FireServer(unpack({ [1] = char, [2] = folderId, [3] = partName })) end)
end

local function waitAbortable(seconds, label)
    local t = 0
    while t < seconds and (TasksMode or BathtubMode) do
        setNow(string.format("%s — %d/%ds", label, t, seconds))
        task.wait(1); t += 1
    end
end

-- ==================================================================
-- BATHTUB PAIR-FILL
-- ==================================================================
-- Flow:
--   1. Discover all CheapPetBathtubs -> FIFO queue (unique tubs only)
--   2. Discover all players with characters -> FIFO queue
--   3. Loop: pop up to 2 players, pop 2 tubs, hold both, place both.
--      Repeat until either queue is empty.
--   4. Dwell 15s for all.
--   5. Hold back + eject all who were placed.

local function fillAllBathtubs()
    if BathtubMode then return end
    BathtubMode = true

    -- 1. Tub queue
    local tubs = findAllBathtubs()
    say("Discovered " .. #tubs .. " CheapPetBathtub(s) in HouseInteriors.furniture", "info")
    if #tubs == 0 then
        say("No CheapPetBathtub found", "bad")
        BathtubMode = false
        return
    end

    -- 2. Player queue
    local players = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Character then table.insert(players, p) end
    end
    say("Players to place: " .. #players, "info")
    if #players == 0 then
        say("No players in server", "bad")
        BathtubMode = false
        return
    end

    if #players > #tubs then
        say(#players - #tubs .. " player(s) will be skipped (not enough tubs)", "warn")
    end

    -- 3. Pair loop
    local placed = {}         -- { char = <Character>, playerName = <string>, tub = {...} }
    local tubIdx = 1
    local playerIdx = 1

    while playerIdx <= #players and tubIdx <= #tubs and BathtubMode do
        -- Take up to 2 players and up to 2 tubs
        local group = {}
        for _ = 1, 2 do
            if playerIdx <= #players and tubIdx <= #tubs then
                local p = players[playerIdx]
                local tub = tubs[tubIdx]
                table.insert(group, { char = p.Character, playerName = p.Name, tub = tub })
                playerIdx += 1
                tubIdx += 1
            end
        end
        if #group == 0 then break end

        -- HOLD both
        setGoal("Group (" .. #placed + 1 .. "-" .. (#placed + #group) .. "/" .. #players .. ") — Hold")
        for i, a in ipairs(group) do
            if not BathtubMode then break end
            setGoal("Hold " .. a.playerName, { "(" .. i .. "/" .. #group .. ")" })
            holdSubject(a.char)
            task.wait(HOLD_STEP_DELAY)
        end

        -- PLACE both on their distinct tubs
        setGoal("Group — Place")
        for i, a in ipairs(group) do
            if not BathtubMode then break end
            setGoal(a.playerName .. " -> " .. a.tub.folderId .. "." .. a.tub.partName,
                { a.tub.modelName })
            fireBabyFurniture(a.char, a.tub.folderId, a.tub.partName)
            task.wait(PLACE_STEP_DELAY)
        end

        for _, a in ipairs(group) do table.insert(placed, a) end
        say("Placed " .. #placed .. "/" .. #players .. " (tubs " .. (tubIdx - 1) .. "/" .. #tubs .. ")", "ok")

        task.wait(BETWEEN_PAIRS)
    end

    if #placed == 0 then
        say("No players were placed", "bad")
        BathtubMode = false
        return
    end

    -- 4. Dwell
    setGoal("Dwell " .. BATCH_DWELL .. "s — " .. #placed .. " on bathtubs")
    waitAbortable(BATCH_DWELL, "Bathtub dwell")
    say("Dwell finished", "ok")

    -- 5. Re-hold + eject all placed
    setGoal("Retrieve all")
    for i, a in ipairs(placed) do
        if not BathtubMode then break end
        setGoal("Re-hold " .. a.playerName, { "(" .. i .. "/" .. #placed .. ")" })
        holdSubject(a.char)
        task.wait(HOLD_STEP_DELAY)
    end
    for i, a in ipairs(placed) do
        if not BathtubMode then break end
        setGoal("Eject " .. a.playerName, { "(" .. i .. "/" .. #placed .. ")" })
        ejectSubject(a.char)
        task.wait(EJECT_STEP_DELAY)
    end

    say("Bathtub fill finished — " .. #placed .. " player(s) ejected", "ok")
    BathtubMode = false
end

