            end
            if not TradeRequestMode and reqButton.Text:find("ON", 1, true) then
                reqButton.Text = "SEND TRADE REQ [OFF]"
                reqButton.BackgroundColor3 = MODE_COLORS.req
            end
        end
    end)

    footer(frame, width, 296)
end

