local shown = {}
local TONES = { ok = "#5ac878", bad = "#e65a5a", warn = "#d6a046", info = "#9a9aae" }
local function log(tone, message)
    local safe = string.gsub(string.gsub(string.gsub(tostring(message), "&", "&amp;"), "<", "&lt;"), ">", "&gt;")
    table.insert(shown, '<font color="' .. (TONES[tone] or TONES.info) .. '">' .. safe .. "</font>")
    while #shown > 3 do table.remove(shown, 1) end
    logBox.Text = table.concat(shown, "\n")
end
local function setStatus(value)
    ui.status.Text = value
end

-- ================= 4 TOGGLE BUTTONS =================
local bw = (width - 20 - 6) / 2
local buttons = {}

local function modeButton(x, y, label, color, isOnRef, starter)
    local b = toggleButton(frame, x, y, bw, label, color, function()
        local mode = not isOnRef.get()
        isOnRef.set(mode)
        if mode then
            b.BackgroundColor3 = THEME.ok
            b.Text = isOnRef.labelOn
            task.spawn(starter)
            log("info", isOnRef.labelOn)
        else
            b.BackgroundColor3 = isOnRef.color
            b.Text = isOnRef.labelOff
            log("warn", isOnRef.labelOff)
        end
    end)
    b.BackgroundColor3 = color
    b.Text = isOnRef.labelOff
    return b
end

local modes = {
    { key = "egg", color = THEME.egg, labelOn = "TRADE EGGS [ON]", labelOff = "TRADE EGGS [OFF]", starter = startEggTrader },
    { key = "pet", color = THEME.pet, labelOn = "GIVE PETS [ON]", labelOff = "GIVE PETS [OFF]", starter = startPetGiver },
    { key = "gift", color = THEME.gift, labelOn = "GIVE GIFTS [ON]", labelOff = "GIVE GIFTS [OFF]", starter = startGiftGiver },
    { key = "req", color = THEME.req, labelOn = "SEND TRADE REQ [ON]", labelOff = "SEND TRADE REQ [OFF]", starter = startTradeRequester },
}

local state = {
    egg = { get = function() return EggMode end, set = function(v) EggMode = v end },
    pet = { get = function() return PetMode end, set = function(v) PetMode = v end },
    gift = { get = function() return GiftMode end, set = function(v) GiftMode = v end },
    req = { get = function() return TradeRequestMode end, set = function(v) TradeRequestMode = v end },
}

for i, m in ipairs(modes) do
    local col = (i % 2 == 1) and 0 or 1
    local row = math.floor((i - 1) / 2)
    local ref = state[m.key]
