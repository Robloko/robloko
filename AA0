    text(frame, 10, 54, 40, 14, "Goal", 11, THEME.accent, true)
    ui.goal = text(frame, 48, 54, width - 58, 14, status.goal, 11, THEME.text)
    ui.queue = create("TextLabel", { Position = UDim2.fromOffset(10, 72), Size = UDim2.fromOffset(width - 20, 22),
        BackgroundTransparency = 1, Text = "", TextColor3 = THEME.dim, Font = Enum.Font.Gotham, TextSize = 11,
        TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, TextWrapped = false,
        ClipsDescendants = true }, frame)
    create("Frame", { Position = UDim2.fromOffset(10, 98), Size = UDim2.new(1, -20, 0, 1), BackgroundColor3 = THEME.line,
        BorderSizePixel = 0 }, frame)
    renderStatus()
    local logBox = create("TextLabel", { Position = UDim2.fromOffset(10, 104), Size = UDim2.fromOffset(width - 20, 56),
        BackgroundTransparency = 1, Text = "", RichText = true, TextColor3 = THEME.dim, Font = Enum.Font.Gotham, TextSize = 11,
        TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Bottom, TextWrapped = false,
        ClipsDescendants = true }, frame)
    local shown = {}
    local TONES = { ok = "#5ac878", bad = "#e65a5a", warn = "#d6a046", info = "#9a9aae" }
    uiLog = function(tone, message)
        local safe = string.gsub(string.gsub(string.gsub(tostring(message), "&", "&amp;"), "<", "&lt;"), ">", "&gt;")
        table.insert(shown, '<font color="' .. (TONES[tone] or TONES.info) .. '">' .. safe .. "</font>")
        while #shown > 4 do
            table.remove(shown, 1)
        end
        logBox.Text = table.concat(shown, "\n")
    end

    local function wire(modeName, label, color, starter, setter)
        local b = toggleButton(frame, 10, 168, width - 20, label .. " [OFF]", color, function(btn)
            local on = not (btn.Text:find("ON", 1, true) ~= nil and btn.Text:find("[ON]", 1, true) ~= nil)
            -- flip the mode via setter closure
            on = setter()
            btn.Text = label .. (on and " [ON]" or " [OFF]")
            btn.BackgroundColor3 = on and THEME.ok or THEME.field
            if on then
                task.spawn(starter)
                say(label .. " started", "ok")
            else
                say(label .. " stopped", "warn")
            end
        end)
        return b
    end

    local eggButton = toggleButton(frame, 10, 168, width - 20, "TRADE EGGS [OFF]", MODE_COLORS.egg, function(btn)
        EggMode = not EggMode
        btn.Text = "TRADE EGGS " .. (EggMode and "[ON]" or "[OFF]")
        btn.BackgroundColor3 = EggMode and THEME.ok or MODE_COLORS.egg
        if EggMode then
            task.spawn(startEggTrader)
            say("Egg trader started", "ok")
        else
            say("Egg trader stopped", "warn")
        end
    end)

    local petButton = toggleButton(frame, 10, 200, width - 20, "GIVE PETS [OFF]", MODE_COLORS.pet, function(btn)
        PetMode = not PetMode
        btn.Text = "GIVE PETS " .. (PetMode and "[ON]" or "[OFF]")
        btn.BackgroundColor3 = PetMode and THEME.ok or MODE_COLORS.pet
        if PetMode then
            task.spawn(startPetGiver)
            say("Pet giver started", "ok")
        else
            say("Pet giver stopped", "warn")
        end
    end)

    local giftButton = toggleButton(frame, 10, 232, width - 20, "GIVE GIFTS [OFF]", MODE_COLORS.gift, function(btn)
        GiftMode = not GiftMode
        btn.Text = "GIVE GIFTS " .. (GiftMode and "[ON]" or "[OFF]")
        btn.BackgroundColor3 = GiftMode and THEME.ok or MODE_COLORS.gift
        if GiftMode then
            task.spawn(startGiftGiver)
            say("Gift giver started", "ok")
        else
            say("Gift giver stopped", "warn")
        end
    end)

    local reqButton = toggleButton(frame, 10, 264, width - 20, "SEND TRADE REQ [OFF]", MODE_COLORS.req, function(btn)
        TradeRequestMode = not TradeRequestMode
        btn.Text = "SEND TRADE REQ " .. (TradeRequestMode and "[ON]" or "[OFF]")
        btn.BackgroundColor3 = TradeRequestMode and THEME.ok or MODE_COLORS.req
        if TradeRequestMode then
            task.spawn(startTradeRequester)
            say("Trade requester started", "ok")
        else
            say("Trade requester stopped", "warn")
        end
    end)

    -- Keep buttons in sync when a loop stops itself (out of items)
    task.spawn(function()
        while true do
            task.wait(2)
            if not EggMode and eggButton.Text:find("ON", 1, true) then
                eggButton.Text = "TRADE EGGS [OFF]"
                eggButton.BackgroundColor3 = MODE_COLORS.egg
            end
            if not PetMode and petButton.Text:find("ON", 1, true) then
                petButton.Text = "GIVE PETS [OFF]"
                petButton.BackgroundColor3 = MODE_COLORS.pet
            end
            if not GiftMode and giftButton.Text:find("ON", 1, true) then
