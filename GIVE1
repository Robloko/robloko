-- ================= MODES =================
local EggMode = false
local PetMode = false

-- ================= HELPERS =================
local function debugPrint(msg)
    print("[AutoGiver] " .. msg)
end

local function findFirstAvailablePlayer()
    for _, name in ipairs(TARGET_PLAYER_NAMES) do
        local p = Players:FindFirstChild(name)
        if p then return p end
    end
    return nil
end

local function getPlayerData()
    local ok, clientData = pcall(require, ReplicatedStorage.ClientModules.Core.ClientData)
    if not ok then return nil end
    local ok2, data = pcall(clientData.get_data, clientData)
    if not ok2 then return nil end
    return data and data[player.Name] or nil
end

-- Find items (searches pets AND gifts inventories) matching target list
local function findTargetItems(targetList)
    local found = {}
    local data = getPlayerData()
    if not data or not data.inventory then return found end

    for _, invType in ipairs({"pets", "gifts"}) do
        if data.inventory[invType] then
            for uid, itemData in pairs(data.inventory[invType]) do
                if itemData.id then
                    local id = string.lower(itemData.id)
                    for _, target in ipairs(targetList) do
                        if id == target then
                            table.insert(found, {uid = uid, name = itemData.id})
                            break
                        end
                    end
                end
            end
        end
    end
    return found
end

-- ================= TRADE STATE HELPERS =================

-- Try to read the current trade state. Field names vary between
-- game updates, so we try several common shapes and return the raw table.
local function getTradeState()
    local ok, clientData = pcall(require, ReplicatedStorage.ClientModules.Core.ClientData)
    if not ok then return nil end

    -- Attempt 1: trade state nested in our player data
    local okT, trade = pcall(function()
        local d = clientData.get_data(clientData)
        return d and d[player.Name] and d[player.Name].trade
    end)
    if okT and type(trade) == "table" and next(trade) then return trade end

    -- Attempt 2: some builds expose a getter on the module itself
    local okG, t2 = pcall(function()
        return clientData.get_trade and clientData.get_trade(clientData)
    end)
    if okG and type(t2) == "table" then return t2 end

    return nil
end

-- Count items in an offer table regardless of its shape
local function countOffer(offer)
    if type(offer) ~= "table" then return 0 end
    if offer.count and type(offer.count) == "number" then return offer.count end
    if offer.items and type(offer.items) == "table" then return #offer.items end
    local n = 0
    for _ in pairs(offer) do
        if type(offer[_]) == "string" then n = n + 1 end -- array of uids
    end
    if #offer > 0 then return #offer end
    return n
end

local function declineTrade(targetPlayer)
    pcall(function()
        ReplicatedStorage:WaitForChild("API"):WaitForChild("TradeAPI/AcceptOrDeclineTradeRequest"):InvokeServer(targetPlayer, false)
    end)
end

-- Returns true when the trade looks safe to confirm:
--  * our offer has registered server-side (matches what we added)
--  * the partner has at least 1 item OR has accepted negotiation
-- If state can't be read at all, returns false (never confirm blind).
local function isTradeReady(addedCount)
    local state = getTradeState()
    if not state then return false end

    local myOffer = state.user_offer or state.offer or state.our_offer
    local theirOffer = state.partner_offer or state.their_offer or state.other_offer

    local myCount = countOffer(myOffer)
    if myCount < (addedCount or 1) then return false end

    local theirCount = countOffer(theirOffer)
    local theyAccepted = state.partner_accepted == true
        or state.partner_accepted_negotiation == true
        or state.other_accepted == true

    return theirCount > 0 or theyAccepted
end

-- Poll until the trade is safe to confirm. If the partner stalls with
-- an empty offer, DECLINE the trade so the loop can retry cleanly.
local function waitUntilTradeReadyOrBail(targetPlayer, addedCount, timeout)
    local deadline = os.clock() + (timeout or TRADE_READY_TIMEOUT)
    while os.clock() < deadline do
        if isTradeReady(addedCount) then return true end
        task.wait(1)
    end
    debugPrint("Trade stuck (partner empty/stalled). Declining and retrying.")
    declineTrade(targetPlayer)
    task.wait(2)
    return false
end

-- If a leftover trade is somehow active, kill it before starting a new one
local function cleanupStaleTrade()
    local state = getTradeState()
    if state then
        local partner = state.partner or state.other_player or state.trading_with
        if typeof(partner) == "Instance" and partner:IsA("Player") then
            debugPrint("Stale trade detected with " .. partner.Name .. ". Declining.")
            declineTrade(partner)
            task.wait(2)
        end
    end
end

-- ================= EGG TRADING (eggs can only be traded) =================
local function addEggsToTrade(eggs)
    local maxEggs = math.min(#eggs, 18) -- trade limit
    local added = 0

    for i = 1, maxEggs do
        local success = pcall(function()
            ReplicatedStorage:WaitForChild("API"):WaitForChild("TradeAPI/AddItemToOffer"):FireServer(eggs[i].uid)
        end)
        if success then
            added = added + 1
            debugPrint("Added egg " .. i .. "/" .. maxEggs .. ": " .. eggs[i].name)
        end
        task.wait(0.2)
    end
    return added
end

local function tradeEggsWithPlayer(targetPlayer)
    cleanupStaleTrade()

    debugPrint("Sending trade request to " .. targetPlayer.Name)

    -- Send trade request
    local ok1 = pcall(function()
        ReplicatedStorage:WaitForChild("API"):WaitForChild("TradeAPI/SendTradeRequest"):FireServer(targetPlayer)
    end)
    if not ok1 then
        debugPrint("Failed to send trade request")
        return false
    end
    task.wait(3)

    -- Accept trade request
    local ok2 = pcall(function()
        return ReplicatedStorage:WaitForChild("API"):WaitForChild("TradeAPI/AcceptOrDeclineTradeRequest"):InvokeServer(targetPlayer, true)
    end)
    if not ok2 then
        debugPrint("Failed to accept trade request")
        return false
    end
    debugPrint("Trade accepted")
    task.wait(3)

    -- Add eggs to trade
    local eggs = findTargetItems(TARGET_EGGS)
    if #eggs == 0 then
        debugPrint("No eggs to trade")
        declineTrade(targetPlayer)
        return false
    end
    local added = addEggsToTrade(eggs)
    if added == 0 then
        debugPrint("No eggs added to trade")
        declineTrade(targetPlayer)
        return false
    end
    task.wait(3)

    -- Accept negotiation (but do NOT confirm on a blind timer)
    local ok3 = pcall(function()
        ReplicatedStorage:WaitForChild("API"):WaitForChild("TradeAPI/AcceptNegotiation"):FireServer()
    end)
    if not ok3 then
        debugPrint("Failed to accept negotiation")
        declineTrade(targetPlayer)
        return false
    end

    -- KEY FIX: only confirm once both offers are actually populated.
    -- If the partner confirms an empty offer / stalls, decline and retry.
    if not waitUntilTradeReadyOrBail(targetPlayer, added) then
        return false
    end

    -- Confirm trade
    local ok4 = pcall(function()
        ReplicatedStorage:WaitForChild("API"):WaitForChild("TradeAPI/ConfirmTrade"):FireServer()
    end)
    if not ok4 then
        debugPrint("Failed to confirm trade")
        declineTrade(targetPlayer)
        return false
    end

    -- Watch for completion; if it doesn't complete, decline so we don't hang
    local deadline = os.clock() + TRADE_CONFIRM_TIMEOUT
    while os.clock() < deadline do
        local state = getTradeState()
        if not state then
            debugPrint("Trade completed: " .. added .. " eggs traded to " .. targetPlayer.Name)
            return true
        end
        task.wait(1)
    end

    debugPrint("Trade did not complete in time. Declining.")
    declineTrade(targetPlayer)
    return false
end

local function startEggTrader()
    while EggMode do
        local eggs = findTargetItems(TARGET_EGGS)
        if #eggs == 0 then
            debugPrint("No eggs left! Stopping.")
            EggMode = false
            break
        end

        local target = findFirstAvailablePlayer()
        if not target then
            debugPrint("No target player. Waiting...")
            task.wait(10)
            continue
        end

        local success = tradeEggsWithPlayer(target)
        if success then
            task.wait(math.random(8, 12))
        else
            debugPrint("Trade failed. Retrying in 15 seconds...")
            task.wait(15)
        end
    end
end

-- ================= PET GIVING (instant GiveItem) =================
local function givePet(targetPlayer, uid)
    local success, result = pcall(function()
        return ReplicatedStorage:WaitForChild("API"):WaitForChild("TradeAPI/GiveItem"):InvokeServer(targetPlayer, uid)
    end)
    if success then
        debugPrint("Gave pet to " .. targetPlayer.Name)
        return true
    else
        debugPrint("Failed to give pet: " .. tostring(result))
        return false
    end
end

local function startPetGiver()
    while PetMode do
        local target = findFirstAvailablePlayer()
        if not target then
            debugPrint("No target player. Waiting...")
            task.wait(10)
            continue
        end

        local pets = findTargetItems(TARGET_PETS)
        if #pets == 0 then
            debugPrint("No target pets left! Stopping.")
            PetMode = false
            break
        end

        if givePet(target, pets[1].uid) then
            task.wait(9)
        else
            task.wait(3)
        end
    end
end

-- ================= UI =================
local function createUI()
    local screenGui = Instance.new("ScreenGui")
    screenGui.Name = "SimpleAutoGiverUI"
    screenGui.Parent = player:WaitForChild("PlayerGui")

    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(0, 180, 0, 105)
    frame.Position = UDim2.new(0, 10, 1, -115)
    frame.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    frame.BorderSizePixel = 0
    frame.Parent = screenGui

    Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 6)

    -- Draggable
    local dragging, dragStart, startPos = false, nil, nil
    frame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            dragStart = input.Position
            startPos = frame.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)
    frame.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement and dragging then
            local delta = input.Position - dragStart
            frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)

    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(1, 0, 0, 22)
    title.BackgroundTransparency = 1
    title.TextColor3 = Color3.fromRGB(255, 255, 255)
    title.Text = "Auto Giver"
    title.Font = Enum.Font.SourceSansBold
    title.TextSize = 14
    title.Parent = frame

    -- Egg button (TRADE)
    local eggButton = Instance.new("TextButton")
    eggButton.Size = UDim2.new(0.85, 0, 0, 28)
    eggButton.Position = UDim2.new(0.075, 0, 0, 28)
    eggButton.BackgroundColor3 = Color3.fromRGB(200, 150, 0)
    eggButton.TextColor3 = Color3.fromRGB(255, 255, 255)
    eggButton.Text = "TRADE EGGS [OFF]"
    eggButton.Font = Enum.Font.SourceSansBold
    eggButton.TextSize = 13
    eggButton.Parent = frame
    Instance.new("UICorner", eggButton).CornerRadius = UDim.new(0, 4)

    -- Pet button (GIVE)
    local petButton = Instance.new("TextButton")
    petButton.Size = UDim2.new(0.85, 0, 0, 28)
    petButton.Position = UDim2.new(0.075, 0, 0, 64)
    petButton.BackgroundColor3 = Color3.fromRGB(0, 120, 200)
    petButton.TextColor3 = Color3.fromRGB(255, 255, 255)
    petButton.Text = "GIVE PETS [OFF]"
    petButton.Font = Enum.Font.SourceSansBold
    petButton.TextSize = 13
    petButton.Parent = frame
    Instance.new("UICorner", petButton).CornerRadius = UDim.new(0, 4)

    eggButton.MouseButton1Click:Connect(function()
        EggMode = not EggMode
        eggButton.Text = EggMode and "TRADE EGGS [ON]" or "TRADE EGGS [OFF]"
        eggButton.BackgroundColor3 = EggMode and Color3.fromRGB(0, 170, 0) or Color3.fromRGB(200, 150, 0)
        if EggMode then
            coroutine.wrap(startEggTrader)()
            debugPrint("Egg trader started")
        else
            debugPrint("Egg trader stopped")
        end
    end)

    petButton.MouseButton1Click:Connect(function()
        PetMode = not PetMode
        petButton.Text = PetMode and "GIVE PETS [ON]" or "GIVE PETS [OFF]"
        petButton.BackgroundColor3 = PetMode and Color3.fromRGB(0, 170, 0) or Color3.fromRGB(0, 120, 200)
        if PetMode then
            coroutine.wrap(startPetGiver)()
            debugPrint("Pet giver started")
        else
            debugPrint("Pet giver stopped")
        end
    end)
end

