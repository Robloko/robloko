        end)
    end)

    button(frame, 8, 216, width-16, "PET FARM [OFF]", THEME.pet, function(b)
        if PetFarmMode then
            PetFarmMode = false
            b.Text = "PET FARM [OFF]"; b.BackgroundColor3 = THEME.pet
