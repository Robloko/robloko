-- ================= STATUS / LOG =================
local ui = {}
local uiLog = nil
local status = { now = "Ready", goal = "Pick an action", queue = {} }

local function renderStatus()
    if ui.now then
        pcall(function()
            ui.now.Text  = status.now
            ui.goal.Text = status.goal
            ui.queue.Text = #status.queue > 0 and ("Next: " .. table.concat(status.queue, "\n         ")) or ""
        end)
    end
end
local function setGoal(t, q) status.goal = t or ""; status.queue = q or {}; renderStatus() end
local function setNow(t) status.now = t or ""; renderStatus() end
local function say(text, tone)
    setNow(text)
    if uiLog then pcall(uiLog, tone or "info", text) end
    print("[COCOON] " .. tostring(text))
end

-- ================= COUNTERS / ROSTER =================
local function countPlayers() return #Players:GetPlayers() end
local function countPets()
    local f = workspace:FindFirstChild("Pets"); if not f then return 0 end
    return #f:GetChildren()
end
local function otherPlayers()
    local list = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player then table.insert(list, p) end
    end
    return list
end
local function getPets()
    local f = workspace:FindFirstChild("Pets"); if not f then return {} end
    local list = {}
    for _, pet in ipairs(f:GetChildren()) do table.insert(list, pet) end
    return list
end

-- ==================================================================
-- FURNITURE RESERVATION (players vs pets exclusion)
-- ==================================================================
-- A piece of furniture is uniquely identified by folderId + partName.
-- If either side reserves it, the other side MUST skip it.
local Reservation = {
    player = {},   -- [key] = true  (players currently using / holding this furniture)
    pet    = {},   -- [key] = true  (pets currently using this furniture)
}
local function furnKey(item)
    if not item then return nil end
    return tostring(item.folderId) .. "|" .. tostring(item.partName)
end
local function reserveForPlayer(item)
    local k = furnKey(item); if not k then return false end
    if Reservation.pet[k] then return false end           -- pet is using it -> block
    Reservation.player[k] = true
    return true
end
local function releasePlayer(item)
    local k = furnKey(item); if k then Reservation.player[k] = nil end
end
local function reserveForPet(item)
    local k = furnKey(item); if not k then return false end
    if Reservation.player[k] then return false end        -- player is using it -> block
    if Reservation.pet[k] then return false end           -- another pet already on it
    Reservation.pet[k] = true
    return true
end
local function releasePet(item)
    local k = furnKey(item); if k then Reservation.pet[k] = nil end
end
local function releaseAllForPlayers() Reservation.player = {} end
local function releaseAllForPets()    Reservation.pet    = {} end

-- ================= API HELPERS =================
local API_ROOT = ReplicatedStorage:WaitForChild("API")
