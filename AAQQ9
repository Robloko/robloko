local PLACE_STEP_DELAY = 0.6
local EJECT_STEP_DELAY = 0.6
local BETWEEN_GROUPS   = 2.0
local BETWEEN_PHASES   = 2.0
local BETWEEN_CYCLES   = 3.0

-- Pet farm config
local PET_FARM_DWELL        = 15
local PET_FARM_STEP_DELAY   = 0.5
