-- ================= CONFIG =================
local INVITE_DELAY      = 1.0
local FAMILY_SETTLE     = 2.0
local FURNITURE_DWELL   = 20
local BETWEEN_SUBJECTS  = 1.5
local BETWEEN_FURNITURE = 0.8
local MAX_TASK_PASSES   = 1

-- Which needs to run per subject type
local PET_NEEDS  = { "dirty", "food", "drink", "toilet", "sleep", "bored" }
local BABY_NEEDS = { "dirty", "bored", "bath", "sleep" }  -- bath/sleep use dynamic discovery

-- Known furniture model names by need (used for discovery filter)
local NEED_MODELS = {
    dirty  = { "CheapPetBathtub", "ModernShower", "Bathtub" },
    food   = { "PetFoodBowl",    "FoodBowl",     "BasicFoodBowl" },
    drink  = { "PetWaterBowl",   "WaterBowl",    "BasicWaterBowl" },
    toilet = { "AilmentsRefresh2024LitterBox", "LitterBox" },
    sleep  = { "BasicBed",       "ModernBed",    "Bed" },
    bored  = { "Piano",          "ToyBox" },
    bath   = { "ModernShower",   "CheapPetBathtub", "Bathtub" },
}

-- ================= STATUS / LOG =================
local ui = {}
local uiLog = nil
local status = { now = "Ready", goal = "Pick an action", queue = {} }

local function renderStatus()
    if ui.now then
        pcall(function()
            ui.now.Text  = status.now
            ui.goal.Text = status.goal
            ui.queue.Text = #status.queue > 0 and ("Next: " .. table.concat(status.queue, "\n         ")) or ""
        end)
    end
end
local function setGoal(t, q) status.goal = t or ""; status.queue = q or {}; renderStatus() end
local function setNow(t) status.now = t or ""; renderStatus() end
local function say(text, tone)
    setNow(text)
    if uiLog then pcall(uiLog, tone or "info", text) end
    print("[COCOON] " .. tostring(text))
end

-- ================= COUNTERS =================
local function countPlayers() return #Players:GetPlayers() end
local function countPets()
    local f = workspace:FindFirstChild("Pets"); if not f then return 0 end
    return #f:GetChildren()
end
local function otherPlayers()
    local list = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player then table.insert(list, p) end
    end
    return list
end
local function allSubjects()
    local list = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Character then table.insert(list, p.Character) end
    end
    return list
end
local function petsOnServer()
    local f = workspace:FindFirstChild("Pets"); if not f then return {} end
    return f:GetChildren()
end

-- ================= API HELPERS =================
local API_ROOT = ReplicatedStorage:WaitForChild("API")
local function api(name) return API_ROOT:FindFirstChild(name) end

local function callAPI(name, args, fire)
    local node = api(name)
    if not node then say("API missing: " .. name, "bad"); return false end
    args = args or {}
    local ok, err = pcall(function()
        if fire then node:FireServer(unpack(args)) else node:InvokeServer(unpack(args)) end
    end)
    if not ok then say("Call failed " .. name .. ": " .. tostring(err), "bad") end
    return ok
end

-- ============ INVITE METHOD A (FindFirstChild) ============
local function inviteMethodA(name)
    if type(name) ~= "string" or name == "" then return false end
    local target = game:GetService("Players"):FindFirstChild(name)
    if not target then return false end
    local args = { [1] = target }
    local node = game:GetService("ReplicatedStorage").API:FindFirstChild("FamilyAPI/InvitePlayer")
    if not node then return false end
    return pcall(function() node:InvokeServer(unpack(args)) end)
end

-- ============ INVITE METHOD B (Players[name]) ============
local function inviteMethodB(name)
    if type(name) ~= "string" or name == "" then return false end
    local target = game:GetService("Players")[name]
    if not target then return false end
    local args = { [1] = target }
    local node = game:GetService("ReplicatedStorage").API:FindFirstChild("FamilyAPI/InvitePlayer")
    if not node then return false end
    return pcall(function() node:InvokeServer(unpack(args)) end)
end

-- ==================================================================
-- DYNAMIC FURNITURE DISCOVERY
-- ==================================================================
-- The tree looks like:
--   workspace.HouseInteriors.furniture["Player/1/nil/true/f-24"].<Model>.UseBlocks.<Seat1|UseBlock>
--   or, for some models: <Model>.UseBlock (a BasePart directly)
-- or the model itself may be the activation part.

local function ownerFromFolder(folderName)
    -- "3kachalka478/1/nil/true/f-24" -> "3kachalka478"
    return (string.match(folderName, "^([^/]+)/") or folderName)
end
local function folderIdFromFolder(folderName)
    return (string.match(folderName, "f%-%d+") or folderName)
end

-- Resolve the activation part inside a furniture model.
-- Priority: UseBlocks.<Seat1|UseBlock> -> <Seat1|UseBlock> direct child -> first BasePart
local function resolveActivation(model)
    if not model or not model:IsA("Model") then return nil end
    local useBlocks = model:FindFirstChild("UseBlocks")
    if useBlocks then
        for _, name in ipairs({ "Seat1", "UseBlock" }) do
            local part = useBlocks:FindFirstChild(name)
            if part and part:IsA("BasePart") then
                return { partName = name, cframe = part.CFrame, position = part.Position }
            end
        end
    end
    for _, name in ipairs({ "Seat1", "UseBlock" }) do
        local part = model:FindFirstChild(name)
        if part and part:IsA("BasePart") then
            return { partName = name, cframe = part.CFrame, position = part.Position }
        end
    end
    for _, d in ipairs(model:GetDescendants()) do
        if d:IsA("BasePart") then
            return { partName = d.Name, cframe = d.CFrame, position = d.Position }
        end
    end
    return nil
end

-- Scan all furniture folders once. Returns a list:
--   { owner, folderName, folderId, modelName, model, partName, cframe, position }
local function scanAllFurniture()
    local out = {}
    local hi = workspace:FindFirstChild("HouseInteriors")
    if not hi then return out end
    local furniture = hi:FindFirstChild("furniture")
    if not furniture then return out end
    for _, folder in ipairs(furniture:GetChildren()) do
        local owner = ownerFromFolder(folder.Name)
        local folderId = folderIdFromFolder(folder.Name)
        for _, child in ipairs(folder:GetChildren()) do
            if child:IsA("Model") then
                local act = resolveActivation(child)
                if act then
                    table.insert(out, {
                        owner = owner,
                        folderName = folder.Name,
                        folderId = folderId,
                        modelName = child.Name,
                        model = child,
                        partName = act.partName,
                        cframe = act.cframe,
                        position = act.position,
                    })
                end
            end
        end
    end
    return out
end

-- Find the best matching furniture entry for a given need, optionally owned by a specific player.
local function findFurnitureForNeed(need, ownerName)
    local wanted = NEED_MODELS[need]
    if not wanted then return nil end
    local wantedSet = {}
    for _, n in ipairs(wanted) do wantedSet[string.lower(n)] = true end
    local candidates = {}
    for _, f in ipairs(scanAllFurniture()) do
        if wantedSet[string.lower(f.modelName)] then
            if not ownerName or f.owner == ownerName then
                table.insert(candidates, f)
            end
        end
    end
    if #candidates == 0 and ownerName then
        -- fallback: any owner
        for _, f in ipairs(scanAllFurniture()) do
            if wantedSet[string.lower(f.modelName)] then table.insert(candidates, f) end
        end
    end
    return candidates[1]
end

-- ================= FAMILY BUILDER =================
local FamilyMode = false

local function ensureFamily()
    local node = api("FamilyAPI/CreateFamily")
    if not node then say("FamilyAPI/CreateFamily missing", "bad"); return false end
    local ok = pcall(function() node:InvokeServer() end)
    if not ok then
        say("CreateFamily failed — assuming already in a family, continuing", "warn")
    else
        say("Family created", "ok")
    end
    task.wait(FAMILY_SETTLE)
    return true
end

local function inviteAll()
    local targets = otherPlayers()
    if #targets == 0 then say("No other players to invite", "warn"); return end
    setGoal("Inviting " .. #targets .. " player(s)")

    local half = math.floor(#targets / 2)
    for i, p in ipairs(targets) do
        if not FamilyMode then break end
        if p.Parent ~= Players then
            say("Skipping " .. p.Name .. " (left server)", "warn")
            continue
        end

        local useA = (i <= half) or (half == 0 and i == 1)
        setGoal("Inviting " .. #targets, { p.Name .. (useA and " (A)" or " (B)") })

        local ok = useA and inviteMethodA(p.Name) or inviteMethodB(p.Name)
        if ok then
            say("Invite (" .. (useA and "A" or "B") .. ") -> " .. p.Name, "ok")
        else
            task.wait(1.5)
            local ok2 = useA and inviteMethodB(p.Name) or inviteMethodA(p.Name)
            if ok2 then
                say("Invite (" .. (useA and "B" or "A") .. " retry) -> " .. p.Name, "ok")
            else
                say("Invite FAILED (A+B) -> " .. p.Name, "bad")
            end
        end
        task.wait(INVITE_DELAY)
    end
    say("Family invite pass finished", "ok")
end

local function createFamilyAndInvite()
    if FamilyMode then return end
    FamilyMode = true
    ensureFamily()
    if FamilyMode then inviteAll() end
    FamilyMode = false
end

-- ================= NEEDS LOOP =================
local TasksMode = false
local currentSubject = nil

local function hold(obj)
    setNow("Hold: " .. (obj.Name or "?"))
    callAPI("AdoptAPI/HoldBaby", { obj })
    task.wait(1)
end
local function eject(obj)
    setNow("Eject: " .. (obj.Name or "?"))
    callAPI("AdoptAPI/EjectBaby", { obj }, true)
    task.wait(0.8)
end
local function dwell(seconds, label)
    local t = 0
    while t < seconds and TasksMode do
        setNow(string.format("%s — %d/%ds", label, t, seconds))
        task.wait(1); t += 1
    end
end

-- PET: hold -> activate furniture per need via HousingAPI/ActivateFurniture
local function processPet(pet)
    if not pet or not pet.Parent then return end
    currentSubject = pet
    say("Pet: " .. (pet.Name or "?"), "info")
    hold(pet)
    for _, need in ipairs(PET_NEEDS) do
        if not TasksMode then break end
        local f = findFurnitureForNeed(need, player.Name) or findFurnitureForNeed(need)
        if not f then
            say("No furniture found for pet need: " .. need, "warn")
        else
            setGoal("Pet " .. (pet.Name or "?") .. " -> " .. need .. " [" .. f.folderId .. "." .. f.partName .. "]", { f.modelName })
            callAPI("HousingAPI/ActivateFurniture",
                { player, f.folderId, f.partName, { cframe = f.cframe }, pet })
            dwell(FURNITURE_DWELL, "Pet " .. need)
            task.wait(BETWEEN_FURNITURE)
        end
    end
    eject(pet)
    currentSubject = nil
    task.wait(BETWEEN_SUBJECTS)
end

-- BABY: hold -> fire InteractablesAPI/MakeBabyUseFurniture(char, folderId, partName)
-- Exact shape from SimpleSpy captures.
local function fireBabyFurniture(char, folderId, partName)
    local node = api("InteractablesAPI/MakeBabyUseFurniture")
    if not node then say("MakeBabyUseFurniture missing", "bad"); return false end
    local args = {
        [1] = char,
        [2] = folderId,
        [3] = partName,
    }
    return pcall(function() node:FireServer(unpack(args)) end)
end

local function processBaby(char)
    if not char or not char.Parent then return end
    currentSubject = char
    say("Baby: " .. (char.Name or "?"), "info")
    hold(char)
    for _, need in ipairs(BABY_NEEDS) do
        if not TasksMode then break end
        -- babies get their own furniture (owner = char.Name)
        local f = findFurnitureForNeed(need, char.Name) or findFurnitureForNeed(need)
        if not f then
            say("No furniture found for baby need: " .. need, "warn")
        else
            setGoal("Baby " .. (char.Name or "?") .. " -> " .. need .. " [" .. f.folderId .. "." .. f.partName .. "]", { f.modelName })
            fireBabyFurniture(char, f.folderId, f.partName)
            dwell(FURNITURE_DWELL, "Baby " .. need)
            task.wait(BETWEEN_FURNITURE)
        end
    end
    eject(char)
    currentSubject = nil
    task.wait(BETWEEN_SUBJECTS)
end

local function doAllTasksOnce()
    local babies = allSubjects()
    say("Subjects found: " .. #babies, "info")
    for _, c in ipairs(babies) do
        if not TasksMode then return false end
        processBaby(c)
    end
    local pets = petsOnServer()
    say("Pets found: " .. #pets, "info")
    for _, pet in ipairs(pets) do
        if not TasksMode then return false end
        processPet(pet)
    end
    return true
end

local function startAllTasks()
    if TasksMode then return end
    TasksMode = true
    for pass = 1, MAX_TASK_PASSES do
        if not TasksMode then break end
        setGoal("Task pass " .. pass .. "/" .. MAX_TASK_PASSES)
        doAllTasksOnce()
        if pass < MAX_TASK_PASSES then task.wait(3) end
    end
    say("Task loop finished", "ok")
    TasksMode = false
end

