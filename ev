local ReplicatedStorage = game:GetService("ReplicatedStorage")
local MinigameAPI = ReplicatedStorage.API:WaitForChild("MinigameAPI/MessageServer")

-- ====== LIVE CAPTURE ======
local captured = { cluster_id = nil, use_token = nil, ghost_id = nil }

local old
old = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
    local method = getnamecallmethod()
    if method == "FireServer" or method == "InvokeServer" then
        local a1, a2, a3 = ...
        if self == MinigameAPI and typeof(a1) == "string" and a1:match("^ghost_clusters::") and typeof(a3) == "table" then
            captured.cluster_id = a1
            captured.use_token = a3.use_token or captured.use_token
            captured.ghost_id = a3.ghost_id or captured.ghost_id
            print("[CAPTURE] cluster=" .. a1 .. " ghost=" .. tostring(a3.ghost_id) .. " token=" .. tostring(a3.use_token))
        end
    end
    return old(self, ...)
end))

-- ====== AUTO-HIT LOOP ======
local HIT_DELAY = 0.2
print("[BOSS] Waiting for first manual minigame interaction to capture IDs...")

repeat task.wait(0.1) until captured.cluster_id and captured.ghost_id
print("[BOSS] Captured! Starting auto-hit...")

while task.wait(HIT_DELAY) do
    pcall(function()
        MinigameAPI:FireServer(
            captured.cluster_id,
            "start_contribute",
            { use_token = captured.use_token, ghost_id = captured.ghost_id }
        )
        MinigameAPI:FireServer(
            captured.cluster_id,
            "stop_contribute",
            { use_token = captured.use_token, ghost_id = captured.ghost_id }
        )
    end)
end
