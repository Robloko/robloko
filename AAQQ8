-- ==================================================================
-- COCOON v17 — Bathtubs(15s) -> Beds(15s) -> Piano(20s) -> loop
--           + Pet Farm (pets -> bathtub/water/food bowl, 15s each)
-- Hold:   AdoptAPI/HoldBaby:InvokeServer(unpack({ [1] = Char }))
-- Eject:  AdoptAPI/EjectBaby:FireServer(unpack({ [1] = Char }))
-- Place:  InteractablesAPI/MakeBabyUseFurniture:FireServer(Char, folderId, partName)
-- Formula: used after ALL players placed on Piano, before dwell
-- ==================================================================
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")
local player = Players.LocalPlayer

local env = getgenv and getgenv() or {}
if env.COCOON and env.COCOON.Stop then pcall(env.COCOON.Stop) end

-- ================= CONFIG =================
local INVITE_DELAY     = 1.0
local FAMILY_SETTLE    = 2.0
local HOLD_STEP_DELAY  = 0.8
local PLACE_STEP_DELAY = 0.6
local EJECT_STEP_DELAY = 0.6
local BETWEEN_GROUPS   = 2.0
local BETWEEN_PHASES   = 2.0
local BETWEEN_CYCLES   = 3.0

-- Pet farm config
local PET_PLACE_DELAY  = 0.6
local PET_DWELL        = 15
local PET_BETWEEN      = 2.0

-- Furniture phases, in order. dwell = seconds each subject sits on this furniture.
local PHASES = {
    { name = "CheapPetBathtub", label = "Bathtub", dwell = 15 },
    { name = "BasicBed",        label = "Bed",     dwell = 15 },
    { name = "Piano",           label = "Piano",   dwell = 20 },
}

-- Pet furniture phases (one after another, each 15s dwell per pet)
local PET_PHASES = {
    { name = "CheapPetBathtub",               label = "PetBathtub" },
    { name = "AilmentsRefresh2024CheapWaterBowl", label = "PetWaterBowl" },
    { name = "AilmentsRefresh2024CheapFoodBowl",  label = "PetFoodBowl" },
}

-- ================= STATUS / LOG =================
local ui = {}
local uiLog = nil
local status = { now = "Ready", goal = "Pick an action", queue = {} }

local function renderStatus()
    if ui.now then
        pcall(function()
            ui.now.Text  = status.now
            ui.goal.Text = status.goal
            ui.queue.Text = #status.queue > 0 and ("Next: " .. table.concat(status.queue, "\n         ")) or ""
        end)
    end
end
local function setGoal(t, q) status.goal = t or ""; status.queue = q or {}; renderStatus() end
local function setNow(t) status.now = t or ""; renderStatus() end
local function say(text, tone)
    setNow(text)
    if uiLog then pcall(uiLog, tone or "info", text) end
    print("[COCOON] " .. tostring(text))
end

-- ================= COUNTERS / ROSTER =================
local function countPlayers() return #Players:GetPlayers() end
local function countPets()
    local f = workspace:FindFirstChild("Pets"); if not f then return 0 end
    return #f:GetChildren()
end
local function otherPlayers()
    local list = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player then table.insert(list, p) end
    end
    return list
end

-- ================= API HELPERS =================
local API_ROOT = ReplicatedStorage:WaitForChild("API")
local function api(name) return API_ROOT:FindFirstChild(name) end

local function inviteMethodA(name)
    if type(name) ~= "string" or name == "" then return false end
    local target = game:GetService("Players"):FindFirstChild(name); if not target then return false end
    local node = api("FamilyAPI/InvitePlayer"); if not node then return false end
    return pcall(function() node:InvokeServer(unpack({ [1] = target })) end)
end
local function inviteMethodB(name)
    if type(name) ~= "string" or name == "" then return false end
    local target = game:GetService("Players")[name]; if not target then return false end
    local node = api("FamilyAPI/InvitePlayer"); if not node then return false end
    return pcall(function() node:InvokeServer(unpack({ [1] = target })) end)
end

-- ==================================================================
-- FURNITURE DISCOVERY
-- ==================================================================
local function ownerFromFolder(folderName) return (string.match(folderName, "^([^/]+)/") or folderName) end
local function folderIdFromFolder(folderName) return (string.match(folderName, "f%-%d+") or folderName) end

local function resolveActivation(model)
    if not model then return nil end
    local function tryName(container, name)
        local p = container and container:FindFirstChild(name)
        if p and p:IsA("BasePart") then
            return { partName = name, cframe = p.CFrame, position = p.Position }
        end
        return nil
    end
    local useBlocks = model:FindFirstChild("UseBlocks")
    if useBlocks then
        for _, name in ipairs({ "Seat1", "UseBlock" }) do
            local r = tryName(useBlocks, name); if r then return r end
        end
    end
    for _, name in ipairs({ "Seat1", "UseBlock" }) do
        local r = tryName(model, name); if r then return r end
    end
    for _, d in ipairs(model:GetDescendants()) do
        if d:IsA("BasePart") then
            return { partName = d.Name, cframe = d.CFrame, position = d.Position }
        end
    end
    return nil
end

local function findAllByName(targetName)
    local out = {}
    local hi = Workspace:FindFirstChild("HouseInteriors"); if not hi then return out end
    local furniture = hi:FindFirstChild("furniture"); if not furniture then return out end
    for _, folder in ipairs(furniture:GetChildren()) do
        local owner = ownerFromFolder(folder.Name)
        local folderId = folderIdFromFolder(folder.Name)
        local function walk(node, prefix)
            for _, child in ipairs(node:GetChildren()) do
                if child.Name:lower() == targetName:lower()
                    and (child:IsA("Model") or child:IsA("Folder")) then
                    local act = resolveActivation(child)
                    if act then
                        table.insert(out, {
                            owner = owner, folderId = folderId, folderName = folder.Name,
                            modelName = child.Name, model = child,
                            partName = act.partName, cframe = act.cframe,
                            path = prefix .. "." .. child.Name,
                        })
                    end
                end
                if child:IsA("Folder") or child:IsA("Model") then
                    walk(child, prefix .. "." .. child.Name)
                end
            end
        end
        walk(folder, "HouseInteriors.furniture." .. folder.Name)
    end
    return out
end

-- ==================================================================
-- FAMILY BUILDER
-- ==================================================================
local FamilyMode = false

local function ensureFamily()
    local node = api("FamilyAPI/CreateFamily"); if not node then return false end
    local ok = pcall(function() node:InvokeServer() end)
    if ok then say("Family created", "ok") else say("CreateFamily failed — continuing", "warn") end
    task.wait(FAMILY_SETTLE); return true
end

local function inviteAll()
    local targets = otherPlayers()
    if #targets == 0 then say("No other players to invite", "warn"); return end
    setGoal("Inviting " .. #targets)
    local half = math.floor(#targets / 2)
    for i, p in ipairs(targets) do
        if not FamilyMode then break end
        if p.Parent == Players then
            local useA = (i <= half) or (half == 0 and i == 1)
            local ok = useA and inviteMethodA(p.Name) or inviteMethodB(p.Name)
            if not ok then task.wait(1.5); ok = useA and inviteMethodB(p.Name) or inviteMethodA(p.Name) end
            say("Invite -> " .. p.Name .. (ok and " ok" or " FAILED"), ok and "ok" or "bad")
        end
        task.wait(INVITE_DELAY)
    end
end

local function createFamilyAndInvite()
    if FamilyMode then return end
    FamilyMode = true
    ensureFamily()
    if FamilyMode then inviteAll() end
    FamilyMode = false
end

-- ==================================================================
-- CORE API SHAPES
-- ==================================================================
local LoopMode = false
local PetFarmMode = false

local function holdSubject(char)
    local node = api("AdoptAPI/HoldBaby"); if not node then return false end
    return pcall(function() node:InvokeServer(unpack({ [1] = char })) end)
end
local function ejectSubject(char)
    local node = api("AdoptAPI/EjectBaby"); if not node then return false end
    return pcall(function() node:FireServer(unpack({ [1] = char })) end)
end
local function fireBabyFurniture(char, folderId, partName)
    local node = api("InteractablesAPI/MakeBabyUseFurniture"); if not node then return false end
    return pcall(function() node:FireServer(unpack({ [1] = char, [2] = folderId, [3] = partName })) end)
end

local function waitAbortable(seconds, label)
    local t = 0
    while t < seconds and LoopMode do
        setNow(string.format("%s — %d/%ds", label, t, seconds))
        task.wait(1); t += 1
    end
end

-- ==================================================================
-- PET FARM (no holds — pets placed via MakeBabyUseFurniture)
-- ==================================================================
-- Game typically supports MakeBabyUseFurniture for pets too (server treats
-- the pet model instance as the "baby"). We pass pet model instance as Char.
local function listPets()
    local out = {}
    local pf = Workspace:FindFirstChild("Pets"); if not pf then return out end
    for _, child in ipairs(pf:GetChildren()) do
        if child:IsA("Model") then
            table.insert(out, child)
        end
    end
    return out
end

local function petLabel(pet)
    return pet.Name
end

local function waitAbortablePet(seconds, label)
    local t = 0
    while t < seconds and PetFarmMode do
        setNow(string.format("%s — %d/%ds", label, t, seconds))
        task.wait(1); t += 1
    end
end

local function runPetPhase(targetName, label)
    local items = findAllByName(targetName)
    say(string.format("PetPhase %s: discovered %d %s", label, #items, targetName), "info")
    if #items == 0 then
        say("No " .. targetName .. " found — skipping pet phase", "warn")
        return 0
    end

    local pets = listPets()
    if #pets == 0 then say("No pets in workspace.Pets", "bad"); return 0 end
    if #pets > #items then
        say((#pets - #items) .. " pet(s) skipped (not enough " .. targetName .. ")", "warn")
    end

    local placed = {}
    local itemIdx, petIdx = 1, 1

    while petIdx <= #pets and itemIdx <= #items and PetFarmMode do
        local group = {}
        for _ = 1, 2 do
            if petIdx <= #pets and itemIdx <= #items then
                local pet = pets[petIdx]
                local it  = items[itemIdx]
                table.insert(group, { pet = pet, petName = petLabel(pet), item = it })
                petIdx += 1
                itemIdx += 1
            end
        end
        if #group == 0 then break end

        setGoal(label .. " — Place pet group")
        for _, a in ipairs(group) do
            if not PetFarmMode then break end
            setGoal(label .. " — " .. a.petName .. " -> " .. a.item.folderId .. "." .. a.item.partName,
                { a.item.modelName })
            fireBabyFurniture(a.pet, a.item.folderId, a.item.partName)
            task.wait(PET_PLACE_DELAY)
        end

        for _, a in ipairs(group) do table.insert(placed, a) end
        say(string.format("%s: pets placed %d/%d", label, #placed, #pets), "ok")
        task.wait(PET_BETWEEN)
    end

    if #placed == 0 then
        say(label .. ": no pets placed", "bad")
        return 0
    end

    -- Dwell (15s) — pets just sit there, no holds
    setGoal(string.format("%s — Pet dwell %ds (%d placed)", label, PET_DWELL, #placed))
    waitAbortablePet(PET_DWELL, label .. " pet dwell")
    say(label .. ": pet dwell done", "ok")

    -- Retrieve pets: re-place onto their own location? No — just skip.
    -- If you want to clear, use MakeBabyUseFurniture again elsewhere; we
    -- simply leave them and let next phase re-place to new furniture.
    return #placed
end

local function startPetFarm()
    if PetFarmMode then return end
    PetFarmMode = true
    local cycle = 0
    while PetFarmMode do
        cycle += 1
        say("═══════ PET CYCLE " .. cycle .. " START ═══════", "info")
        for _, phase in ipairs(PET_PHASES) do
            if not PetFarmMode then break end
            setGoal(string.format("Pet cycle %d — %s", cycle, phase.label))
            runPetPhase(phase.name, phase.label)
            if PetFarmMode then task.wait(PET_BETWEEN) end
        end
        say("═══════ PET CYCLE " .. cycle .. " END ═══════", "info")
        if PetFarmMode then
            setGoal("Pet farm waiting…")
            waitAbortablePet(BETWEEN_CYCLES, "pet inter-cycle pause")
        end
    end
    say("Pet farm stopped", "ok")
end

-- ==================================================================
-- BABY FORMULA (used after all players placed on Piano)
-- ==================================================================
local BABY_FORMULA_ID = "babyformula"
local BABY_FORMULA_CATEGORY = "food"

local function printAvailableFood()
    local foods = {}
    pcall(function()
        local clientData = require(ReplicatedStorage.ClientModules.Core.ClientData)
        local playerData = clientData.get_data()[player.Name]
        if playerData and playerData.inventory and playerData.inventory.food then
            for foodId, foodData in pairs(playerData.inventory.food) do
                if foodData.id then
                    table.insert(foods, { id = foodId, name = foodData.id, amount = foodData.amount or 1 })
                end
            end
        end
    end)
    return foods
end

local function findBabyFormula(foods)
    local patterns = { "baby", "formula", "babyformula", "baby_formula", "infant", "milk" }
    for _, food in ipairs(foods) do
        local lowerName = string.lower(food.name)
        for _, pattern in ipairs(patterns) do
            if string.find(lowerName, pattern) then return food end
        end
    end
    return nil
end

local function buyBabyFormula()
    local node = api("ShopAPI/BuyItem"); if not node then return false end
    local ok = pcall(function()
        node:InvokeServer(unpack({ [1] = BABY_FORMULA_CATEGORY, [2] = BABY_FORMULA_ID, [3] = { ["buy_count"] = 1 } }))
    end)
    if ok then task.wait(1) end
    return ok
end

local function clickDialogButton()
    local pg = player:FindFirstChild("PlayerGui")
    if not pg then return false end
    local dialogApp = pg:FindFirstChild("DialogApp")
    if not dialogApp then return false end
    local dialog = dialogApp:FindFirstChild("Dialog"); if not dialog then return false end
    local normalDialog = dialog:FindFirstChild("NormalDialog"); if not normalDialog then return false end
    local buttons = normalDialog:FindFirstChild("Buttons"); if not buttons then return false end
    local button = buttons:FindFirstChild("ButtonTemplate")
    if not button then
        for _, child in ipairs(buttons:GetChildren()) do
            if child:IsA("GuiButton") and child.Visible and child.Active then button = child; break end
        end
    end
    if button and button.Visible and button.Active and button:IsA("GuiButton") then
        if firesignal then
            firesignal(button.MouseButton1Down); task.wait(0.05)
            firesignal(button.MouseButton1Up);   task.wait(0.05)
            firesignal(button.MouseButton1Click)
        else
            pcall(function() button.MouseButton1Click:Fire() end)
        end
        return true
    end
    return false
end

local function waitAndClickDialog(timeoutSeconds)
    local start = tick()
    while tick() - start < (timeoutSeconds or 8) do
        if clickDialogButton() then return true end
        task.wait(0.25)
    end
    return false
end

local function useBabyFormula()
    say("Formula: checking inventory…", "info")
    local foods = printAvailableFood()
    local formula = findBabyFormula(foods)

    if not formula then
        say("Formula missing — buying…", "warn")
        buyBabyFormula()
        foods = printAvailableFood()
        formula = findBabyFormula(foods)
    end

    if not formula then
        say("Formula unavailable — skipping", "bad")
        return false
    end

    local equipNode = api("ToolAPI/Equip")
    local useNode   = api("ToolAPI/ServerUseTool")
    if not equipNode or not useNode then say("ToolAPI missing", "bad"); return false end

    local ok = pcall(function()
        equipNode:InvokeServer(unpack({ [1] = formula.id, [2] = { ["equip_as_last"] = false, ["use_sound_delay"] = true } }))
    end)
    if not ok then say("Equip failed", "bad"); return false end
    task.wait(0.5)

    pcall(function() useNode:InvokeServer(unpack({ [1] = formula.id, [2] = "START" })) end)
    task.wait(0.5)

    if not waitAndClickDialog(8) then say("No dialog — continuing", "warn") end
    task.wait(0.5)

    pcall(function() useNode:InvokeServer(unpack({ [1] = formula.id, [2] = "END" })) end)
    say("Formula used", "ok")
    return true
end

-- ==================================================================
-- ONE FURNITURE PHASE (bathtub / bed / piano)
-- ==================================================================
local function runFurniturePhase(targetName, label, dwell)
    local items = findAllByName(targetName)
    say(string.format("Phase %s: discovered %d %s (dwell %ds)",
        label, #items, targetName, dwell), "info")
    if #items == 0 then
        say("No " .. targetName .. " found — skipping phase", "warn")
        return 0
    end

    local players = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Character then table.insert(players, p) end
    end
    if #players == 0 then say("No players in server", "bad"); return 0 end
    if #players > #items then
        say((#players - #items) .. " player(s) skipped (not enough " .. targetName .. ")", "warn")
    end

    local placed = {}
    local itemIdx, playerIdx = 1, 1

    while playerIdx <= #players and itemIdx <= #items and LoopMode do
        local group = {}
        for _ = 1, 2 do
            if playerIdx <= #players and itemIdx <= #items then
                local p = players[playerIdx]
                local it = items[itemIdx]
                table.insert(group, { char = p.Character, playerName = p.Name, item = it })
                playerIdx += 1
                itemIdx += 1
            end
        end
        if #group == 0 then break end

        setGoal(label .. " — Hold group")
        for i, a in ipairs(group) do
            if not LoopMode then break end
            setGoal(label .. " — Hold " .. a.playerName, { "(" .. i .. "/" .. #group .. ")" })
            holdSubject(a.char)
            task.wait(HOLD_STEP_DELAY)
        end

        setGoal(label .. " — Place group")
        for _, a in ipairs(group) do
            if not LoopMode then break end
            setGoal(label .. " — " .. a.playerName .. " -> " .. a.item.folderId .. "." .. a.item.partName,
                { a.item.modelName })
            fireBabyFurniture(a.char, a.item.folderId, a.item.partName)
            task.wait(PLACE_STEP_DELAY)
        end

        for _, a in ipairs(group) do table.insert(placed, a) end
        say(string.format("%s: placed %d/%d", label, #placed, #players), "ok")
        task.wait(BETWEEN_GROUPS)
    end

    if #placed == 0 then
        say(label .. ": nothing placed", "bad")
        return 0
    end

    if targetName == "Piano" and LoopMode then
        setGoal(label .. " — Using baby formula")
        local ok = useBabyFormula()
        say(label .. (ok and ": formula done" or ": formula skipped"), ok and "ok" or "warn")
    end

    setGoal(string.format("%s — Dwell %ds (%d placed)", label, dwell, #placed))
    waitAbortable(dwell, label .. " dwell")
    say(label .. ": dwell done", "ok")

    setGoal(label .. " — Retrieve all")
    for i, a in ipairs(placed) do
        if not LoopMode then break end
        setGoal(label .. " — Re-hold " .. a.playerName, { "(" .. i .. "/" .. #placed .. ")" })
        holdSubject(a.char)
        task.wait(HOLD_STEP_DELAY)
    end

    setGoal(label .. " — Eject all")
    for i, a in ipairs(placed) do
        if not LoopMode then break end
        setGoal(label .. " — Eject " .. a.playerName, { "(" .. i .. "/" .. #placed .. ")" })
        ejectSubject(a.char)
        task.wait(EJECT_STEP_DELAY)
    end

    say(label .. ": ejected all " .. #placed, "ok")
    return #placed
end

-- ==================================================================
-- MASTER LOOP
-- ==================================================================
local function startLoop()
    if LoopMode then return end
    LoopMode = true

    local cycle = 0
    while LoopMode do
        cycle += 1
        say("═══════ CYCLE " .. cycle .. " START ═══════", "info")

        for _, phase in ipairs(PHASES) do
            if not LoopMode then break end
            setGoal(string.format("Cycle %d — %s phase", cycle, phase.label))
            runFurniturePhase(phase.name, phase.label, phase.dwell)
            if LoopMode then task.wait(BETWEEN_PHASES) end
        end

        say("═══════ CYCLE " .. cycle .. " END ═══════", "info")
        if LoopMode then
            setGoal("Waiting " .. BETWEEN_CYCLES .. "s before next cycle")
            waitAbortable(BETWEEN_CYCLES, "inter-cycle pause")
        end
    end

    say("Master loop stopped", "ok")
end

