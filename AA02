-- ================= UI =================
local GC = GC or {}
GC.LogFolder = "AutoGiver"
GC.AvatarUrl = "https://raw.githubusercontent.com/Robloko/robloko/main/icon.png"
GC.AvatarUser = "COCOON"

local THEME = {
    bg = Color3.fromRGB(18, 18, 22), line = Color3.fromRGB(40, 40, 48), field = Color3.fromRGB(28, 28, 34),
    text = Color3.fromRGB(230, 230, 235), dim = Color3.fromRGB(130, 130, 145), accent = Color3.fromRGB(150, 120, 255),
    ok = Color3.fromRGB(90, 200, 120), bad = Color3.fromRGB(230, 90, 90),
}
local MODE_COLORS = {
    egg = Color3.fromRGB(200, 150, 0), pet = Color3.fromRGB(0, 120, 200),
    gift = Color3.fromRGB(200, 100, 200), req = Color3.fromRGB(150, 100, 50),
}

local function guiParent()
    local ok, hui = pcall(function() return gethui and gethui() end)
    if ok and hui then
        return hui
    end
    local okCore, core = pcall(function() return game:GetService("CoreGui") end)
    if okCore and core then
        return core
    end
    return player:WaitForChild("PlayerGui")
end

local function create(className, props, parent)
    local object = Instance.new(className)
    for key, value in pairs(props) do
        object[key] = value
    end
    object.Parent = parent
    return object
end

local function corner(parent, radius)
    create("UICorner", { CornerRadius = UDim.new(0, radius or 6) }, parent)
end

local function makeDraggable(handle, target)
    local dragging, startInput, startPos
    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging, startInput, startPos = true, input.Position, target.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - startInput
            target.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
end

local function text(parent, x, y, width, height, value, size, color, bold)
    return create("TextLabel", { Position = UDim2.fromOffset(x, y), Size = UDim2.fromOffset(width, height),
        BackgroundTransparency = 1, Text = value or "", TextColor3 = color or THEME.text, TextSize = size or 12,
        Font = bold and Enum.Font.GothamMedium or Enum.Font.Gotham, TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd }, parent)
end

local function toggleButton(parent, x, y, width, label, color, onClick)
    local b = create("TextButton", { Position = UDim2.fromOffset(x, y), Size = UDim2.fromOffset(width, 22),
        BackgroundColor3 = color, BorderSizePixel = 0, Text = label, TextColor3 = THEME.text,
        Font = Enum.Font.GothamMedium, TextSize = 11, AutoButtonColor = true }, parent)
    corner(b, 4)
    create("UIStroke", { Color = THEME.line, Thickness = 1 }, b)
    b.MouseButton1Click:Connect(function()
        pcall(onClick, b)
    end)
    return b
end

local function avatarImage()
    if type(getcustomasset) == "function" and type(writefile) == "function" then
        local file = GC.LogFolder .. "/" .. GC.AvatarUser .. ".png"
        local ok, image = pcall(function()
            if not (type(isfile) == "function" and isfile(file)) then
                if type(isfolder) == "function" and not isfolder(GC.LogFolder) then
                    makefolder(GC.LogFolder)
                end
                local data = game:HttpGet(GC.AvatarUrl)
                if type(data) ~= "string" or (string.sub(data, 1, 8) ~= "\137PNG\r\n\26\n" and string.sub(data, 1, 3) ~= "\255\216\255") then
                    error("not a picture")
                end
                writefile(file, data)
            end
            return getcustomasset(file)
        end)
        if ok and type(image) == "string" and image ~= "" then
            return image
        end
    end
    local ok, image = pcall(function()
        local userId = Players:GetUserIdFromNameAsync(GC.AvatarUser)
        return (Players:GetUserThumbnailAsync(userId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size48x48))
    end)
    return ok and type(image) == "string" and image or ""
end

local function window(width, height)
    if ui.screen and ui.screen.Parent then
        ui.screen:Destroy()
    end
    ui.screen = create("ScreenGui", { Name = "COCOON", ResetOnSpawn = false, DisplayOrder = 999 }, guiParent())
    local frame = create("Frame", { Size = UDim2.fromOffset(width, height), Position = UDim2.new(0, 16, 0.5, -height / 2),
        BackgroundColor3 = THEME.bg, BorderSizePixel = 0 }, ui.screen)
    corner(frame, 8)
    create("UIStroke", { Color = THEME.line, Thickness = 1 }, frame)
    local header = create("Frame", { Size = UDim2.new(1, 0, 0, 26), BackgroundTransparency = 1 }, frame)
    makeDraggable(header, frame)
    local avatar = create("ImageLabel", { Position = UDim2.fromOffset(6, 5), Size = UDim2.fromOffset(16, 16),
        BackgroundColor3 = THEME.field, BorderSizePixel = 0, Image = "" }, header)
    corner(avatar, 8)
    task.spawn(function()
        local image = avatarImage()
        if avatar.Parent then
            avatar.Image = image
        end
    end)
    text(header, 27, 0, width - 52, 26, "COCOON", 13, THEME.text, true)
    local close = create("TextButton", { Position = UDim2.fromOffset(width - 24, 2), Size = UDim2.fromOffset(22, 22),
        BackgroundTransparency = 1, Text = "×", TextColor3 = THEME.dim, Font = Enum.Font.GothamMedium, TextSize = 16 }, header)
    close.MouseButton1Click:Connect(function()
        EggMode, PetMode, GiftMode, TradeRequestMode = false, false, false, false
        uiLog = nil
        ui.now = nil
        frame:Destroy()
    end)
    create("Frame", { Position = UDim2.fromOffset(0, 26), Size = UDim2.new(1, 0, 0, 1), BackgroundColor3 = THEME.line,
        BorderSizePixel = 0 }, frame)
    return frame
end

local function mainWindow()
    local width = 210
    local frame = window(width, 210)
    -- status line (single compact row)
    ui.now = text(frame, 8, 29, width - 16, 14, status.now, 11, THEME.text, true)
    ui.goal = text(frame, 8, 43, width - 16, 13, status.goal, 10, THEME.dim)
    ui.queue = create("TextLabel", { Position = UDim2.fromOffset(8, 56), Size = UDim2.fromOffset(width - 16, 13),
        BackgroundTransparency = 1, Text = "", TextColor3 = THEME.dim, Font = Enum.Font.Gotham, TextSize = 10,
        TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top,
        TextTruncate = Enum.TextTruncate.AtEnd, ClipsDescendants = true }, frame)
    create("Frame", { Position = UDim2.fromOffset(8, 70), Size = UDim2.new(1, -16, 0, 1), BackgroundColor3 = THEME.line,
        BorderSizePixel = 0 }, frame)
    renderStatus()
    local logBox = create("TextLabel", { Position = UDim2.fromOffset(8, 74), Size = UDim2.fromOffset(width - 16, 36),
        BackgroundTransparency = 1, Text = "", RichText = true, TextColor3 = THEME.dim, Font = Enum.Font.Gotham, TextSize = 10,
        TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Bottom, TextWrapped = false,
        ClipsDescendants = true }, frame)
    local shown = {}
    local TONES = { ok = "#5ac878", bad = "#e65a5a", warn = "#d6a046", info = "#9a9aae" }
    uiLog = function(tone, message)
        local safe = string.gsub(string.gsub(string.gsub(tostring(message), "&", "&amp;"), "<", "&lt;"), ">", "&gt;")
        table.insert(shown, '<font color="' .. (TONES[tone] or TONES.info) .. '">' .. safe .. "</font>")
        while #shown > 3 do
            table.remove(shown, 1)
        end
        logBox.Text = table.concat(shown, "\n")
    end

    local bw = width - 16
    local eggButton = toggleButton(frame, 8, 114, bw, "TRADE EGGS [OFF]", MODE_COLORS.egg, function(btn)
        EggMode = not EggMode
        btn.Text = "TRADE EGGS " .. (EggMode and "[ON]" or "[OFF]")
        btn.BackgroundColor3 = EggMode and THEME.ok or MODE_COLORS.egg
        if EggMode then
            task.spawn(startEggTrader)
            say("Egg trader started", "ok")
        else
            say("Egg trader stopped", "warn")
        end
    end)

    local petButton = toggleButton(frame, 8, 140, bw, "GIVE PETS [OFF]", MODE_COLORS.pet, function(btn)
        PetMode = not PetMode
        btn.Text = "GIVE PETS " .. (PetMode and "[ON]" or "[OFF]")
        btn.BackgroundColor3 = PetMode and THEME.ok or MODE_COLORS.pet
        if PetMode then
            task.spawn(startPetGiver)
            say("Pet giver started", "ok")
        else
            say("Pet giver stopped", "warn")
        end
    end)

    local giftButton = toggleButton(frame, 8, 166, bw, "GIVE GIFTS [OFF]", MODE_COLORS.gift, function(btn)
        GiftMode = not GiftMode
        btn.Text = "GIVE GIFTS " .. (GiftMode and "[ON]" or "[OFF]")
        btn.BackgroundColor3 = GiftMode and THEME.ok or MODE_COLORS.gift
        if GiftMode then
            task.spawn(startGiftGiver)
            say("Gift giver started", "ok")
        else
            say("Gift giver stopped", "warn")
        end
    end)

    local reqButton = toggleButton(frame, 8, 192, bw, "SEND TRADE REQ [OFF]", MODE_COLORS.req, function(btn)
        TradeRequestMode = not TradeRequestMode
        btn.Text = "SEND TRADE REQ " .. (TradeRequestMode and "[ON]" or "[OFF]")
        btn.BackgroundColor3 = TradeRequestMode and THEME.ok or MODE_COLORS.req
        if TradeRequestMode then
            task.spawn(startTradeRequester)
            say("Trade requester started", "ok")
        else
            say("Trade requester stopped", "warn")
        end
    end)

    -- Keep buttons in sync when a loop stops itself (out of items)
    task.spawn(function()
        while true do
            task.wait(2)
            if not EggMode and string.find(eggButton.Text, "ON", 1, true) then
                eggButton.Text = "TRADE EGGS [OFF]"
                eggButton.BackgroundColor3 = MODE_COLORS.egg
            end
            if not PetMode and string.find(petButton.Text, "ON", 1, true) then
                petButton.Text = "GIVE PETS [OFF]"
                petButton.BackgroundColor3 = MODE_COLORS.pet
            end
            if not GiftMode and string.find(giftButton.Text, "ON", 1, true) then
                giftButton.Text = "GIVE GIFTS [OFF]"
                giftButton.BackgroundColor3 = MODE_COLORS.gift
            end
            if not TradeRequestMode and string.find(reqButton.Text, "ON", 1, true) then
                reqButton.Text = "SEND TRADE REQ [OFF]"
                reqButton.BackgroundColor3 = MODE_COLORS.req
            end
        end
    end)
end

env.AutoGiver = {
    Stop = function()
        EggMode, PetMode, GiftMode, TradeRequestMode = false, false, false, false
    end,
}

mainWindow()
say("COCOON loaded. Targets: " .. table.concat(TARGET_PLAYER_NAMES, ", "), "ok")
