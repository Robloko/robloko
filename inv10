-- Services
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

-- Player
local player = Players.LocalPlayer

-- Function to print ALL pet IDs in inventory
local function printAllPetIds()
    print("🐾 ALL PETS IDs IN INVENTORY")
    print("=============================")

    local success, data = pcall(function()
        local clientData = require(ReplicatedStorage.ClientModules.Core.ClientData)
        return clientData.get_data()[player.Name]
    end)

    if not success or not data then
        print("❌ Failed to get player data")
        return
    end

    if not data.inventory or not data.inventory.pets then
        print("❌ No pets found in inventory")
        return
    end

    local petCount = 0
    for _ in pairs(data.inventory.pets) do
        petCount = petCount + 1
    end

    print("📊 Total pets: " .. petCount)
    print("")

    -- Print every pet: ID and unique ID
    local count = 0
    for petUniqueID, petData in pairs(data.inventory.pets) do
        count = count + 1
        print(count .. ". " .. tostring(petData.id) .. "  (unique: " .. petUniqueID .. ")")
    end

    print("")
    print("📊 Printed " .. count .. " of " .. petCount .. " pets")
end

-- Run the function
printAllPetIds()
