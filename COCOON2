		    params.FilterDescendantsInstances = { character }
		    for _, height in ipairs({ 6, 12, 25 }) do
		        local hit = workspace:Raycast(root.Position + Vector3.new(0, height, 0), Vector3.new(0, -(height + 30), 0), params)
