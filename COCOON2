	function Needs.finish(key, ok, why)
		local now = Util.now()
		local wait = HouseTasks.takeWait(key)
		if wait or key == "mannequin_setup" or key == "mannequin_buy" or key == "auto_pay" then
			e.nextAt[key] = now + (wait or 60)
		end
		if ok then
			e.failures[key] = 0
			return
		end
		e.failures[key] = (e.failures[key] or 0) + 1
		if string.sub(tostring(why), 1, 3) == "no " and string.find(tostring(why), " in your house", 1, true) then
			e.coolUntil[key] = now + 600
		elseif e.failures[key] >= e.farm.MaxConsecutiveFailures then
			e.failures[key] = 0
