		    local lure, mannequins = 0, {}
		    for key, piece in pairs(data) do
		        if type(piece) == "table" and piece.id == H.LureKind then
		            lure += 1
		        elseif type(piece) == "table" and piece.id == H.MannequinKind then
		            table.insert(mannequins, tostring(key))
