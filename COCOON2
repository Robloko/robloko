		            humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
		        end
		    end)
		    return lifted and "lifted" or "ok"
		end
		-- Moves my character into door `doorIndex`'s circle. options = { avoid = { [circles] = true } (groups that took no
