		for i = 1, maxEggs do
			if pcall(function() api("TradeAPI/AddItemToOffer"):FireServer(eggs[i].uid) end) then
				added += 1
				say("Added egg " .. i .. "/" .. maxEggs .. ": " .. eggs[i].name)
