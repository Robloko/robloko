		-- the dashboard: Bucks, tickets, age potions, pets, what is done now; gains counted from when the screen opened
		local openedAt, startBucks, startTickets = os.clock(), money(), tonumber(getKey("pet_recycler_tickets_2026")) or 0
		local function signed(n)
			return (n >= 0 and "+" or "") .. tostring(n)
		end
		local function dashboard()
			local bucks, tickets = money(), tonumber(getKey("pet_recycler_tickets_2026")) or 0
			local minutes = math.floor((os.clock() - openedAt) / 60)
			return table.concat({
				"CPU", "",
				string.format("Bucks  %d  (%s)", bucks, signed(bucks - startBucks)),
				string.format("Tickets  %d  (%s)", tickets, signed(tickets - startTickets)),
				string.format("Age potions  %d", #itemsOf("food", { pet_age_potion = true })),
				string.format("Pets  %d", #itemsOf("pets")),
				string.format("On for  %dh %dm", minutes // 60, minutes % 60), "",
				"Now: " .. tostring(status.now), tostring(status.goal), "", "Tap to close",
			}, "\n")
		end
		local function restore()
			pcall(function() RunService:Set3dRenderingEnabled(true) end)
			if before.fps and type(setfpscap) == "function" then
				pcall(setfpscap, before.fps)
			end
			pcall(function() settings().Rendering.QualityLevel = before.quality end)
			pcall(function() UserSettings():GetService("UserGameSettings").SavedQualityLevel = before.savedQuality end)
			pcall(function() UserSettings():GetService("UserGameSettings").MasterVolume = before.volume end)
		end
		function s.close()
			if not alive then
				return
			end
			alive, saver = false, nil
			Interaction.clickGuards.cpuSaver = nil
			for _, c in ipairs(connections) do
				c:Disconnect()
			end
			restore()
			gui:Destroy()
			GC.CpuSaver = false
		end
		pcall(function() before.quality = settings().Rendering.QualityLevel end)
		pcall(function()
			local userGame = UserSettings():GetService("UserGameSettings")
			before.savedQuality, before.volume = userGame.SavedQualityLevel, userGame.MasterVolume
		end)
		if type(setfpscap) == "function" then
			local ok, cap = pcall(function() return type(getfpscap) == "function" and getfpscap() or 60 end)
			before.fps = ok and tonumber(cap) or 60
		end
		local function save() -- again every 30 s: a teleport can turn 3D drawing back on
			pcall(function() RunService:Set3dRenderingEnabled(false) end)
			if type(setfpscap) == "function" then
				pcall(setfpscap, 15)
			end
			pcall(function() settings().Rendering.QualityLevel = Enum.QualityLevel.Level01 end)
			pcall(function()
				local userGame = UserSettings():GetService("UserGameSettings")
				userGame.SavedQualityLevel, userGame.MasterVolume = Enum.SavedQualitySetting.QualityLevel1, 0
			end)
		end
		local holds = 0
		Interaction.clickGuards.cpuSaver = function(sending) -- virtual taps must land on the game, not on the black
			holds = math.max(0, holds + (sending and 1 or -1))
			gui.Enabled = alive and holds == 0
		end
		table.insert(connections, back.MouseButton1Click:Connect(s.close))
		pcall(function()
			table.insert(connections, game:GetService("GuiService").ErrorMessageChanged:Connect(function()
				s.close() -- Roblox's kick / disconnect window must be seen
			end))
		end)
		gui.Parent = (type(gethui) == "function" and gethui()) or game:GetService("CoreGui")
		saver, GC.CpuSaver = s, true
		task.spawn(function()
			local savedAt = -math.huge
			while alive do
				if os.clock() - savedAt >= 30 then
					savedAt = os.clock()
					save()
				end
				info.Text = dashboard()
				task.wait(2)
			end
		end)
	end
