	local e -- the engine, built on first use (the game must be loaded); nil until then
	local logger = {} -- cocoon.txt's logger calls go to this script's log
	for _, level in ipairs({ "debug", "info", "success", "warn", "error" }) do
		logger[level] = function(_, category, message)
			if level ~= "debug" then
				log(string.upper(level), tostring(category) .. ": " .. tostring(message))
