	-- ================= NEON FUSER =================
	local function doNeonFusion()
		local data = getPlayerData()
		if not data or not data.inventory or not data.inventory.pets then
			say("No pet data available", "bad")
			return 0
		end
		local fullGrown = {}
		for id, pet in pairs(data.inventory.pets) do
			local props = pet.properties or {}
			if pet.id and not props.neon and not props.mega and (props.age or 0) == 6 then
				fullGrown[pet.id] = fullGrown[pet.id] or {}
				table.insert(fullGrown[pet.id], id)
			end
		end
		local fused = 0
		for petType, petList in pairs(fullGrown) do
			while #petList >= 4 do
				local fusionSet = {}
				for _ = 1, 4 do
					table.insert(fusionSet, table.remove(petList, 1))
				end
				say("Fusing 4 Full Grown " .. petType .. " into NEON...")
				local success, err = pcall(function()
					local neonAPI = ReplicatedStorage.API:FindFirstChild("PetAPI/DoNeonFusion")
					if neonAPI then
						return neonAPI:InvokeServer(fusionSet)
					end
					local altAPI = ReplicatedStorage.API:FindFirstChild("PetAPI/NeonFusion")
						or ReplicatedStorage.API:FindFirstChild("PetAPI/FuseNeon")
						or ReplicatedStorage.API:FindFirstChild("NeonAPI/Fuse")
					if altAPI then
						return altAPI:InvokeServer(fusionSet)
					end
					error("neon fusion API not found")
				end)
				if success and err ~= nil then
					say("Created NEON " .. petType .. "!", "ok")
					fused += 1
					task.wait(3)
				else
					say("Fusion failed for " .. petType .. ": " .. tostring(err), "bad")
					break
				end
			end
		end
		return fused
	end

	local function startNeonFuser()
		while on.neon do
			local fused = doNeonFusion()
			if fused == 0 then
				say("No 4x full-grown (age 6) pets to fuse. Waiting 30 s...", "warn")
				task.wait(30)
			else
				say("NEON fusion pass complete: " .. fused .. " created", "ok")
				task.wait(5)
			end
		end
	end

	-- ================= MEGA FUSER =================
	local function doMegaFusion()
		local data = getPlayerData()
		if not data or not data.inventory or not data.inventory.pets then
			say("No pet data available", "bad")
			return 0
		end
		local age6Neons = {}
		for id, pet in pairs(data.inventory.pets) do
			if pet.id and pet.properties and pet.properties.neon and (pet.properties.age or 0) == 6 then
				age6Neons[pet.id] = age6Neons[pet.id] or {}
				table.insert(age6Neons[pet.id], id)
			end
		end
		local fused = 0
		for petType, petList in pairs(age6Neons) do
			while #petList >= 4 do
				local fusionSet = { petList[1], petList[2], petList[3], petList[4] }
				say("Fusing 4 age-6 NEON " .. petType .. " into MEGA...")
				local success, err = pcall(function()
					local megaAPI = ReplicatedStorage.API:FindFirstChild("PetAPI/DoMegaFusion")
					if megaAPI then
						return megaAPI:InvokeServer(fusionSet)
					end
					return ReplicatedStorage.API:FindFirstChild("PetAPI/DoNeonFusion"):InvokeServer(fusionSet)
				end)
				if success then
					say("Created MEGA " .. petType .. "!", "ok")
					fused += 1
					for _ = 1, 4 do
						table.remove(petList, 1)
					end
					task.wait(2)
				else
					say("MEGA fusion failed: " .. tostring(err), "bad")
					break
				end
			end
		end
		return fused
	end

	local function startMegaFuser()
		while on.mega do
			local fused = doMegaFusion()
			if fused == 0 then
				say("No 4x age-6 neons to fuse into mega. Waiting 30 s...", "warn")
				task.wait(30)
			else
				say("MEGA fusion pass complete: " .. fused .. " created", "ok")
				task.wait(5)
			end
		end
	end

	-- ================= PET PEN (cocoon1.txt PetFarm-style) =================
	local penPrioritySet = {}
	for _, v in ipairs(PEN_PRIORITY_EGGS) do
		penPrioritySet[string.lower(v)] = true
	end

	local function penSnapshot()
		local data = getPlayerData()
		local active = data and data.idle_progression_manager and data.idle_progression_manager.active_pets
		local snapshot = {}
		for uniqueId in pairs(active or {}) do
			local pet = data.inventory and data.inventory.pets and data.inventory.pets[uniqueId]
			if pet then
				table.insert(snapshot, { unique_id = uniqueId, name = pet.id,
					age = pet.properties and pet.properties.age or 0, neon = pet.properties and pet.properties.neon or false })
			end
		end
		return snapshot
	end

	local function penAddPet(uniqueId)
		return (pcall(function() api("IdleProgressionAPI/AddPet"):FireServer(uniqueId) end))
	end

	local function penRemovePet(uniqueId)
		return (pcall(function() api("IdleProgressionAPI/RemovePet"):FireServer(uniqueId) end))
	end

	-- Remove everything from the pen that isn't a NEON or a priority pet
	local function penPurgeTrash()
		local data = getPlayerData()
		local active = data and data.idle_progression_manager and data.idle_progression_manager.active_pets
		local removed = 0
		for uniqueId in pairs(active or {}) do
			local pet = data.inventory and data.inventory.pets and data.inventory.pets[uniqueId]
			if pet and pet.id and pet.properties and not pet.properties.neon and not penPrioritySet[string.lower(pet.id)] then
				say("Purging trash from pen: " .. prettyKind(pet.id), "info")
				penRemovePet(uniqueId)
				removed += 1
				task.wait(0.7)
			end
		end
		return removed
	end

	-- Buy one egg: recycler egg ONLY if we have tickets, else cracked egg with Bucks
	local function penBuyOneEgg()
		local tickets = penTickets()
		if PEN_USE_RECYCLER_FIRST and tickets > PEN_TICKET_RESERVE then
			say("Buying a recycler egg with tickets (" .. tickets .. " left)", "info")
			local before = #itemsOf("pets", nil)
			pcall(function()
				ReplicatedStorage.API:FindFirstChild("ShopAPI/BuyItem"):InvokeServer("pets", PEN_RECYCLER_EGG, { buy_count = 1 })
			end)
			if waitUntil(function() return #itemsOf("pets", nil) > before end, 8) then
				return PEN_RECYCLER_EGG
			end
			pcall(function()
				ReplicatedStorage.API:FindFirstChild("RecyclerAPI/BuyEgg"):InvokeServer(PEN_RECYCLER_EGG, { buy_count = 1 })
			end)
			if waitUntil(function() return #itemsOf("pets", nil) > before end, 5) then
				return PEN_RECYCLER_EGG
			end
			say("Recycler purchase failed, falling back to cracked egg", "warn")
		end
		if penCanAfford(PEN_CRACKED_PRICE) then
			say("Buying a Cracked Egg (" .. PEN_CRACKED_PRICE .. " Bucks)", "info")
			local before = #itemsOf("pets", nil)
			pcall(function()
				ReplicatedStorage.API:FindFirstChild("ShopAPI/BuyItem"):InvokeServer("pets", PEN_CRACKED_EGG, { buy_count = 1 })
			end)
			if waitUntil(function() return #itemsOf("pets", nil) > before end, 8) then
				return PEN_CRACKED_EGG
			end
		end
		return nil
	end

	-- Fill empty slots: 1) NEON pets under age 6, 2) inventory priority pets/eggs in list order,
	-- 3) buy eggs (tickets -> recycler egg, else Bucks -> cracked egg)
	local function penAddPriorityPets(snapshot)
		local data = getPlayerData()
		if not data or not data.inventory or not data.inventory.pets then
			return 0
		end
		local slotsOpen = PEN_SLOTS - #snapshot
		if slotsOpen <= 0 then
			return 0
		end
		local inPen = {}
		for _, pet in ipairs(snapshot) do
			inPen[pet.unique_id] = true
		end
		local added = 0
		local function add(uniqueId, line)
			penAddPet(uniqueId)
			say(line, "ok")
			added += 1
			inPen[uniqueId] = true
			task.wait(0.6)
		end
		for uniqueId, petData in pairs(data.inventory.pets) do
			local petAge = petData.properties and petData.properties.age or 0
			if petData.properties and petData.properties.neon and petAge < 6 and not inPen[uniqueId] and added < slotsOpen then
				add(uniqueId, "Added NEON to pen: " .. prettyKind(petData.id) .. " (Age " .. petAge .. ")")
			end
		end
		for _, eggName in ipairs(PEN_PRIORITY_EGGS) do
			for uniqueId, petData in pairs(data.inventory.pets) do
				local petAge = petData.properties and petData.properties.age or 0
				if string.lower(petData.id or "") == string.lower(eggName) and petAge < 6 and not inPen[uniqueId]
					and added < slotsOpen then
					add(uniqueId, "Added PRIORITY to pen: " .. prettyKind(petData.id) .. " (Age " .. petAge .. ")")
				end
			end
		end
		while added < slotsOpen and on.pen do
			local eggKind = penBuyOneEgg()
			if not eggKind then
				say("No tickets and not enough Bucks (" .. money() .. ") - can't buy more eggs", "warn")
				break
			end
			task.wait(3) -- wait for the server to replicate the purchase
			local newData = getPlayerData()
			local found = false
			for uniqueId, petData in pairs(newData and newData.inventory and newData.inventory.pets or {}) do
				local petAge = petData.properties and petData.properties.age or 0
				if string.lower(petData.id or "") == string.lower(eggKind) and petAge < 6 and not inPen[uniqueId] then
					add(uniqueId, "Added PURCHASED " .. prettyKind(eggKind) .. " to pen")
					found = true
					break
				end
			end
			if not found then
				say("Bought egg but couldn't find it in inventory - stopping auto-buy", "warn")
				break
			end
		end
		say("Pen refill: added " .. added .. " pet(s) this cycle", "info")
		return added
	end

	local function startPenFiller()
		say("Pet Pen started (PetFarm-style cycles)", "ok")
		while on.pen do
			setGoal(string.format("Pet Pen %d/%d  (tickets %d, bucks %d)", #penSnapshot(), PEN_SLOTS, penTickets(), money()))
			if PEN_COMMIT_FIRST then
				pcall(function() ReplicatedStorage.API["IdleProgressionAPI/CommitAllProgression"]:FireServer() end)
				say("Committed progression to refresh age data", "info")
				task.wait(3)
			end
			if doNeonFusion() > 0 then
				task.wait(5)
			end
			penPurgeTrash()
			task.wait(2)
			for _, pet in ipairs(penSnapshot()) do
				if pet.age >= 6 then
					say("Removing aged pet from pen: " .. prettyKind(pet.name) .. " (Age " .. pet.age .. ")", "info")
					penRemovePet(pet.unique_id)
					task.wait(0.7)
				end
			end
			task.wait(2)
			penAddPriorityPets(penSnapshot())
			setGoal(string.format("Pet Pen %d/%d  (tickets %d, bucks %d)", #penSnapshot(), PEN_SLOTS, penTickets(), money()))
			task.wait(PEN_CYCLE_SECONDS)
		end
		say("Pet Pen stopped", "warn")
	end

	-- the window's buttons, in cocoon1.txt's order
	local modes = {
		{ key = "egg", label = "Eggs", start = startEggTrader },
		{ key = "pet", label = "Pets", start = startPetGiver },
		{ key = "gift", label = "Gifts", start = startGiftGiver },
		{ key = "req", label = "Trade Req", start = startTradeRequester },
		{ key = "potion", label = "Potions", start = startPotionReleaser },
		{ key = "recycle", label = "Recycle", start = startPetRecycler },
		{ key = "neon", label = "Neon", start = startNeonFuser },
		{ key = "mega", label = "Mega", start = startMegaFuser },
		{ key = "pen", label = "Pet Pen", start = startPenFiller },
	}
	return {
		modes = modes,
		on = on,
		targets = TARGET_PLAYER_NAMES,
		stopAll = function()
			for key in pairs(on) do
				on[key] = false
			end
		end,
		tickets = penTickets,
		-- console / debug, as cocoon1.txt exposed them
		PenSnapshot = penSnapshot, PenPurgeTrash = penPurgeTrash, PenAddPet = penAddPet, PenRemovePet = penRemovePet,
		PenBuyOneEgg = penBuyOneEgg, PenAddPriorityPets = penAddPriorityPets,
	}
end)()
-- the Pet & Baby Farm loop; while the Achievements run, they do the needs between their steps (one thing moves at a time)
local function runFarm()
	if not waitUntil(function() return getKey("loaded_in") == true end, 120) then
		say("The game hasn't loaded yet: the Pet & Baby Farm is off", "bad")
		farmOn = false
		return
	end
	say("Pet & Baby Farm on", "ok")
	while farmOn do
		if running then
			task.wait(1)
		else
			local ok, why = pcall(careStep)
			if not ok then
				say("Pet & Baby Farm: " .. tostring(why), "bad")
				task.wait(3)
			end
		end
	end
	say("Pet & Baby Farm off", "warn")
end
local function mainWindow()
	local width = 270
	local frame = window(width, 402, function()
		running = false
		farmOn = false
		Extra.stopAll()
		uiLog = nil
		ui.now = nil
	end)
	text(frame, 10, 36, 40, 16, "Now", 11, THEME.accent, true)
	ui.now = text(frame, 48, 36, width - 58, 16, status.now, 12, THEME.text, true)
	text(frame, 10, 54, 40, 14, "Goal", 11, THEME.accent, true)
	ui.goal = text(frame, 48, 54, width - 58, 14, status.goal, 11, THEME.text)
	ui.queue = create("TextLabel", { Position = UDim2.fromOffset(10, 72), Size = UDim2.fromOffset(width - 20, 40),
		BackgroundTransparency = 1, Text = "", TextColor3 = THEME.dim, Font = Enum.Font.Gotham, TextSize = 11,
		TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, TextWrapped = false,
		ClipsDescendants = true }, frame)
	create("Frame", { Position = UDim2.fromOffset(10, 114), Size = UDim2.new(1, -20, 0, 1), BackgroundColor3 = THEME.line,
		BorderSizePixel = 0 }, frame)
	renderStatus()
	local logBox = create("TextLabel", { Position = UDim2.fromOffset(10, 120), Size = UDim2.fromOffset(width - 20, 56),
		BackgroundTransparency = 1, Text = "", RichText = true, TextColor3 = THEME.dim, Font = Enum.Font.Gotham, TextSize = 11,
		TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Bottom, TextWrapped = false,
		ClipsDescendants = true }, frame)
	local shown = {}
	local TONES = { ok = "#5ac878", bad = "#e65a5a", warn = "#d6a046", info = "#9a9aae" }
	uiLog = function(tone, message)
		local safe = string.gsub(string.gsub(string.gsub(tostring(message), "&", "&amp;"), "<", "&lt;"), ">", "&gt;")
		table.insert(shown, '<font color="' .. (TONES[tone] or TONES.info) .. '">' .. safe .. "</font>")
		while #shown > 4 do
			table.remove(shown, 1)
		end
		logBox.Text = table.concat(shown, "\n")
	end
	local half = (width - 26) / 2
	local third = (width - 32) / 3
	local quarter = (half - 6) / 2
	-- switches: green = on, red = off; every second they are painted again (a mode can switch itself off)
	local switches = {}
	local function toggle(x, y, w, label, get, flip)
		local b
		local function paint()
			b.BackgroundColor3 = get() == true and THEME.ok or THEME.bad
		end
		b = button(frame, x, y, w, label, THEME.text, function()
			flip()
			paint()
		end)
		b.TextSize = 10
		paint()
		table.insert(switches, paint)
	end
	task.spawn(function()
		while frame.Parent do
			task.wait(1)
			for _, paint in ipairs(switches) do
				pcall(paint)
			end
		end
	end)
	-- row 1: preset list, CPU, Skip
	local presets, presetAt = Needs.presets(), 1
	for i, preset in ipairs(presets) do
		if preset.id == GC.Preset then
			presetAt = i
		end
	end
	local presetButton, presetList
	presetButton = button(frame, 10, 184, half, presets[presetAt].name .. "  ▾", THEME.accent, function()
		presetList.Visible = not presetList.Visible
	end)
	presetButton.TextSize = 11
	-- opens upward, over the log
	presetList = create("Frame", { Position = UDim2.fromOffset(10, 180 - (#presets * 24 + 4)),
		Size = UDim2.fromOffset(half, #presets * 24 + 4), BackgroundColor3 = THEME.bg, BorderSizePixel = 0,
		Visible = false, ZIndex = 10 }, frame)
	corner(presetList, 5)
	create("UIStroke", { Color = THEME.line, Thickness = 1 }, presetList)
	for i, preset in ipairs(presets) do
		local choice = button(presetList, 2, 2 + (i - 1) * 24, half - 4, preset.name, THEME.text, function()
			presetList.Visible = false
			Needs.setPreset(preset.id)
			presetButton.Text = preset.name .. "  ▾"
			say(preset.name .. ": " .. preset.about, "info")
		end)
		choice.ZIndex = 11
	end
	button(frame, 16 + half, 184, quarter, "CPU", THEME.text, function()
		Needs.cpuSaver(true)
	end)
	button(frame, 22 + half + quarter, 184, quarter, "Skip", THEME.text, function()
		skipPressed = true
	end)
	-- row 2: Transfer Thingy (MannequinTransfer); GC.Transfer is the live table its jobs read
	local function transferToggle(x, key, label)
		toggle(x, 214, third, label, function() return GC.Transfer[key] end, function()
			GC.Transfer[key] = not GC.Transfer[key]
			if GC.Transfer[key] and key ~= "Mannequin" and (tonumber(GC.Transfer.MainUserId) or 0) == 0 then
				say("set GC.Transfer.MainUserId first: the ALT needs to know the Main", "warn")
			end
		end)
	end
	transferToggle(10, "Mannequin", "Mannequin")
	transferToggle(16 + third, "BuyMannequin", "Buy")
	transferToggle(22 + third * 2, "AutoPay", "Pay")
	-- row 3: Achievements and the Pet & Baby Farm, each on its own
	toggle(10, 244, half, "Achievements", function() return running end, function()
		if running then
			running = false
			show("Stopped", "", "")
			return
		end
		running = true
		onFinished = nil
		task.spawn(function()
			if not pcall(runGuide) then
				say("something went wrong, switch Achievements on again", "bad")
				running = false
			end
		end)
	end)
	local function startFarm()
		farmOn = true
		task.spawn(runFarm)
	end
	toggle(16 + half, 244, half, "Pet & Baby Farm", function() return farmOn end, function()
		if farmOn then
			farmOn = false
		else
			startFarm()
		end
	end)
	-- rows 4-6: cocoon1.txt modes
	for i, mode in ipairs(Extra.modes) do
		local col, row = (i - 1) % 3, (i - 1) // 3
		toggle(10 + col * (third + 6), 274 + row * 30, third, mode.label, function() return Extra.on[mode.key] end, function()
			Extra.on[mode.key] = not Extra.on[mode.key]
			if Extra.on[mode.key] then
				task.spawn(mode.start)
				say(mode.label .. " started", "ok")
			else
				say(mode.label .. " stopped", "warn")
			end
		end)
	end
	text(frame, 10, 362, width - 20, 14, "Targets: " .. table.concat(Extra.targets, ", "), 10, THEME.dim)
	if GC.CpuSaver then
		Needs.cpuSaver(true)
	end
	if GC.PetBabyFarm then
		startFarm()
	end
	footer(frame, width, 380)
end
