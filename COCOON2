		-- ---------------------------------------------------------------- MAIN: mannequins in my house
		local function cframeOf(piece)
		    local found
		    local function scan(t, depth)
		        for _, value in pairs(t) do
		            if found then
		                return
		            end
		            local kind = typeof(value)
		            if kind == "CFrame" then
		                found = value
		            elseif type(value) == "table" and depth < 2 then
		                scan(value, depth + 1)
		            end
