		                    Interaction.hauntletCircleId(circles), math.floor(tonumber(dist) or 0),
		                    chained or (added and string.format("added %.0f s ago", os.clock() - added) or "nearest"),
		                    count or 1, (count or 1) == 1 and "" or "s")
