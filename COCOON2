	local function init()
		if e then
			return e
		end
		local preset = GC.Preset ~= "" and GC.Preset or nil
		local config, warnings = Config.build({ Preset = preset, Farm = { AutoNeeds = { Enabled = true, Skip = {} },
			BabyMode = GC.BabyNeeds, Transfer = GC.Transfer } }) -- baby needs follow GC.BabyNeeds, also under PotionFarm
		for _, warning in ipairs(warnings) do
			log("WARN", "Config: " .. warning)
		end
		local maid, state = Maid.new(), State.new()
		local gameData = import("Game/GameData").new(logger)
		if not gameData:start(maid) then
			maid:Clean()
			return nil
		end
		local petLocator = import("Game/PetLocator").new(gameData)
		import("Game/PlayerSync").start(maid, state, gameData, petLocator, logger)
		local tracker = import("Game/AilmentTracker").new(logger, state, { notify = function() end }, gameData)
		tracker:start(maid)
		HouseTasks.start(maid)
		local interaction = import("Game/Interaction").new(logger, state)
		e = { maid = maid, state = state, gameData = gameData, petLocator = petLocator, interaction = interaction,
			travel = import("Game/Travel").new(logger, state, interaction, config.Farm),
			furniture = import("Game/Furniture").new(gameData, state), farm = config.Farm,
			completions = {}, failures = {}, coolUntil = {}, nextAt = {}, homeNotedAt = -math.huge }
		GC.Transfer = config.Farm.Transfer -- the checked copy: edits from the console still reach the jobs
		maid:Give(tracker.Completed:Connect(function(owner, petUnique, kind)
			e.completions[kind .. "|" .. owner .. "|" .. tostring(petUnique)] = Util.now()
		end))
		return e
	end
	local function activeNeeds()
		return e.state:get("ailments.active", {})
	end
	-- TaskManager:_group (needs of an unequipped pet can't be done)
	local function groupOf(kind)
		local group
		for _, entry in ipairs(activeNeeds()) do
			if entry.kind == kind and (entry.owner ~= "pet" or e.gameData:isPetEquipped(entry.petUnique)) then
				group = group or { kind = kind, entries = {}, anyInProgress = false, maxRate = 0, oldest = math.huge }
				table.insert(group.entries, entry)
				if entry.owner == "pet" and not group.petEntry then
					group.petEntry = entry
				end
				group.anyInProgress = group.anyInProgress or entry.inProgress == true
				group.maxRate = math.max(group.maxRate, entry.rate or 0)
				group.oldest = math.min(group.oldest, entry.createdAt or math.huge)
			end
		end
		return group
	end
	local function blocked(key)
		return Util.now() < (e.coolUntil[key] or 0)
	end
	-- TaskManager:_makeContext
	local function makeContext(maid, startedAt)
		local ctx = { logger = logger, state = e.state, interaction = e.interaction, travel = e.travel, petLocator = e.petLocator,
			furniture = e.furniture, gameData = e.gameData, farmConfig = e.farm, maid = maid, currentGroup = groupOf }
		function ctx.waitUntil(predicate, seconds)
			local deadline = Util.now() + seconds
			while true do
				if predicate() then
					return true
				end
				if Util.now() >= deadline then
					return false
				end
				task.wait(0.25)
			end
		end
		function ctx.completedSince(kind, owner, petUnique)
			local at = e.completions[kind .. "|" .. owner .. "|" .. tostring(petUnique)]
			return at ~= nil and at >= startedAt
		end
		function ctx.setWaiting() end
		function ctx.phase() end
		function ctx.findEntry(kind, owner, petUnique)
			for _, entry in ipairs(activeNeeds()) do
				if entry.kind == kind and entry.owner == owner and (owner == "baby" or entry.petUnique == petUnique) then
					return entry
				end
			end
			return nil
		end
		function ctx.isKindGone(kind)
			return groupOf(kind) == nil
		end
		function ctx.kindCompletedSince(kind, since)
			for key, at in pairs(e.completions) do
				if at >= since and string.sub(key, 1, #kind + 1) == kind .. "|" then
					return true
				end
			end
			return false
		end
		return ctx
	end
	-- TaskManager:_selectSetupJob + the Transfer part of _selectHouseJob (MAIN jobs only while already at home)
	local function transferJob()
		local t = e.farm.Transfer
		local now = Util.now()
		local atHome = e.travel:isAt(HOUSE)
		if atHome and now - e.homeNotedAt >= 10 then
			e.homeNotedAt = now
			HouseTasks.noteHome(e.gameData)
		end
		local function due(key)
			return not blocked(key) and now >= (e.nextAt[key] or 0)
		end
		if t.MannequinCount ~= e.mannequinTarget then -- a new count is looked at right away
			e.mannequinTarget = t.MannequinCount
			e.nextAt.mannequin_setup = 0
		end
		if t.Mannequin == true and due("mannequin_setup") and (atHome or MannequinTransfer.mannequinSetupNeeded(t)) then
			return "mannequin_setup", "Mannequins (MAIN): place and price", MannequinTransfer.mannequinSetup
		end
		if t.AutoPay == true or t.BuyMannequin == true then
			local main = MannequinTransfer.mainPlayer(t)
			if main and t.AutoPay == true and due("auto_pay") then
				return "auto_pay", "Auto Pay: Cash Register of " .. main.Name, MannequinTransfer.pay
			end
			if main and t.BuyMannequin == true and due("mannequin_buy") then
				return "mannequin_buy", "Buy " .. main.Name .. "'s mannequin outfits", MannequinTransfer.buyMannequins
			end
		end
		return nil
	end
	-- TaskManager:_priorityOf + _selectGroup
	local function priorityOf(kind, group)
		local priority = e.farm.Priority[kind] or 0
		if e.farm.SmartPriority == false then
			return priority
		end
		local destination = GameConstants.LocationForAilment[kind]
		if destination and not GameConstants.SpotForAilment[kind] and e.travel:isAt(destination) then
			priority += 12
		elseif GameConstants.FurnitureForAilment[kind] and e.travel:isAt(HOUSE) then
			priority += 8
		end
		return priority + (group.anyInProgress and 3 or 0)
	end
	local function needJob()
		local farm = e.farm
		farm.BabyMode = GC.BabyNeeds == true
		local team = e.state:get("player.team")
		if farm.BabyMode and team ~= nil and team ~= GameConstants.BabiesTeam and not blocked("team") then
			return "team", "Joining the Babies team (baby needs)", Tasks.team
		end
		for _, entry in ipairs(activeNeeds()) do -- a started need where I already stand goes first
			local destination = GameConstants.LocationForAilment[entry.kind]
			if entry.inProgress and destination and not GameConstants.SpotForAilment[entry.kind]
				and GameConstants.needOn(farm, entry.kind) and not blocked(entry.kind) and e.travel:isAt(destination) then
				local group = groupOf(entry.kind)
				local def = group and Tasks.findFor(entry.kind)
				if def then
					return entry.kind, entry.kind, def, group
				end
			end
		end
		local best, bestDef, bestPriority = nil, nil, -math.huge
		local seen = {}
		for _, entry in ipairs(activeNeeds()) do
			local kind = entry.kind
			if not seen[kind] then
				seen[kind] = true
				local def = Tasks.findFor(kind)
				if def and GameConstants.needOn(farm, kind) and not blocked(kind) then
					local group = groupOf(kind)
					local priority = group and priorityOf(kind, group)
					if group and (priority > bestPriority or (priority == bestPriority and group.oldest < best.oldest)) then
						best, bestDef, bestPriority = group, def, priority
					end
				end
			end
		end
		if best then
			local owners = {}
			for _, entry in ipairs(best.entries) do
				table.insert(owners, entry.owner == "baby" and "baby" or prettyKind(entry.petKind or "pet"))
			end
			return best.kind, string.gsub(best.kind, "_", " ") .. " (" .. table.concat(owners, " + ") .. ")", bestDef, best
		end
		return nil
	end
