		task.wait(3)
		pcall(function() api("TradeAPI/AcceptNegotiation"):FireServer() end)
		task.wait(6)
		if pcall(function() api("TradeAPI/ConfirmTrade"):FireServer() end) then
			say("Trade completed: " .. added .. " eggs to " .. targetPlayer.Name, "ok")
