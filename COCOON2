		function HouseTasks.baits(gameData)
		    local inventory = gameData and gameData:get(KEYS.Inventory)
		    if type(inventory) ~= "table" then
		        return nil -- not known yet (never "no baits")
		    end
		    local byId, list = {}, {}
		    for category, items in pairs(inventory) do
