		        return
		    end
		    if type(self._data[rootKey]) ~= "table" then
		        self._data[rootKey] = {}
		    end
		    local node = self._data[rootKey]
		    for index = 2, #path - 1 do
		        local part = path[index]
		        if type(node[part]) ~= "table" then
		            node[part] = {}
		        end
		        node = node[part]
