-- ==================================================================
-- COCOON v8 — Server Stats + Family Builder + Parallel Needs Loop
-- Order per subject: sleep -> bored -> bath -> (rest)
-- HoldBaby:   InvokeServer({ [1] = char })
-- EjectBaby:  FireServer ({ [1] = char })
-- Baby furniture: MakeBabyUseFurniture:FireServer(char, folderId, partName)
-- Furniture discovered live from workspace.HouseInteriors.furniture[...]
-- While A dwells, B is held & placed on its own furniture in parallel.
-- ==================================================================
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local player = Players.LocalPlayer

local env = getgenv and getgenv() or {}
if env.COCOON and env.COCOON.Stop then pcall(env.COCOON.Stop) end

-- ================= CONFIG =================
local INVITE_DELAY      = 1.0
local FAMILY_SETTLE     = 2.0
local FURNITURE_DWELL   = 20
local BETWEEN_SUBJECTS  = 1.5
local BETWEEN_FURNITURE = 0.8
local MAX_TASK_PASSES   = 1
local MAX_PARALLEL      = 2   -- how many subjects can be held at once

-- ================= NEED ORDER =================
-- First three are the required "start" tasks, in this order.
local BASE_NEEDS = { "sleep", "bored", "bath" }

local PET_NEEDS  = { "sleep", "bored", "bath", "dirty", "food", "drink", "toilet" }
local BABY_NEEDS = { "sleep", "bored", "bath" }

-- Furniture model names per need (used by dynamic discovery)
local NEED_MODELS = {
    sleep  = { "BasicBed",     "ModernBed",    "Bed" },
    bored  = { "Piano",        "ToyBox" },
    bath   = { "ModernShower", "CheapPetBathtub", "Bathtub" },
    dirty  = { "CheapPetBathtub", "ModernShower", "Bathtub" },
    food   = { "PetFoodBowl",  "FoodBowl",     "BasicFoodBowl" },
    drink  = { "PetWaterBowl", "WaterBowl",    "BasicWaterBowl" },
    toilet = { "AilmentsRefresh2024LitterBox", "LitterBox" },
}

-- ================= STATUS / LOG =================
local ui = {}
local uiLog = nil
local status = { now = "Ready", goal = "Pick an action", queue = {} }

local function renderStatus()
    if ui.now then
        pcall(function()
            ui.now.Text  = status.now
            ui.goal.Text = status.goal
            ui.queue.Text = #status.queue > 0 and ("Next: " .. table.concat(status.queue, "\n         ")) or ""
        end)
    end
end
local function setGoal(t, q) status.goal = t or ""; status.queue = q or {}; renderStatus() end
local function setNow(t) status.now = t or ""; renderStatus() end
local function say(text, tone)
    setNow(text)
    if uiLog then pcall(uiLog, tone or "info", text) end
    print("[COCOON] " .. tostring(text))
end

-- ================= COUNTERS =================
local function countPlayers() return #Players:GetPlayers() end
local function countPets()
    local f = workspace:FindFirstChild("Pets"); if not f then return 0 end
    return #f:GetChildren()
end
local function otherPlayers()
    local list = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player then table.insert(list, p) end
    end
    return list
end
local function allSubjects()
    local list = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Character then table.insert(list, p.Character) end
    end
    return list
end
local function petsOnServer()
    local f = workspace:FindFirstChild("Pets"); if not f then return {} end
    return f:GetChildren()
end

-- ================= API HELPERS =================
local API_ROOT = ReplicatedStorage:WaitForChild("API")
local function api(name) return API_ROOT:FindFirstChild(name) end

local function callAPI(name, args, fire)
    local node = api(name)
    if not node then say("API missing: " .. name, "bad"); return false end
    args = args or {}
    local ok, err = pcall(function()
        if fire then node:FireServer(unpack(args)) else node:InvokeServer(unpack(args)) end
    end)
    if not ok then say("Call failed " .. name .. ": " .. tostring(err), "bad") end
    return ok
end

-- ============ EXACT SPY SHAPES FOR HOLD / EJECT ============
-- HoldBaby: local args = { [1] = <Char> }; AdoptAPI/HoldBaby:InvokeServer(unpack(args))
local function holdBaby(char)
    local node = api("AdoptAPI/HoldBaby")
    if not node then say("AdoptAPI/HoldBaby missing", "bad"); return false end
    local args = { [1] = char }
    return pcall(function() node:InvokeServer(unpack(args)) end)
end

-- EjectBaby: local args = { [1] = <Char> }; AdoptAPI/EjectBaby:FireServer(unpack(args))
local function ejectBaby(char)
    local node = api("AdoptAPI/EjectBaby")
    if not node then say("AdoptAPI/EjectBaby missing", "bad"); return false end
    local args = { [1] = char }
    return pcall(function() node:FireServer(unpack(args)) end)
end

-- ============ FAMILY INVITES (A / B) ============
local function inviteMethodA(name)
    if type(name) ~= "string" or name == "" then return false end
    local target = game:GetService("Players"):FindFirstChild(name)
    if not target then return false end
    local node = game:GetService("ReplicatedStorage").API:FindFirstChild("FamilyAPI/InvitePlayer")
    if not node then return false end
    return pcall(function() node:InvokeServer(unpack({ [1] = target })) end)
end
local function inviteMethodB(name)
    if type(name) ~= "string" or name == "" then return false end
    local target = game:GetService("Players")[name]
    if not target then return false end
    local node = game:GetService("ReplicatedStorage").API:FindFirstChild("FamilyAPI/InvitePlayer")
    if not node then return false end
    return pcall(function() node:InvokeServer(unpack({ [1] = target })) end)
end

-- ==================================================================
-- DYNAMIC FURNITURE DISCOVERY
-- ==================================================================
local function ownerFromFolder(n) return (string.match(n, "^([^/]+)/") or n) end
local function folderIdFromFolder(n) return (string.match(n, "f%-%d+") or n) end

local function resolveActivation(model)
    if not model or not model:IsA("Model") then return nil end
    local useBlocks = model:FindFirstChild("UseBlocks")
    if useBlocks then
        for _, name in ipairs({ "Seat1", "UseBlock" }) do
            local part = useBlocks:FindFirstChild(name)
            if part and part:IsA("BasePart") then
                return { partName = name, cframe = part.CFrame, position = part.Position }
            end
        end
    end
    for _, name in ipairs({ "Seat1", "UseBlock" }) do
        local part = model:FindFirstChild(name)
        if part and part:IsA("BasePart") then
            return { partName = name, cframe = part.CFrame, position = part.Position }
        end
    end
    for _, d in ipairs(model:GetDescendants()) do
        if d:IsA("BasePart") then return { partName = d.Name, cframe = d.CFrame, position = d.Position } end
    end
    return nil
end

local function scanAllFurniture()
    local out = {}
    local hi = workspace:FindFirstChild("HouseInteriors"); if not hi then return out end
    local furniture = hi:FindFirstChild("furniture"); if not furniture then return out end
    for _, folder in ipairs(furniture:GetChildren()) do
        local owner = ownerFromFolder(folder.Name)
        local folderId = folderIdFromFolder(folder.Name)
        for _, child in ipairs(folder:GetChildren()) do
            if child:IsA("Model") then
                local act = resolveActivation(child)
                if act then
                    table.insert(out, {
                        owner = owner, folderName = folder.Name, folderId = folderId,
                        modelName = child.Name, model = child,
                        partName = act.partName, cframe = act.cframe, position = act.position,
                    })
                end
            end
        end
    end
    return out
end

-- All furniture matching a need for a given owner.
local function allFurnitureForNeed(need, ownerName)
    local wanted = NEED_MODELS[need]; if not wanted then return {} end
    local wantSet = {}
    for _, n in ipairs(wanted) do wantSet[string.lower(n)] = true end
    local out = {}
    for _, f in ipairs(scanAllFurniture()) do
        if wantSet[string.lower(f.modelName)] and (not ownerName or f.owner == ownerName) then
            table.insert(out, f)
        end
    end
    return out
end

-- ==================================================================
-- FAMILY BUILDER
-- ==================================================================
local FamilyMode = false

local function ensureFamily()
    local node = api("FamilyAPI/CreateFamily")
    if not node then say("FamilyAPI/CreateFamily missing", "bad"); return false end
    local ok = pcall(function() node:InvokeServer() end)
    if not ok then say("CreateFamily failed — assuming already in a family, continuing", "warn")
    else say("Family created", "ok") end
    task.wait(FAMILY_SETTLE)
    return true
end

local function inviteAll()
    local targets = otherPlayers()
    if #targets == 0 then say("No other players to invite", "warn"); return end
    setGoal("Inviting " .. #targets .. " player(s)")
    local half = math.floor(#targets / 2)
    for i, p in ipairs(targets) do
        if not FamilyMode then break end
        if p.Parent ~= Players then say("Skipping " .. p.Name .. " (left server)", "warn"); continue end
        local useA = (i <= half) or (half == 0 and i == 1)
        setGoal("Inviting " .. #targets, { p.Name .. (useA and " (A)" or " (B)") })
        local ok = useA and inviteMethodA(p.Name) or inviteMethodB(p.Name)
        if ok then say("Invite (" .. (useA and "A" or "B") .. ") -> " .. p.Name, "ok")
        else
            task.wait(1.5)
            local ok2 = useA and inviteMethodB(p.Name) or inviteMethodA(p.Name)
            if ok2 then say("Invite (retry) -> " .. p.Name, "ok")
            else say("Invite FAILED (A+B) -> " .. p.Name, "bad") end
        end
        task.wait(INVITE_DELAY)
    end
    say("Family invite pass finished", "ok")
end

local function createFamilyAndInvite()
    if FamilyMode then return end
    FamilyMode = true
    ensureFamily()
    if FamilyMode then inviteAll() end
    FamilyMode = false
end

-- ==================================================================
-- PARALLEL NEEDS LOOP
-- ==================================================================
local TasksMode = false

-- occupancy: folderName -> { owner, partName, modelName }
local occupancy = {}
local function claimFurniture(f)
    if occupancy[f.folderName] then return false end
    occupancy[f.folderName] = { owner = f.owner, partName = f.partName, modelName = f.modelName }
    return true
end
local function releaseFurniture(f) occupancy[f.folderName] = nil end

-- Pick a free furniture slot for need owned by `ownerName` (falls back to any owner).
local function pickFreeFurniture(need, ownerName)
    local list = allFurnitureForNeed(need, ownerName)
    if #list == 0 then list = allFurnitureForNeed(need) end
    for _, f in ipairs(list) do
        if claimFurniture(f) then return f end
    end
    return nil
end

-- Per-subject dwell; this coroutine holds the slot while the loop works on others.
local function dwell(seconds, label)
    local t = 0
    while t < seconds and TasksMode do
        setNow(string.format("%s — %d/%ds", label, t, seconds))
        task.wait(1); t += 1
    end
end

-- Fire one baby-use
local function fireBabyFurniture(char, folderId, partName)
    local node = api("InteractablesAPI/MakeBabyUseFurniture")
    if not node then return false end
    return pcall(function() node:FireServer(unpack({ [1] = char, [2] = folderId, [3] = partName })) end)
end

-- Pet activation (unchanged from original COCOON shape).
local function activatePetFurniture(pet, f)
    return callAPI("HousingAPI/ActivateFurniture",
        { player, f.folderId, f.partName, { cframe = f.cframe }, pet })
end

-- One subject's full sequence, run in its own coroutine so several can overlap.
local function runSubject(char, needs, kind)
    if not char or not char.Parent then return end
    say(kind .. ": " .. (char.Name or "?") .. " started", "info")
    if not holdBaby(char) then say("HoldBaby failed for " .. char.Name, "bad"); return end
    task.wait(1)

    for _, need in ipairs(needs) do
        if not TasksMode then break end
        local f = pickFreeFurniture(need, char.Name)
        if not f then
            say("No free furniture for " .. need .. " (" .. char.Name .. ")", "warn")
        else
            setGoal(char.Name .. " -> " .. need .. " [" .. f.folderId .. "." .. f.partName .. "]", { f.modelName })
            if kind == "Baby" then fireBabyFurniture(char, f.folderId, f.partName)
            else activatePetFurniture(char, f) end
            dwell(FURNITURE_DWELL, char.Name .. " " .. need)
            releaseFurniture(f)
            task.wait(BETWEEN_FURNITURE)
        end
    end

    ejectBaby(char)
    say(kind .. ": " .. (char.Name or "?") .. " done", "ok")
    task.wait(BETWEEN_SUBJECTS)
end

-- Build the ordered subject queue (babies first, then pets) and run with a
-- small concurrency window so second subject is placed while first dwells.
local function startAllTasks()
    if TasksMode then return end
    TasksMode = true
    occupancy = {}

    -- Build job list
    local jobs = {}
    for _, c in ipairs(allSubjects()) do table.insert(jobs, { char = c, needs = BABY_NEEDS, kind = "Baby" }) end
    for _, pet in ipairs(petsOnServer()) do table.insert(jobs, { char = pet, needs = PET_NEEDS, kind = "Pet" }) end
    say("Jobs queued: " .. #jobs, "info")

    -- Sliding window of MAX_PARALLEL
    local i = 1
    local running = 0
    while TasksMode and (i <= #jobs or running > 0) do
        while TasksMode and i <= #jobs and running < MAX_PARALLEL do
            local job = jobs[i]; i += 1; running += 1
            task.spawn(function()
                pcall(runSubject, job.char, job.needs, job.kind)
                running -= 1
            end)
            task.wait(0.2)
        end
        task.wait(0.5)
    end

    say("Task loop finished", "ok")
    TasksMode = false
end

