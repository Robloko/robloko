}

-- ================= STATUS / LOG =================
local ui = {}
local uiLog = nil
local status = { now = "Ready", goal = "Pick an action", queue = {} }

local function renderStatus()
    if ui.now then
        pcall(function()
            ui.now.Text  = status.now
            ui.goal.Text = status.goal
            ui.queue.Text = #status.queue > 0 and ("Next: " .. table.concat(status.queue, "\n         ")) or ""
        end)
    end
end
local function setGoal(t, q) status.goal = t or ""; status.queue = q or {}; renderStatus() end
local function setNow(t) status.now = t or ""; renderStatus() end
local function say(text, tone)
    setNow(text)
    if uiLog then pcall(uiLog, tone or "info", text) end
    print("[COCOON] " .. tostring(text))
end

-- ================= COUNTERS =================
local function countPlayers() return #Players:GetPlayers() end
local function countPets()
    local f = workspace:FindFirstChild("Pets"); if not f then return 0 end
    return #f:GetChildren()
end
local function otherPlayers()
    local list = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player then table.insert(list, p) end
    end
    return list
end
local function allSubjects()
    local list = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Character then table.insert(list, p.Character) end
    end
    return list
end
local function petsOnServer()
    local f = workspace:FindFirstChild("Pets"); if not f then return {} end
    return f:GetChildren()
end

-- ================= API HELPERS =================
local API_ROOT = ReplicatedStorage:WaitForChild("API")
local function api(name) return API_ROOT:FindFirstChild(name) end

local function callAPI(name, args, fire)
    local node = api(name)
    if not node then say("API missing: " .. name, "bad"); return false end
    args = args or {}
    local ok, err = pcall(function()
        if fire then node:FireServer(unpack(args)) else node:InvokeServer(unpack(args)) end
    end)
    if not ok then say("Call failed " .. name .. ": " .. tostring(err), "bad") end
    return ok
end

-- ============ Invites (A: FindFirstChild, B: Players[name]) ============
local function inviteMethodA(name)
    if type(name) ~= "string" or name == "" then return false end
    local target = game:GetService("Players"):FindFirstChild(name)
    if not target then return false end
    local args = { [1] = target }
    local node = game:GetService("ReplicatedStorage").API:FindFirstChild("FamilyAPI/InvitePlayer")
    if not node then return false end
    return pcall(function() node:InvokeServer(unpack(args)) end)
end
local function inviteMethodB(name)
    if type(name) ~= "string" or name == "" then return false end
    local target = game:GetService("Players")[name]
    if not target then return false end
    local args = { [1] = target }
    local node = game:GetService("ReplicatedStorage").API:FindFirstChild("FamilyAPI/InvitePlayer")
    if not node then return false end
    return pcall(function() node:InvokeServer(unpack(args)) end)
end

-- ==================================================================
-- DYNAMIC FURNITURE DISCOVERY
-- ==================================================================
local function ownerFromFolder(folderName) return (string.match(folderName, "^([^/]+)/") or folderName) end
local function folderIdFromFolder(folderName) return (string.match(folderName, "f%-%d+") or folderName) end

local function resolveActivation(model)
    if not model or not model:IsA("Model") then return nil end
    local useBlocks = model:FindFirstChild("UseBlocks")
    if useBlocks then
        for _, name in ipairs({ "Seat1", "UseBlock" }) do
            local part = useBlocks:FindFirstChild(name)
            if part and part:IsA("BasePart") then
                return { partName = name, cframe = part.CFrame, position = part.Position }
            end
        end
    end
    for _, name in ipairs({ "Seat1", "UseBlock" }) do
        local part = model:FindFirstChild(name)
        if part and part:IsA("BasePart") then
            return { partName = name, cframe = part.CFrame, position = part.Position }
        end
    end
    for _, d in ipairs(model:GetDescendants()) do
        if d:IsA("BasePart") then
            return { partName = d.Name, cframe = d.CFrame, position = d.Position }
        end
    end
    return nil
end

local function scanAllFurniture()
    local out = {}
    local hi = workspace:FindFirstChild("HouseInteriors"); if not hi then return out end
    local furniture = hi:FindFirstChild("furniture"); if not furniture then return out end
    for _, folder in ipairs(furniture:GetChildren()) do
        local owner = ownerFromFolder(folder.Name)
        local folderId = folderIdFromFolder(folder.Name)
        for _, child in ipairs(folder:GetChildren()) do
            if child:IsA("Model") then
                local act = resolveActivation(child)
                if act then
                    table.insert(out, {
                        owner = owner, folderName = folder.Name, folderId = folderId,
                        modelName = child.Name, model = child,
                        partName = act.partName, cframe = act.cframe, position = act.position,
                    })
                end
            end
        end
    end
    return out
end

local function findFurnitureForNeed(need, ownerName)
    local wanted = NEED_MODELS[need]; if not wanted then return nil end
    local wantedSet = {}; for _, n in ipairs(wanted) do wantedSet[string.lower(n)] = true end
    local all = scanAllFurniture()
    local primary = {}
    for _, f in ipairs(all) do
        if wantedSet[string.lower(f.modelName)] then
            if not ownerName or f.owner == ownerName then table.insert(primary, f) end
        end
    end
    if #primary > 0 then return primary[1] end
    for _, f in ipairs(all) do
        if wantedSet[string.lower(f.modelName)] then return f end
    end
    return nil
end

-- ==================================================================
-- FAMILY BUILDER
-- ==================================================================
local FamilyMode = false

local function ensureFamily()
    local node = api("FamilyAPI/CreateFamily")
    if not node then return false end
    local ok = pcall(function() node:InvokeServer() end)
    if ok then say("Family created", "ok") else say("CreateFamily failed — continuing", "warn") end
    task.wait(FAMILY_SETTLE); return true
end

local function inviteAll()
    local targets = otherPlayers()
    if #targets == 0 then say("No other players to invite", "warn"); return end
    setGoal("Inviting " .. #targets)
    local half = math.floor(#targets / 2)
    for i, p in ipairs(targets) do
        if not FamilyMode then break end
        if p.Parent == Players then
            local useA = (i <= half) or (half == 0 and i == 1)
            local ok = useA and inviteMethodA(p.Name) or inviteMethodB(p.Name)
            if not ok then task.wait(1.5); ok = useA and inviteMethodB(p.Name) or inviteMethodA(p.Name) end
            say("Invite -> " .. p.Name .. (ok and " ok" or " FAILED"), ok and "ok" or "bad")
        end
        task.wait(INVITE_DELAY)
    end
end

local function createFamilyAndInvite()
    if FamilyMode then return end
    FamilyMode = true
    ensureFamily()
    if FamilyMode then inviteAll() end
    FamilyMode = false
end

-- ==================================================================
-- PIPELINED NEEDS LOOP
-- ==================================================================
-- Strategy:
--   1. Hold subject A, place it on its first need, start dwell
--   2. While A is dwelling, HOLD subject B and place it on its first need
--   3. Let both dwell in parallel; when A's timer ends, place it on its next
--      need (or eject it) and slot the next subject into the freed slot
--   4. Result: two subjects are always in-flight, so dwell time of A overlaps
--      with B being held/placed.

local TasksMode = false

-- Hold / eject use EXACT spy shapes:
--   HoldBaby:InvokeServer(unpack({ [1] = Char }))
--   EjectBaby:FireServer(unpack({ [1] = Char }))
local function holdSubject(char)
    setNow("Hold: " .. (char.Name or "?"))
    local node = api("AdoptAPI/HoldBaby")
    if not node then return false end
    local args = { [1] = char }
    return pcall(function() node:InvokeServer(unpack(args)) end)
end
local function ejectSubject(char)
    setNow("Eject: " .. (char.Name or "?"))
    local node = api("AdoptAPI/EjectBaby")
    if not node then return false end
    local args = { [1] = char }
    return pcall(function() node:FireServer(unpack(args)) end)
end

-- Fire baby furniture with exact spy shape
local function fireBabyFurniture(char, folderId, partName)
    local node = api("InteractablesAPI/MakeBabyUseFurniture")
    if not node then return false end
    local args = { [1] = char, [2] = folderId, [3] = partName }
    return pcall(function() node:FireServer(unpack(args)) end)
end

-- Pet furniture via HousingAPI/ActivateFurniture
local function firePetFurniture(pet, folderId, partName, cframe)
    local node = api("HousingAPI/ActivateFurniture")
    if not node then return false end
    local args = { player, folderId, partName, { cframe = cframe }, pet }
    return pcall(function() node:InvokeServer(unpack(args)) end)
end

-- A subject job is a coroutine per subject, running its need list serially.
-- The pipeline staggers "start" of the next subject by BETWEEN_SUBJECTS
-- so we always have ~2 subjects in flight.

local function runSubject(char, needs, fire, isPet)
    if not char or not char.Parent then return end
    say((isPet and "Pet: " or "Baby: ") .. (char.Name or "?"), "info")
    if not holdSubject(char) then
        say("Hold failed for " .. (char.Name or "?"), "bad")
        return
    end
    task.wait(1)

    for idx, need in ipairs(needs) do
        if not TasksMode then break end
        local f = findFurnitureForNeed(need, char.Name) or findFurnitureForNeed(need)
        if not f then
            say("No furniture for " .. need .. " (" .. (char.Name or "?") .. ")", "warn")
        else
            setGoal((char.Name or "?") .. " -> " .. need .. " [" .. f.folderId .. "." .. f.partName .. "]", { f.modelName })
            if isPet then
                firePetFurniture(char, f.folderId, f.partName, f.cframe)
            else
                fire(f, char)
            end
            -- dwell, abortable by TasksMode
            local t = 0
            while t < FURNITURE_DWELL and TasksMode do
                setNow(string.format("%s %s — %d/%ds", (char.Name or "?"), need, t, FURNITURE_DWELL))
                task.wait(1); t += 1
            end
            task.wait(BETWEEN_FURNITURE)
        end
    end

    if TasksMode then ejectSubject(char) end
    task.wait(0.8)
end

local function startAllTasks()
    if TasksMode then return end
    TasksMode = true

    -- Combined work queue: babies first, then pets
    local jobs = {}
    for _, c in ipairs(allSubjects()) do
        table.insert(jobs, { char = c, needs = BABY_NEEDS, isPet = false })
    end
    for _, pet in ipairs(petsOnServer()) do
        table.insert(jobs, { char = pet, needs = PET_NEEDS, isPet = true })
    end

    say("Jobs queued: " .. #jobs, "info")

    -- Pipeline: launch up to 2 subjects at once.
    local active = {}
    local function launch(job)
        local co = coroutine.create(function()
            runSubject(
                job.char,
                job.needs,
                function(f, char) fireBabyFurniture(char, f.folderId, f.partName) end,
                job.isPet
            )
        end)
        table.insert(active, co)
        task.spawn(function() coroutine.resume(co) end)
    end

    local i = 1
    while i <= #jobs and TasksMode do
        -- top off to 2 active
        while #active < 2 and i <= #jobs and TasksMode do
            launch(jobs[i]); i += 1
            if #active > 1 then task.wait(BETWEEN_SUBJECTS) end
        end

        -- reap finished coroutines
        local newActive = {}
        for _, co in ipairs(active) do
            if coroutine.status(co) ~= "dead" then
                table.insert(newActive, co)
            else
                task.wait(BETWEEN_SUBJECTS)
            end
        end
        active = newActive
        task.wait(0.5)
    end

    -- wait for remaining
    while #active > 0 and TasksMode do
        local newActive = {}
        for _, co in ipairs(active) do
            if coroutine.status(co) ~= "dead" then table.insert(newActive, co) else task.wait(BETWEEN_SUBJECTS) end
        end
        active = newActive
        task.wait(0.5)
    end

    say("Task loop finished", "ok")
    TasksMode = false
end

