-- Need order per subject type (first two used for babies, all used for pets)
local BABY_NEEDS = { "sleep", "bored", "bath" }
local PET_NEEDS  = { "sleep", "bored", "bath", "dirty", "food", "drink", "toilet" }

-- Furniture model names per need (used by discovery filter)
local NEED_MODELS = {
    sleep  = { "BasicBed",  "ModernBed", "Bed" },
    bored  = { "Piano",     "ToyBox",    "BallPit" },
    bath   = { "ModernShower", "CheapPetBathtub", "Bathtub" },
    dirty  = { "CheapPetBathtub", "Bathtub" },
    food   = { "PetFoodBowl", "FoodBowl", "BasicFoodBowl" },
