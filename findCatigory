-- Services
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

-- Player
local player = Players.LocalPlayer

-- Print all categories found in the inventory
local function printInventoryCategories()
    print("🔍 SCANNING INVENTORY CATEGORIES")
    print("=================================")

    local success, data = pcall(function()
        local clientData = require(ReplicatedStorage.ClientModules.Core.ClientData)
        return clientData.get_data()[player.Name]
    end)

    if not success or not data then
        print("❌ Failed to get player data")
        return
    end

    if not data.inventory then
        print("❌ No inventory found")
        return
    end

    -- Collect all category names
    local categories = {}
    for categoryName, categoryData in pairs(data.inventory) do
        local count = 0
        if type(categoryData) == "table" then
            for _ in pairs(categoryData) do
                count = count + 1
            end
        end
        table.insert(categories, { name = categoryName, count = count })
    end

    table.sort(categories, function(a, b) return a.count > b.count end)

    if #categories == 0 then
        print("❌ Inventory is empty")
        return
    end

    print("📂 Found " .. #categories .. " categories:")
    print("")
    for i, category in ipairs(categories) do
        print(string.format("%d. %s — %d item(s)", i, category.name, category.count))
    end
    print("")
    print("=================================")
end

-- Run it
printInventoryCategories()
