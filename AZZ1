-- ================= STATUS / LOG =================
local ui = {}
local uiLog = nil
local status = { now = "Ready", goal = "Pick an action", queue = {} }

local function renderStatus()
    if ui.now then
        pcall(function()
            ui.now.Text = status.now
            ui.goal.Text = status.goal
            ui.queue.Text = #status.queue > 0 and ("Next: " .. table.concat(status.queue, "\n         ")) or ""
        end)
    end
end
local function setGoal(t, q) status.goal = t or ""; status.queue = q or {}; renderStatus() end
local function setNow(t) status.now = t or ""; renderStatus() end
local function say(text, tone)
    setNow(text); if uiLog then pcall(uiLog, tone or "info", text) end
    print("[COCOON] " .. tostring(text))
end

-- ================= COUNTERS =================
local function countPlayers() local n=0; for _ in Players:GetPlayers() do n+=1 end; return n end
local function countPets()
    local f = workspace:FindFirstChild("Pets"); if not f then return 0 end
    local n=0; for _ in f:GetChildren() do n+=1 end; return n
end
local function otherPlayers()
    local l = {}; for _,p in ipairs(Players:GetPlayers()) do if p~=player then table.insert(l,p) end end; return l
end
local function petsOnServer()
    local f = workspace:FindFirstChild("Pets"); if not f then return {} end; return f:GetChildren()
end

-- ================= VALIDATION (loosened) =================
local function validPet(pet)
    if not pet or not pet.Parent then return false end
    local folder = workspace:FindFirstChild("Pets")
    return folder and pet:IsDescendantOf(folder) or false
end
local function validBaby(char)
    -- Accept a character that exists and belongs to a current player.
    -- Don't require Humanoid yet: it may stream in shortly; retries handle it.
    if not char or not char.Parent then return false end
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Character == char then return true end
    end
    return false
end
local function liveBabies()
    local list = {}
    for _, p in ipairs(otherPlayers()) do
        local char = p.Character
        if char and char.Parent and validBaby(char) then
            table.insert(list, char)
        end
    end
    return list
end

-- ================= API HELPERS =================
local function api(name) return ReplicatedStorage:WaitForChild("API"):FindFirstChild(name) end
local function callAPI(name, args, fire)
    local node = api(name); if not node then say("API missing: "..name,"bad"); return false end
    local ok, err = pcall(function()
        if fire then node:FireServer(unpack(args)) else node:InvokeServer(unpack(args)) end
    end)
    if not ok then say("Call failed "..name..": "..tostring(err),"bad") end
    return ok
end

-- ================= CARRY TOKEN =================
local carrying = false
local function acquireCarry()
    while TasksMode and carrying do task.wait(0.15) end
    if not TasksMode then return false end
    carrying = true; return true
end
local function releaseCarry() carrying = false end

-- ================= PIECE RUNNERS =================
local function runPetPiece(pet, furn)
    if not validPet(pet) then return false end
    if not acquireCarry() then return false end
    setNow("Hold PET "..pet.Name)
    if not callAPI("AdoptAPI/HoldBaby", { pet }) then releaseCarry(); return false end
    task.wait(1)
    if not validPet(pet) then releaseCarry(); return false end
    callAPI("HousingAPI/ActivateFurniture",
        { player, furn.id, furn.mode, { cframe = furn.cframe }, pet })
    local t = 0
    while t < FURNITURE_DWELL and TasksMode and validPet(pet) do
        setNow(string.format("PET %s on %s — %d/%ds", pet.Name, furn.label, t, FURNITURE_DWELL))
        task.wait(1); t += 1
    end
    if validPet(pet) then callAPI("AdoptAPI/EjectBaby", { pet }, true) end
    task.wait(0.8); releaseCarry()
    return true
end

local function runBabyPiece(char, furn)
    if not validBaby(char) then return false end
    if not acquireCarry() then return false end
    setNow("Hold BABY "..char.Name)
    if not callAPI("AdoptAPI/HoldBaby", { char }) then releaseCarry(); return false end
    task.wait(1)
    if not validBaby(char) then releaseCarry(); return false end
    callAPI("InteractablesAPI/MakeBabyUseFurniture", { char, furn.id, furn.mode }, true)
    local t = 0
    while t < FURNITURE_DWELL and TasksMode and validBaby(char) do
        setNow(string.format("BABY %s on %s — %d/%ds", char.Name, furn.label, t, FURNITURE_DWELL))
        task.wait(1); t += 1
    end
    if validBaby(char) then callAPI("AdoptAPI/EjectBaby", { char }, true) end
    task.wait(0.8); releaseCarry()
    return true
end

-- ================= FAMILY BUTTON =================
local FamilyMode = false
local function createFamilyAndInvite()
    FamilyMode = true
    say("Creating family...", "info")
    if not callAPI("FamilyAPI/CreateFamily", {}) then
        say("Family creation failed (already in family?)", "bad"); FamilyMode = false; return
    end
    say("Family created. Inviting everyone...", "ok")
    task.wait(1)
    local targets = otherPlayers()
    setGoal("Inviting ".. #targets .." player(s)")
    for _, p in ipairs(targets) do
        if not FamilyMode then break end
        if p and p.Parent then
            setGoal("Inviting ".. #targets, { p.Name })
            callAPI("FamilyAPI/InvitePlayer", { p })
            say("Family invite -> "..p.Name, "ok")
        end
        task.wait(INVITE_DELAY)
    end
    say("Family invite pass finished", "ok")
    FamilyMode = false
end

-- ================= CONTINUOUS WORKERS =================
local TasksMode = false

-- Track subjects we've fully processed to avoid re-looping the same one
-- non-stop. Once everyone in the live list has been done, we clear the set
-- and start a new round. Skipped subjects are retried next round.
local doneBabies, donePets = {}, {}

local function babyWorker()
    while TasksMode do
        local babies = liveBabies()
        local pending = {}
        for _, char in ipairs(babies) do
            if not doneBabies[char] then table.insert(pending, char) end
        end
        if #pending == 0 then
            -- finished a full round of everyone currently here; start over
            doneBabies = {}
            say("Baby worker: new round (".. #babies .." player(s))", "info")
            if #babies == 0 then task.wait(IDLE_GAP); continue end
        else
            local char = pending[1]
            say("Baby -> ".. char.Name, "info")
            for _, f in ipairs(BABY_FURNITURE) do
                if not TasksMode then return end
                local ok = runBabyPiece(char, f)
                if not ok then break end
                task.wait(BETWEEN_PIECES)
            end
            -- only mark done if the subject still exists at the end
            if validBaby(char) then
                doneBabies[char] = true
            else
                say("Baby vanished, will retry next round: "..tostring(char.Name), "warn")
            end
            task.wait(BETWEEN_SUBJECTS)
        end
    end
end

local function petWorker()
    while TasksMode do
        local pets = petsOnServer()
        local pending = {}
        for _, pet in ipairs(pets) do
            if not donePets[pet] then table.insert(pending, pet) end
        end
        if #pending == 0 then
            donePets = {}
            say("Pet worker: new round (".. #pets .." pet(s))", "info")
            if #pets == 0 then task.wait(IDLE_GAP); continue end
        else
            local pet = pending[1]
            say("Pet -> ".. pet.Name, "info")
            for _, f in ipairs(PET_FURNITURE) do
                if not TasksMode then return end
                local ok = runPetPiece(pet, f)
                if not ok then break end
                task.wait(BETWEEN_PIECES)
            end
            if validPet(pet) then
                donePets[pet] = true
            else
                say("Pet vanished, will retry next round: "..tostring(pet.Name), "warn")
            end
            task.wait(BETWEEN_SUBJECTS)
        end
    end
end

local function startAllTasks()
    TasksMode = true
    doneBabies, donePets = {}, {}
    say("Parallel farm running (continuous).", "ok")
    task.spawn(function()
        local ok, err = pcall(babyWorker)
        if not ok then say("Baby worker error: "..tostring(err), "bad") end
    end)
    task.spawn(function()
        local ok, err = pcall(petWorker)
        if not ok then say("Pet worker error: "..tostring(err), "bad") end
    end)
end

