-- ================= STATUS / LOG =================
local ui = {}
local uiLog = nil
local status = { now = "Ready", goal = "Pick an action", queue = {} }

local function renderStatus()
    if ui.now then
        pcall(function()
            ui.now.Text = status.now
            ui.goal.Text = status.goal
            ui.queue.Text = #status.queue > 0 and ("Next: " .. table.concat(status.queue, "\n         ")) or ""
        end)
    end
end
local function setGoal(t, q) status.goal = t or ""; status.queue = q or {}; renderStatus() end
local function setNow(t) status.now = t or ""; renderStatus() end
local function say(text, tone)
    setNow(text); if uiLog then pcall(uiLog, tone or "info", text) end
    print("[COCOON] " .. tostring(text))
end

-- ================= COUNTERS =================
local function countPlayers() local n=0; for _ in Players:GetPlayers() do n+=1 end; return n end
local function countPets()
    local f = workspace:FindFirstChild("Pets"); if not f then return 0 end
    local n=0; for _ in f:GetChildren() do n+=1 end; return n
end
local function otherPlayers()
    local l = {}; for _,p in ipairs(Players:GetPlayers()) do if p~=player then table.insert(l,p) end end; return l
end
local function petsOnServer()
    local f = workspace:FindFirstChild("Pets"); if not f then return {} end; return f:GetChildren()
end

-- ================= API HELPERS =================
local function api(name) return ReplicatedStorage:WaitForChild("API"):FindFirstChild(name) end
local function callAPI(name, args, fire)
    local node = api(name); if not node then say("API missing: "..name,"bad"); return false end
    local ok, err = pcall(function()
        if fire then node:FireServer(unpack(args)) else node:InvokeServer(unpack(args)) end
    end)
    if not ok then say("Call failed "..name..": "..tostring(err),"bad") end
    return ok
end

-- ================= CARRY TOKEN =================
-- The game only allows holding ONE object at a time. This lock makes
-- the two workers take turns holding so their 20s dwells interleave
-- but never collide.
local carrying = false
local function acquireCarry() while TasksMode and carrying do task.wait(0.15) end; if not TasksMode then return false end; carrying = true; return true end
local function releaseCarry() carrying = false end

local function holdAndPlacePet(pet, furn)
    if not acquireCarry() then return false end
    setNow(string.format("PET %s → %s", pet.Name, furn.label))
    callAPI("AdoptAPI/HoldBaby", { pet })
    task.wait(1)
    callAPI("HousingAPI/ActivateFurniture",
        { player, furn.id, furn.mode, { cframe = furn.cframe }, pet })
    local t = 0
    while t < FURNITURE_DWELL and TasksMode do
        setNow(string.format("PET %s on %s — %d/%ds", pet.Name, furn.label, t, FURNITURE_DWELL))
        task.wait(1); t += 1
    end
    callAPI("AdoptAPI/EjectBaby", { pet }, true)
    task.wait(0.8)
    releaseCarry()
    return TasksMode
end

local function holdAndPlaceBaby(char, furn)
    if not acquireCarry() then return false end
    setNow(string.format("BABY %s → %s", char.Name, furn.label))
    callAPI("AdoptAPI/HoldBaby", { char })
    task.wait(1)
    callAPI("InteractablesAPI/MakeBabyUseFurniture", { char, furn.id, furn.mode }, true)
    local t = 0
    while t < FURNITURE_DWELL and TasksMode do
        setNow(string.format("BABY %s on %s — %d/%ds", char.Name, furn.label, t, FURNITURE_DWELL))
        task.wait(1); t += 1
    end
    callAPI("AdoptAPI/EjectBaby", { char }, true)
    task.wait(0.8)
    releaseCarry()
    return TasksMode
end

-- ================= FAMILY BUTTON =================
local FamilyMode = false
local function createFamilyAndInvite()
    FamilyMode = true
    say("Creating family...", "info")
    if not callAPI("FamilyAPI/CreateFamily", {}) then
        say("Family creation failed (already in family?)", "bad"); FamilyMode = false; return
    end
    say("Family created. Inviting everyone...", "ok")
    task.wait(1)
    local targets = otherPlayers()
    setGoal("Inviting ".. #targets .." player(s)")
    for _, p in ipairs(targets) do
        if not FamilyMode then break end
        setGoal("Inviting ".. #targets, { p.Name })
        callAPI("FamilyAPI/InvitePlayer", { p })
        say("Family invite -> "..p.Name, "ok")
        task.wait(INVITE_DELAY)
    end
    say("Family invite pass finished", "ok")
    FamilyMode = false
end

-- ================= PARALLEL WORKERS =================
local TasksMode = false

local function babyWorker()
    local babies = otherPlayers()
    say("Baby worker: ".. #babies .." player(s)", "info")
    for _, p in ipairs(babies) do
        if not TasksMode then return end
        local char = p.Character
        if char and char.Parent then
            for _, f in ipairs(BABY_FURNITURE) do
                if not TasksMode then return end
                holdAndPlaceBaby(char, f)
                task.wait(BETWEEN_PIECES)
            end
        else
            say("No character for "..p.Name, "warn")
        end
        task.wait(BETWEEN_SUBJECTS)
    end
end

local function petWorker()
    local pets = petsOnServer()
    say("Pet worker: ".. #pets .." pet(s)", "info")
    for _, pet in ipairs(pets) do
        if not TasksMode then return end
        if pet and pet.Parent then
            for _, f in ipairs(PET_FURNITURE) do
                if not TasksMode then return end
                holdAndPlacePet(pet, f)
                task.wait(BETWEEN_PIECES)
            end
        end
        task.wait(BETWEEN_SUBJECTS)
    end
end

local function startAllTasks()
    TasksMode = true
    for pass = 1, MAX_TASK_PASSES do
        if not TasksMode then break end
        setGoal("Parallel pass "..pass.."/"..MAX_TASK_PASSES)
        -- Both workers run in their own threads; the carry token serializes holds.
        local doneBaby, donePet = false, false
        task.spawn(function() babyWorker(); doneBaby = true end)
        task.spawn(function() petWorker();  donePet  = true end)
        while TasksMode and not (doneBaby and donePet) do
            setNow("Interleaving baby + pet furniture tasks...")
            task.wait(0.5)
        end
        if pass < MAX_TASK_PASSES then task.wait(3) end
    end
    say("Parallel task loop finished", "ok")
    TasksMode = false
    carrying = false
end

