-- ================= CONFIG =================
local INVITE_DELAY       = 1.0
local FURNITURE_DWELL    = 20
local BETWEEN_PIECES     = 0.8
local BETWEEN_SUBJECTS   = 1.2
local RETRY_GAP          = 3       -- seconds before re-attempting a skipped subject
local IDLE_GAP           = 4       -- seconds between rescans when nothing left

local PET_FURNITURE = {
    { id = "f-5",  mode = "UseBlock", cframe = CFrame.new(39.4566, 4000.7026, -9008.4346) * CFrame.Angles(-3.1415927, 0, -3.1415927), label = "dirty" },
