-- ================= TASK RUNNERS FROM THE FARM =================
-- Instead of COCOON's own hold/place/eject, delegate to the farm's task functions.
-- The farm already implements:
--   Tasks.pet_me.run(ctx, group)           - petting
--   Tasks.feed.run(ctx, group)             - hungry / thirsty for pet AND baby
--   Tasks.furniture.run(ctx, group)        - bed / shower / toilet (pet + baby)
--   Tasks.location.run(ctx, group)         - salon, school, pizza, camping, beach, bored
--   Tasks.play.run(ctx, group)             - play
--   Tasks.mystery.run(ctx, group)          - mystery cards
--   Tasks.walk.run / Tasks.ride.run        - walk / ride
--   EventTasks.*                           - ghost gallery, hauntlet, spotlight, shoebill, skelicorn, ...
--   HouseTasks.*                           - lure box, mannequin setup/buy, auto pay
--   WhereBear.task                         - where bear
--
-- The farm's task manager builds a `ctx` for each run:
--   ctx = { logger, state, interaction, travel, petLocator, furniture, gameData,
--           farmConfig, minigame, spotlight, hauntlet, maid, waitUntil, phase, ... }
--
-- So COCOON needs a ctx that satisfies those. The farm already has all the dependencies
-- live in getgenv().AdoptMeFarm internals? No — they are closures. The clean way is to
-- have COCOON run INSIDE the farm's main() so it can reuse the same `import` and `ctx`
-- machinery. See the note at the top.

-- For a standalone COCOON, we build a minimal ctx ourselves from the public farm API:
local function makeContext(farmApi)
    local state = farmApi.State
    local logger = {
        info = function(_, cat, msg) say(("[%s] %s"):format(tostring(cat), tostring(msg)), "info") end,
        warn = function(_, cat, msg) say(("[%s] %s"):format(tostring(cat), tostring(msg)), "warn") end,
        success = function(_, cat, msg) say(("[%s] %s"):format(tostring(cat), tostring(msg)), "ok") end,
        debug = function() end,
        error = function(_, cat, msg) say(("[%s] %s"):format(tostring(cat), tostring(msg)), "bad") end,
    }
    local currentMaid = { jobs = {} }
    local function maidGive(job) table.insert(currentMaid.jobs, job) return job end
    local ctx = {
        logger = logger,
        state = state,
        maid = { Give = maidGive, Clean = function() end },
        gameData = nil, -- filled by caller
        petLocator = nil,
        furniture = nil,
        interaction = nil,
        travel = nil,
        farmConfig = farmApi.Config and farmApi.Config.Farm or {},
        minigame = nil,
        spotlight = nil,
        hauntlet = nil,
    }
    function ctx.waitUntil(predicate, seconds)
        local deadline = os.clock() + (tonumber(seconds) or 5)
        while os.clock() < deadline do
            if predicate() then return true end
            task.wait(0.2)
        end
        return false
    end
    function ctx.setWaiting() end
    function ctx.phase(text) say(text, "info") end
    function ctx.currentGroup(kind)
        -- read from the farm's live state
        local active = state:get("ailments.active", {})
        local group = nil
        for _, entry in ipairs(active) do
            if entry.kind == kind then
                group = group or { kind = kind, entries = {}, anyInProgress = false, maxRate = 0, oldest = math.huge }
                table.insert(group.entries, entry)
                if entry.owner == "pet" and not group.petEntry then group.petEntry = entry end
                if entry.inProgress then group.anyInProgress = true end
                group.maxRate = math.max(group.maxRate, entry.rate or 0)
                group.oldest = math.min(group.oldest, entry.createdAt or math.huge)
            end
        end
        return group
    end
    function ctx.findEntry(kind, owner, petUnique)
        for _, entry in ipairs(state:get("ailments.active", {}) or {}) do
            if entry.kind == kind and entry.owner == owner and (owner == "baby" or entry.petUnique == petUnique) then
                return entry
            end
        end
        return nil
    end
    function ctx.isKindGone(kind) return ctx.currentGroup(kind) == nil end
    function ctx.completedSince() return false end
    function ctx.kindCompletedSince() return false end
    return ctx
end

-- The farm's task runners need a real ctx. Build it once from the live farm internals
-- by asking the farm to expose them (add this to the farm's main() near `sharedEnvironment[GLOBAL_KEY] = api`):
--   api._internal = { import = import, interaction = interaction, travel = ..., petLocator = ...,
--                     furniture = ..., gameData = gameData, taskManager = taskManager,
--                     minigame = minigame, hauntlet = hauntlet, spotlight = spotlight }
-- COCOON then uses Farm._internal to call the exact same code the farm uses.
local internal = Farm._internal
if type(internal) ~= "table" then
    say("Farm must expose _internal (add `api._internal = {...}` in its main())", "bad")
    return
end

local TasksMod = internal.import("Game/Tasks")
local EventTasksMod = internal.import("Game/EventTasks")
local HouseTasksMod = internal.import("Game/HouseTasks")
local WhereBearMod = internal.import("Game/WhereBear")

-- Build a ctx that satisfies the farm's task runners
local function farmContext()
    local ctx = makeContext(Farm)
    ctx.interaction = internal.interaction
    ctx.travel = internal.travel
    ctx.petLocator = internal.petLocator
    ctx.furniture = internal.furniture
    ctx.gameData = internal.gameData
    ctx.minigame = internal.minigame
    ctx.spotlight = internal.spotlight
    ctx.hauntlet = internal.hauntlet
    ctx.state = Farm.State
    ctx.farmConfig = Farm.Config.Farm
    -- mirror the farm's own helpers so tasks see identical behavior
    local tm = internal.taskManager
    if tm then
        function ctx.findEntry(...) return tm:_group and tm:_group(...) end
    end
    return ctx
end

-- ================= BUTTON 2: RUN TASKS VIA THE FARM =================
local TasksMode = false
local queue = {}
local activeWorkers = 0
local passNumber, passDone, passTotal = 0, 0, 0

local function hold(obj)
    -- use the farm's pet model holder (HoldPet = AdoptAPI/HoldBaby)
    local ok = pcall(function()
        internal.interaction:send("HoldPet", obj)
    end)
    if not ok then callAPI("AdoptAPI/HoldBaby", { obj }) end
    task.wait(0.5)
end
local function eject(obj)
    if obj then
        local ok = pcall(function()
            internal.interaction:send("DropPet", obj)
        end)
        if not ok then callAPI("AdoptAPI/EjectBaby", { obj }, true) end
    end
    task.wait(EJECT_TIME)
end

local function ejectAllHeld() end -- the farm's task runners already release pets

-- Reuse the farm's own furniture task instead of hand-rolling the dwell loop.
local function runFurnitureTask(kind, entries)
    local ctx = farmContext()
    local group = { kind = kind, entries = entries, anyInProgress = false, maxRate = 0, oldest = math.huge }
    local taskDef = TasksMod.findFor(kind)
    if not taskDef then return false, "no task for " .. kind end
    local ok, result, reason = pcall(taskDef.run, ctx, group)
    return ok and result == true, reason
end

-- Process a single baby (character) via the farm's furniture task
local function processBaby(p)
    if not p.Character then return end
    local name = p.Name
    say("Baby: " .. name, "info")
    for _, f in ipairs(BABY_FURNITURE) do
        if not TasksMode then break end
        setGoal("Baby " .. name .. " -> " .. f.label, { f.id })
        local ok = callAPI("InteractablesAPI/MakeBabyUseFurniture", { p.Character, f.id, f.mode }, true)
        if not ok then
            -- fall back to the farm's furniture runner
            local done, reason = runFurnitureTask(f.label, {
                { owner = "baby", kind = f.label, inProgress = true, rate = 1/20 },
            })
            if not done then say("Baby " .. name .. " " .. f.label .. ": " .. tostring(reason), "warn") end
        end
        local t = 0
        while t < FURNITURE_DWELL and TasksMode do
            setNow(("Baby %s on %s — %d/%ds"):format(name, f.label, t, FURNITURE_DWELL))
            task.wait(1); t += 1
        end
        task.wait(BETWEEN_FURNITURE)
    end
    say("Baby: " .. name .. " done", "ok")
end

-- Process a single pet via the farm's furniture task (with movement-verified detach)
local function processPet(pet)
    if not pet or not pet.Parent then return end
    local name = pet.Name or "?"
    say("Pet: " .. name, "info")
    hold(pet)
    for _, f in ipairs(PET_FURNITURE) do
        if not TasksMode then break end
        setGoal("Pet " .. name .. " -> " .. f.label, { f.id })
        local ok = callAPI("HousingAPI/ActivateFurniture", { player, f.id, f.mode, { cframe = f.cframe }, pet })
        if not ok then
            local done, reason = runFurnitureTask(f.label, {
                { owner = "pet", kind = f.label, inProgress = true, rate = 1/20, petUnique = name },
            })
            if not done then say("Pet " .. name .. " " .. f.label .. ": " .. tostring(reason), "warn") end
        end
        local t = 0
        while t < FURNITURE_DWELL and TasksMode do
            setNow(("Pet %s on %s — %d/%ds"):format(name, f.label, t, FURNITURE_DWELL))
            task.wait(1); t += 1
        end
        task.wait(BETWEEN_FURNITURE)
        -- movement-verified detach (the v3.6 fix)
        if f.cframe then
            local startPos = getPosition(pet)
            local detached = false
            for attempt = 1, PET_UNSTICK_ATTEMPTS do
                if not TasksMode then break end
                if not pet.Parent then detached = true; break end
                local okHold = callAPI("AdoptAPI/HoldBaby", { pet })
                task.wait(1.5)
                local pos = getPosition(pet)
                local moved = pos and startPos and (pos - startPos).Magnitude > 2
                local farEnough = pos and (pos - f.cframe.Position).Magnitude > PET_DETACH_RADIUS
                local noWeld = not hasAttachmentToFurniture(pet)
                if farEnough or (moved and noWeld) then detached = true; break end
                setNow(("Pet %s: detaching from %s (attempt %d/%d)..."):format(name, f.label, attempt, PET_UNSTICK_ATTEMPTS))
                task.wait(0.2)
            end
            if not detached then
                say("Pet " .. name .. ": could not detach from " .. f.label, "warn")
                break
            end
        end
    end
    eject(pet)
    say("Pet: " .. name .. " done", "ok")
end

local function workerLoop(workerIndex)
    while TasksMode do
        local item = table.remove(queue, 1)
        if not item then break end
        activeWorkers += 1
        local ok, err = pcall(function()
            if item.kind == "Baby" then
                processBaby(item.obj)
            else
                processPet(item.obj)
            end
        end)
        if not ok then say("Worker error: " .. tostring(err), "bad"); pcall(eject, item.obj) end
        activeWorkers -= 1
        passDone += 1
        say(("Pass %d: %d/%d done"):format(passNumber, passDone, passTotal), "ok")
    end
end

local function runOnePass()
    passNumber += 1
    passDone, passTotal = 0, 0
    table.clear(queue)

    local babies = otherPlayers()
    for _, p in ipairs(babies) do
        if p.Character then
            table.insert(queue, { kind = "Baby", obj = p.Character })
        end
    end
    for _, pet in ipairs(petsOnServer()) do
        table.insert(queue, { kind = "Pet", obj = pet })
    end
    passTotal = #queue
    if passTotal == 0 then
        say("Pass " .. passNumber .. ": nobody on server, waiting...", "warn")
        return
    end
    say(("Pass %d: %d subjects (%d babies, %d pets), %d workers"):format(
        passNumber, passTotal, #babies, passTotal - #babies, MAX_CONCURRENT), "info")
    for i = 1, MAX_CONCURRENT do task.spawn(workerLoop, i) end
    while TasksMode and (#queue > 0 or activeWorkers > 0) do
        setNow(("Pass %d | Active: %d | Left: %d | Done: %d/%d"):format(
            passNumber, activeWorkers, #queue, passDone, passTotal))
        task.wait(1)
    end
end

local function startAllTasks()
    TasksMode = true
    while TasksMode do
        runOnePass()
        if TasksMode then
            say("Pass " .. passNumber .. " finished, next pass in " .. PASS_COOLDOWN .. "s", "ok")
            local t = 0
            while t < PASS_COOLDOWN and TasksMode do task.wait(0.5); t += 0.5 end
        end
    end
    table.clear(queue)
    say("Task runner stopped", "ok")
end

