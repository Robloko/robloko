-- ================= API HELPERS =================
local function api(name) return ReplicatedStorage:WaitForChild("API"):FindFirstChild(name) end
local function callAPI(name, args, fire)
    local node = api(name)
    if not node then say("API missing: " .. name, "bad"); return false end
    local ok, err = pcall(function()
        if fire then node:FireServer(unpack(args)) else node:InvokeServer(unpack(args)) end
    end)
    if not ok then say("Call failed " .. name .. ": " .. tostring(err), "bad") end
    return ok
end

local function getPosition(obj)
    if not obj or not obj.Parent then return nil end
    local ok, pos = pcall(function() return obj:GetPivot().Position end)
    if ok then return pos end
    return nil
end

-- ================= NEW: INTERIOR / OCCUPIED DATA READER =================
-- Adopt Victims' AilmentTracker reads the interior furniture list from DataAPI/DataChanged
-- ("house_interior" -> interior.furniture[key].occupied[] contains the pet's StreamingId
-- while it is seated). We need the same data to verify detach.

local GameConstants = {
    DataKeys = {
        Interior = "house_interior",
        PetWrappers = "pet_char_wrappers_raw",
        StateManager = "state_manager_raw",
        Money = "money",
    },
    Remotes = {
        Folder = "API",
        DataChanged = "DataAPI/DataChanged",
        DataPartiallyChanged = "DataAPI/DataPartiallyChanged",
    },
}

local gameData = { _data = {} }

local function startDataListener()
    local apiFolder = ReplicatedStorage:WaitForChild(GameConstants.Remotes.Folder, 30)
    if not apiFolder then
        say("DataAPI folder not found; occupied-check disabled", "warn")
        return false
    end
    local dataChanged = apiFolder:FindFirstChild(GameConstants.Remotes.DataChanged)
    local partialChanged = apiFolder:FindFirstChild(GameConstants.Remotes.DataPartiallyChanged)
    local myName = player.Name
    if dataChanged and dataChanged:IsA("RemoteEvent") then
        dataChanged.OnClientEvent:Connect(function(playerName, key, value)
            if playerName == myName then gameData._data[key] = value end
        end)
    end
    if partialChanged and partialChanged:IsA("RemoteEvent") then
        partialChanged.OnClientEvent:Connect(function(playerName, changes)
            if playerName ~= myName or type(changes) ~= "table" then return end
            for _, change in ipairs(changes) do
                if type(change) == "table" and type(change.replicated_key_path) == "table" then
                    local path = change.replicated_key_path
                    local rootKey = path[1]
                    if #path == 1 then
                        gameData._data[rootKey] = change.serialized_partial_value
                    else
                        if type(gameData._data[rootKey]) ~= "table" then gameData._data[rootKey] = {} end
                        local node = gameData._data[rootKey]
                        for i = 2, #path - 1 do
                            if type(node[path[i]]) ~= "table" then node[path[i]] = {} end
                            node = node[path[i]]
                        end
                        node[path[#path]] = change.serialized_partial_value
                    end
                end
            end
        end)
    end
    -- Snapshot from ClientData (Adopt Victims GameData:_loadSnapshot)
    pcall(function()
        local moduleScript = ReplicatedStorage
        for _, name in ipairs({ "ClientModules", "Core", "ClientData" }) do
            moduleScript = moduleScript and moduleScript:FindFirstChild(name)
        end
        if moduleScript then
            local clientData = require(moduleScript)
            if type(clientData) == "table" and type(clientData.get_data) == "function" then
                local all = clientData.get_data()
                local mine = type(all) == "table" and all[myName]
                if type(mine) == "table" then
                    for _, k in pairs(GameConstants.DataKeys) do
                        if mine[k] ~= nil then gameData._data[k] = mine[k] end
                    end
                end
            end
        end
    end)
    return true
end

-- pet wrapper: pet_unique -> char (StreamingId), from pet_char_wrappers_raw
local function getStreamingId(petUnique)
    local wrappers = gameData._data[GameConstants.DataKeys.PetWrappers]
    if type(wrappers) ~= "table" then return nil end
    for _, wrapper in pairs(wrappers) do
        if type(wrapper) == "table" and wrapper.pet_unique == petUnique and type(wrapper.char) == "string" then
            return wrapper.char
        end
    end
    return nil
end

-- is my pet still seated in ANY furniture piece in my house?
-- (Adopt Victims Tasks.petOffFurniture -> isOn())
local function isPetOnFurniture(petUnique)
    local interior = gameData._data[GameConstants.DataKeys.Interior]
    if type(interior) ~= "table" or type(interior.furniture) ~= "table" then
        return nil -- unknown
    end
    local pid = getStreamingId(petUnique)
    if not pid then return nil end -- no wrapper yet: can't check
    for _, piece in pairs(interior.furniture) do
        if type(piece) == "table" and type(piece.occupied) == "table" then
            for _, who in pairs(piece.occupied) do
                if who == pid then return true end
            end
        end
    end
    return false
end

-- the pet model in workspace.Pets, matched by StreamingId attribute
local function findPetModel(petUnique)
    local pid = getStreamingId(petUnique)
    if not pid then return nil end
    local folder = workspace:FindFirstChild("Pets")
    if not folder then return nil end
    for _, model in ipairs(folder:GetChildren()) do
        local ok, v = pcall(function() return model:GetAttribute("StreamingId") end)
        if ok and v == pid then return model end
    end
    return nil
end

-- ================= NEW: DETACH VERIFIED VIA DATA =================
-- The real fix. Adopt Victims sends PetAPI/ExitFurnitureUseStates(petUnique), then waits for
-- interior.furniture[*].occupied[] to stop containing the pet. Only then does it hold the pet.

local function detachPetByData(petUnique, why)
    local seated = isPetOnFurniture(petUnique)
    if seated == false then return true end -- already off
    if seated == nil then
        -- no interior data: fall back to position check (best effort)
        local model = findPetModel(petUnique)
        if not model then return false, "no wrapper / interior data" end
    end

    for attempt = 1, DETACH_RETRIES do
        if not TasksMode then return false end

        say(string.format("%s: sending ExitFurnitureUseStates (try %d/%d)", why, attempt, DETACH_RETRIES), "info")
        callAPI("PetAPI/ExitFurnitureUseStates", { petUnique })

        -- Data-verified wait: occupied[] must clear
        local deadline = os.clock() + DETACH_TIMEOUT
        local cleared = false
        while os.clock() < deadline do
            if not TasksMode then return false end
            local still = isPetOnFurniture(petUnique)
            if still == false then cleared = true; break end
            task.wait(0.25)
        end

        if cleared then
            say(why .. ": detached (occupied[] cleared)", "ok")
            return true
        end

        -- Last attempt: also try position fallback
        if attempt == DETACH_RETRIES then
            local model = findPetModel(petUnique)
            if model then
                local still = isPetOnFurniture(petUnique)
                if still == nil then
                    -- no data to verify: use a generous position check
                    local pos = getPosition(model)
                    if pos then
                        -- if it moved away from all furniture CFrames, consider it detached
                        local nearest = math.huge
                        for _, f in ipairs(PET_FURNITURE) do
                            if f.cframe then
                                local d = (pos - f.cframe.Position).Magnitude
                                if d < nearest then nearest = d end
                            end
                        end
                        if nearest > 15 then
                            say(why .. ": detached (position fallback, nearest furniture " .. math.floor(nearest) .. " studs)", "warn")
                            return true
                        end
                    end
                end
            end
        end
        task.wait(0.5)
    end
    return false, "occupied[] still contains the pet after " .. DETACH_RETRIES .. " ExitFurnitureUseStates"
end

