-- ================= CONFIG =================
local INVITE_DELAY      = 1.0
local FURNITURE_DWELL   = 20      -- seconds per furniture
local BETWEEN_SUBJECTS  = 0.8
local BETWEEN_FURNITURE = 0.4
local UNSTICK_TIMEOUT   = 60      -- max seconds to keep trying to detach a pet
local DETACH_RADIUS     = 6       -- studs: closer than this = still on furniture (babies)
local PET_DETACH_RADIUS = 20      -- studs: wider tolerance for pet models
local PET_UNSTICK_ATTEMPTS = 40   -- max re-hold attempts for pets
local EJECT_TIME        = 0.4
local MAX_CONCURRENT    = 2       -- game allows holding 2 objects at once
local PASS_COOLDOWN     = 2       -- seconds between full passes

