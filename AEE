        end
        b.Text = "CREATE FAMILY + INVITE ALL [ON]"; b.BackgroundColor3 = THEME.ok
        task.spawn(createFamilyAndInvite)
        task.spawn(function()
            while FamilyMode and frame.Parent do task.wait(0.5) end
            if b.Parent then b.Text = "CREATE FAMILY + INVITE ALL [OFF]"; b.BackgroundColor3 = THEME.fam end
        end)
    end)

    local taskBtn = toggleButton(frame, 8, 178, width-16, "RUN TASKS NONSTOP (x" .. MAX_CONCURRENT .. ") [OFF]", THEME.task, function(b)
        if TasksMode then
            TasksMode = false
            table.clear(queue)
            b.Text = "RUN TASKS NONSTOP (x" .. MAX_CONCURRENT .. ") [OFF]"; b.BackgroundColor3 = THEME.task
            say("Stopping... ejecting held subjects", "warn")
            task.spawn(ejectAllHeld)
            return
        end
        b.Text = "RUN TASKS NONSTOP (x" .. MAX_CONCURRENT .. ") [ON]"; b.BackgroundColor3 = THEME.ok
        task.spawn(startAllTasks)
        task.spawn(function()
            while TasksMode and frame.Parent do task.wait(0.5) end
            if b.Parent then b.Text = "RUN TASKS NONSTOP (x" .. MAX_CONCURRENT .. ") [OFF]"; b.BackgroundColor3 = THEME.task end
        end)
    end)

    text(frame, 8, 216, width-16, 14, "Uses PetAPI/ExitFurnitureUseStates + occupied[] check", 10, THEME.dim)
    text(frame, 8, 230, width-16, 14, "(Adopt Victims' verified detach — no stuck pets)", 10, THEME.dim)
    text(frame, 8, 244, width-16, 14, "Pass X: done Y/Z = this pass progress", 10, THEME.dim)
    text(frame, 8, 258, width-16, 14, "Data-verified, not position-guessed", 10, THEME.dim)
    create("Frame", { Position = UDim2.fromOffset(8, 278), Size = UDim2.new(1,-16,0,1),
        BackgroundColor3 = THEME.line, BorderSizePixel = 0 }, frame)
    text(frame, 8, 284, width-16, 14, "COCOON v4.0 — Adopt Victims detach flow", 10, THEME.dim)
    text(frame, 8, 298, width-16, 14, "pet_char_wrappers_raw + house_interior.occupied", 10, THEME.dim)
end

