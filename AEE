local FURNITURE_DWELL   = 20
local BETWEEN_SUBJECTS  = 0.8
local BETWEEN_FURNITURE = 0.4
local UNSTICK_TIMEOUT   = 60
local DETACH_RADIUS     = 6
local EJECT_TIME        = 0.4
local MAX_CONCURRENT    = 2
local PASS_COOLDOWN     = 2
local DEBUG_POS         = true

