-- ================= API HELPERS =================
local function api(name) return ReplicatedStorage:WaitForChild("API"):FindFirstChild(name) end
local function callAPI(name, args, fire)
    local node = api(name)
    if not node then say("API missing: " .. name, "bad"); return false end
    local ok, err = pcall(function()
        if fire then node:FireServer(unpack(args)) else node:InvokeServer(unpack(args)) end
    end)
    if not ok then say("Call failed " .. name .. ": " .. tostring(err), "bad") end
    return ok
end

local function getPosition(obj)
    if not obj or not obj.Parent then return nil end
    local ok, pos = pcall(function() return obj:GetPivot().Position end)
    if ok then return pos end
    return nil
end

local function stillOnFurniture(obj, fCframe, radius)
    if not fCframe then return false end
    if not obj or not obj.Parent then return false end
    local pos = getPosition(obj)
    if not pos then return true end
    return (pos - fCframe.Position).Magnitude < (radius or DETACH_RADIUS)
end

local function hasAttachmentToFurniture(obj)
    if not obj then return false end
    local ok, result = pcall(function()
        for _, d in ipairs(obj:GetDescendants()) do
            if d:IsA("Weld") or d:IsA("Motor6D") or d:IsA("AlignPosition") or d:IsA("AlignOrientation") then
                local p0, p1 = d.Part0, d.Part1
                if (p0 and not p0:IsDescendantOf(obj)) or (p1 and not p1:IsDescendantOf(obj)) then
                    return true
                end
            end
        end
        return false
    end)
    return ok and result or false
end

-- ================= INVENTORY / FEED HELPERS =================
local function getInventory(category)
    local items = {}
    local ok, err = pcall(function()
        local clientData = require(ReplicatedStorage.ClientModules.Core.ClientData)
        local playerData = clientData.get_data()[player.Name]
        if playerData and playerData.inventory and playerData.inventory[category] then
            for itemId, itemData in pairs(playerData.inventory[category]) do
                if itemData.id then
                    table.insert(items, {
                        id = itemId,                 -- instance id (used for ToolAPI/Equip)
                        name = itemData.id,          -- item name
                        amount = itemData.amount or 1,
                    })
                end
            end
        end
    end)
    if not ok then say("Inventory read failed (" .. category .. "): " .. tostring(err), "warn") end
    return items
end

local function buyItem(category, itemName, count)
    return callAPI("ShopAPI/BuyItem", { category, itemName, { buy_count = count or 1 } })
end

-- Ensure we have at least one item of the given category; return {id, name} or nil
local function ensureItem(category, fallbackList)
    local inv = getInventory(category)
    if #inv > 0 then
        table.sort(inv, function(a, b) return a.amount > b.amount end)
        return inv[1]
    end
    for _, name in ipairs(fallbackList or {}) do
        if buyItem(category, name, 1) then
            say("Bought fallback " .. category .. ": " .. name, "info")
            task.wait(0.5)
            local inv2 = getInventory(category)
            if #inv2 > 0 then
                table.sort(inv2, function(a, b) return a.amount > b.amount end)
                return inv2[1]
            end
        end
    end
    return nil
end

-- Equip a tool by its instance id (SimpleSpy-confirmed signature)
local function equipTool(instanceId)
    return callAPI("ToolAPI/Equip", { instanceId, { equip_as_last = false, use_sound_delay = true } })
end

-- Feed/drink a pet directly via PetObjectAPI/CreatePetObject
-- petUnique  = pet's unique id (e.g. "2_41fa5d1f0f3a4dad8025298ab4a45f1b")
-- foodUnique = the item's unique id   (e.g. "2_53ea253f25ec43f0848958dc8b06461e")
local function feedPetDirect(petUnique, foodUnique)
    return callAPI("PetObjectAPI/CreatePetObject", {
        PET_OBJECT_CONSUME,
        {
            additional_consume_uniques = {},
            pet_unique   = petUnique,
            unique_id    = foodUnique,
        },
    })
end

-- Extract the pet's "unique" id from the workspace pet model.
-- Tries common attribute/child names; falls back to the model's own Name.
local function getPetUnique(pet)
    if not pet then return nil end
    -- 1) attribute on model
    for _, attr in ipairs({ "unique", "unique_id", "UniqueId", "PetUnique" }) do
        local ok, v = pcall(function() return pet:GetAttribute(attr) end)
        if ok and type(v) == "string" and v ~= "" then return v end
    end
    -- 2) child StringValue / Configuration container
    local ok, found = pcall(function()
        for _, d in ipairs(pet:GetDescendants()) do
            if d:IsA("StringValue") and (d.Name:lower():find("unique") or d.Name:lower():find("id")) then
                return d.Value
            end
        end
        return nil
    end)
    if ok and found and found ~= "" then return found end
    return nil
end

-- Prepare food or drink: ensure inventory -> equip tool. Returns {id, name} or nil.
local function prepareConsumable(category)
    local fallback = (category == "food") and FALLBACK_FOOD or FALLBACK_DRINK
    local item = ensureItem(category, fallback)
    if not item then
        say("No " .. category .. " available (inventory empty + buy failed)", "bad")
        return nil
    end
    say("Equipping " .. category .. ": " .. item.name, "info")
    if not equipTool(item.id) then
        say("Equip failed for " .. category .. " " .. item.name, "bad")
        return nil
    end
    task.wait(0.6) -- let tool actually appear in hand
    return item
end

-- Full feed flow: pick food -> equip -> CreatePetObject. Returns true/false.
local function feedPet(pet, category)
    local petUnique = getPetUnique(pet)
    if not petUnique then
        say("Could not resolve pet unique id for " .. (pet.Name or "?"), "warn")
        return false
    end
    local item = prepareConsumable(category)
    if not item then return false end
    say("Feeding " .. (pet.Name or "?") .. " with " .. item.name, "info")
    local ok = feedPetDirect(petUnique, item.id)
    if ok then
        say("Feed sent: " .. (pet.Name or "?") .. " <- " .. item.name, "ok")
        task.wait(FEED_DWELL)
    else
        say("Feed failed: " .. (pet.Name or "?"), "bad")
    end
    return ok
end

-- ================= BUTTON 1 =================
local FamilyMode = false
local function createFamilyAndInvite()
    FamilyMode = true
    say("Creating family...", "info")
    if not callAPI("FamilyAPI/CreateFamily", {}) then
        say("Family creation failed (already in a family?)", "bad"); FamilyMode = false; return
    end
    say("Family created. Inviting everyone...", "ok")
    task.wait(1)
