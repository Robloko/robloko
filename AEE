-- ================= STATUS / LOG =================
local ui = {}
local uiLog = nil
local status = { now = "Ready", goal = "Pick an action", queue = {} }

local function renderStatus()
    if ui.now then
        pcall(function()
            ui.now.Text = status.now
            ui.goal.Text = status.goal
            ui.queue.Text = #status.queue > 0 and ("Next: " .. table.concat(status.queue, "\n         ")) or ""
        end)
    end
end
local function setGoal(t, q) status.goal = t or ""; status.queue = q or {}; renderStatus() end
local function setNow(t) status.now = t or ""; renderStatus() end
local function say(text, tone)
    setNow(text)
    if uiLog then pcall(uiLog, tone or "info", text) end
    print("[COCOON] " .. tostring(text))
end

-- ================= COUNTERS =================
local function countPlayers() local n = 0; for _ in Players:GetPlayers() do n += 1 end; return n end
local function countPets()
    local f = workspace:FindFirstChild("Pets"); if not f then return 0 end
    local n = 0; for _ in f:GetChildren() do n += 1 end; return n
end
local function otherPlayers()
    local list = {}
    for _, p in ipairs(Players:GetPlayers()) do if p ~= player then table.insert(list, p) end end
    return list
end
local function petsOnServer()
    local f = workspace:FindFirstChild("Pets"); if not f then return {} end
    return f:GetChildren()
end

-- ================= API HELPERS =================
local function api(name) return ReplicatedStorage:WaitForChild("API"):FindFirstChild(name) end
local function callAPI(name, args, fire)
    local node = api(name)
    if not node then say("API missing: " .. name, "bad"); return false end
    local ok, err = pcall(function()
        if fire then node:FireServer(unpack(args)) else node:InvokeServer(unpack(args)) end
    end)
    if not ok then say("Call failed " .. name .. ": " .. tostring(err), "bad") end
    return ok
end

local function getPosition(obj)
    if not obj or not obj.Parent then return nil end
    local ok, pos = pcall(function() return obj:GetPivot().Position end)
    if ok then return pos end
    return nil
end

-- Movement-verified detach. For pets we use a much wider radius and
-- also fall back to checking whether the model is still parented
-- under the furniture / has an active weld to it.
local function stillOnFurniture(obj, fCframe, radius)
    if not fCframe then return false end
    if not obj or not obj.Parent then return false end
    local pos = getPosition(obj)
    if not pos then return true end -- can't read position => assume stuck
    return (pos - fCframe.Position).Magnitude < (radius or DETACH_RADIUS)
end

-- Extra heuristic for pets: are they welded/attached to furniture?
local function hasAttachmentToFurniture(obj)
    if not obj then return false end
    local ok, result = pcall(function()
        -- Check for welds/motor6d whose Part0/Part1 is not part of the pet
        for _, d in ipairs(obj:GetDescendants()) do
            if d:IsA("Weld") or d:IsA("Motor6D") or d:IsA("AlignPosition") or d:IsA("AlignOrientation") then
                local p0, p1 = d.Part0, d.Part1
                if (p0 and not p0:IsDescendantOf(obj)) or (p1 and not p1:IsDescendantOf(obj)) then
                    return true
                end
            end
        end
        return false
    end)
    return ok and result or false
end

-- ================= BUTTON 1: CREATE FAMILY + INVITE ALL =================
local FamilyMode = false
local function createFamilyAndInvite()
    FamilyMode = true
    say("Creating family...", "info")
    if not callAPI("FamilyAPI/CreateFamily", {}) then
        say("Family creation failed (already in a family?)", "bad"); FamilyMode = false; return
    end
    say("Family created. Inviting everyone...", "ok")
    task.wait(1)
    local targets = otherPlayers()
    setGoal("Inviting " .. #targets .. " player(s)")
    for _, p in ipairs(targets) do
        if not FamilyMode then break end
        setGoal("Inviting " .. #targets, { p.Name })
        callAPI("FamilyAPI/InvitePlayer", { p })
        say("Family invite -> " .. p.Name, "ok")
        task.wait(INVITE_DELAY)
    end
    say("Family invite pass finished", "ok")
    FamilyMode = false
end

-- ================= BUTTON 2: CONTINUOUS WORKER POOL =================
local TasksMode = false
local queue = {}
local heldSubjects = {}
local activeWorkers = 0
local passNumber, passDone, passTotal = 0, 0, 0

local function hold(obj)
    callAPI("AdoptAPI/HoldBaby", { obj })
    task.wait(0.5)
end
local function eject(obj)
    if obj then
        callAPI("AdoptAPI/EjectBaby", { obj }, true)
    end
    task.wait(EJECT_TIME)
end

local function ejectAllHeld()
    for id, obj in pairs(heldSubjects) do
        if obj then
            say("Force eject: " .. (obj.Name or "?"), "warn")
            pcall(eject, obj)
        end
        heldSubjects[id] = nil
    end
end

-- Movement-verified pickup for pets. Repeatedly fires HoldBaby and
-- checks that the pet has actually moved off the furniture. Returns
-- true when detached (or gone), false if it timed out.
local function detachPet(obj, fCframe, why)
    if not obj or not obj.Parent then return true end
    if not fCframe then return true end

    local startPos = getPosition(obj)
    for attempt = 1, PET_UNSTICK_ATTEMPTS do
        if not TasksMode then return false end
        if not obj.Parent then return true end

        callAPI("AdoptAPI/HoldBaby", { obj })
        task.wait(1.5)

        local pos = getPosition(obj)
        local moved = pos and startPos and (pos - startPos).Magnitude > 2
        local farEnough = pos and (pos - fCframe.Position).Magnitude > PET_DETACH_RADIUS
        local noWeld = not hasAttachmentToFurniture(obj)

        if farEnough or (moved and noWeld) then
            return true
        end

        setNow(string.format("%s: detaching (attempt %d/%d)...",
            why, attempt, PET_UNSTICK_ATTEMPTS))
        task.wait(0.2)
    end
    return false
end

local function processSubject(kind, obj, fList, offset, workerIndex)
    if not obj or not obj.Parent then return end
    local name = obj.Name or "?"
    heldSubjects[workerIndex] = obj

    say(kind .. ": " .. name .. " (held)", "info")
    hold(obj)

    local n = #fList
    for i = 1, n do
        if not TasksMode then break end
        local f = fList[((i - 1 + offset) % n) + 1]
        setGoal("Pass " .. passNumber .. " | " .. kind .. " " .. name .. " -> " .. f.label, { f.id })
        if kind == "Pet" then
            callAPI("HousingAPI/ActivateFurniture", { player, f.id, f.mode, { cframe = f.cframe }, obj })
        else
            callAPI("InteractablesAPI/MakeBabyUseFurniture", { obj, f.id, f.mode }, true)
        end
        local t = 0
        while t < FURNITURE_DWELL and TasksMode do
            setNow(string.format("P%d %s %s on %s — %.0f/%ds",
                passNumber, kind, name, f.label, t, FURNITURE_DWELL))
            task.wait(1); t += 1
        end
        task.wait(BETWEEN_FURNITURE)

        if kind == "Pet" and i < n and f.cframe then
            -- ALWAYS attempt detach for pets after dwell. Position check
            -- alone is unreliable for pet models, so we re-hold and verify
            -- movement instead of trusting stillOnFurniture().
            if detachPet(obj, f.cframe, kind .. " " .. name .. " @ " .. f.label) then
                say(kind .. " " .. name .. ": detached from " .. f.label, "ok")
            else
                say(kind .. " " .. name .. ": could not detach from " .. f.label, "warn")
                break
            end
            task.wait(0.3)
        elseif kind == "Baby" and i < n then
            -- Babies use the original position check; they work reliably.
            local fC = f.cframe
            if fC and stillOnFurniture(obj, fC, DETACH_RADIUS) then
                say(kind .. " " .. name .. ": waiting to detach from " .. f.label, "warn")
                local waited = 0
                local detached = false
                while waited < UNSTICK_TIMEOUT and TasksMode do
                    callAPI("AdoptAPI/HoldBaby", { obj })
                    task.wait(1.5); waited += 1.5
                    if not stillOnFurniture(obj, fC, DETACH_RADIUS) then detached = true; break end
                end
                if not detached then
                    say(kind .. " " .. name .. ": unstick failed, ejecting", "warn")
                    break
                end
                say(kind .. " " .. name .. ": detached from " .. f.label, "ok")
            end
            task.wait(0.3)
        end
    end
    eject(obj)
    say(kind .. ": " .. name .. " ejected", "ok")
    heldSubjects[workerIndex] = nil
    task.wait(BETWEEN_SUBJECTS)
end

local function workerLoop(workerIndex)
    while TasksMode do
        local item = table.remove(queue, 1)
        if not item then break end
        activeWorkers += 1
        local ok, err = pcall(function()
            -- offset 0: every subject begins at the first furniture (sleep)
            processSubject(item.kind, item.obj, item.flist, 0, workerIndex)
        end)
        if not ok then
            say("Worker error: " .. tostring(err), "bad")
            pcall(eject, item.obj)
            heldSubjects[workerIndex] = nil
        end
        activeWorkers -= 1
        passDone += 1
        say(string.format("Pass %d: %d/%d done", passNumber, passDone, passTotal), "ok")
    end
end

-- One pass = process every baby + pet currently on the server
-- Players (babies) are queued BEFORE pets.
local function runOnePass()
    passNumber += 1
    passDone, passTotal = 0, 0
    table.clear(queue)
    table.clear(heldSubjects)

    local babies = otherPlayers()
    for _, p in ipairs(babies) do
        if p.Character then
            table.insert(queue, { kind = "Baby", obj = p.Character, flist = BABY_FURNITURE })
        end
    end
    for _, pet in ipairs(petsOnServer()) do
        table.insert(queue, { kind = "Pet", obj = pet, flist = PET_FURNITURE })
    end
    passTotal = #queue

    if passTotal == 0 then
        say("Pass " .. passNumber .. ": nobody on server, waiting...", "warn")
        return
    end

    say(string.format("Pass %d: %d subjects (%d babies, %d pets), %d workers",
        passNumber, passTotal, #babies, passTotal - #babies, MAX_CONCURRENT), "info")

    for i = 1, MAX_CONCURRENT do
        task.spawn(workerLoop, i)
    end

    -- wait for this pass to drain
    while TasksMode and (#queue > 0 or activeWorkers > 0) do
        setNow(string.format("Pass %d | Active: %d | Left: %d | Done: %d/%d",
            passNumber, activeWorkers, #queue, passDone, passTotal))
        task.wait(1)
    end
    ejectAllHeld()
end

-- NON-STOP: keep doing passes until the button is switched OFF
local function startAllTasks()
    TasksMode = true
    while TasksMode do
        runOnePass()
        if TasksMode then
            say("Pass " .. passNumber .. " finished, next pass in " .. PASS_COOLDOWN .. "s", "ok")
            local t = 0
            while t < PASS_COOLDOWN and TasksMode do task.wait(0.5); t += 0.5 end
        end
    end
    table.clear(queue)
    ejectAllHeld()
    say("Task runner stopped, all subjects ejected", "ok")
end

