-- ================= API HELPERS =================
local function api(name) return ReplicatedStorage:WaitForChild("API"):FindFirstChild(name) end
local function callAPI(name, args, fire)
    local node = api(name)
    if not node then say("API missing: " .. name, "bad"); return false end
    local ok, err = pcall(function()
        if fire then node:FireServer(unpack(args)) else node:InvokeServer(unpack(args)) end
    end)
    if not ok then say("Call failed " .. name .. ": " .. tostring(err), "bad") end
    return ok
end

local function getPosition(obj)
    if not obj or not obj.Parent then return nil end
    local ok, pos = pcall(function() return obj:GetPivot().Position end)
    if ok then return pos end
    return nil
end

local function stillOnFurniture(obj, fCframe, radius)
    if not fCframe then return false end
    if not obj or not obj.Parent then return false end
    local pos = getPosition(obj)
    if not pos then return true end
    return (pos - fCframe.Position).Magnitude < (radius or DETACH_RADIUS)
end

local function hasAttachmentToFurniture(obj)
    if not obj then return false end
    local ok, result = pcall(function()
        for _, d in ipairs(obj:GetDescendants()) do
            if d:IsA("Weld") or d:IsA("Motor6D") or d:IsA("AlignPosition") or d:IsA("AlignOrientation") then
                local p0, p1 = d.Part0, d.Part1
                if (p0 and not p0:IsDescendantOf(obj)) or (p1 and not p1:IsDescendantOf(obj)) then
                    return true
                end
            end
        end
        return false
    end)
    return ok and result or false
end

