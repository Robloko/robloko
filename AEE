        callAPI("FamilyAPI/InvitePlayer", { p })
        say("Family invite -> " .. p.Name, "ok")
        task.wait(INVITE_DELAY)
    end
    say("Family invite pass finished", "ok")
    FamilyMode = false
end

-- ================= BUTTON 2: CONTINUOUS WORKER POOL =================
local TasksMode = false
local queue = {}
local heldSubjects = {}
local activeWorkers = 0
local passNumber, passDone, passTotal = 0, 0, 0

local function hold(obj)
    local node = api("AdoptAPI/HoldBaby")
    if node then
        pcall(function() node:InvokeServer(obj) end)
    end
    task.wait(0.5)
end

local function eject(obj)
    local node = api("AdoptAPI/EjectBaby")
    if node and obj then
        pcall(function() node:FireServer(obj) end)
    end
    task.wait(EJECT_TIME)
end

local function ejectAllHeld()
    for id, obj in pairs(heldSubjects) do
        if obj then
            say("Force eject: " .. (obj.Name or "?"), "warn")
            pcall(eject, obj)
        end
        heldSubjects[id] = nil
    end
end

local function detachPet(obj, fCframe, why)
    if not obj or not obj.Parent then return true end
    local startPos = getPosition(obj)
    for attempt = 1, PET_UNSTICK_ATTEMPTS do
        if not TasksMode then return false end
        if not obj.Parent then return true end
        hold(obj)
        local pos = getPosition(obj)
        local moved      = pos and startPos and (pos - startPos).Magnitude > 2
        local farEnough  = (not fCframe) or (pos and (pos - fCframe.Position).Magnitude > PET_DETACH_RADIUS)
        local noWeld     = not hasAttachmentToFurniture(obj)
        if farEnough or (moved and noWeld) then
            return true
        end
        setNow(string.format("%s: detaching (attempt %d/%d)...", why, attempt, PET_UNSTICK_ATTEMPTS))
        task.wait(0.2)
    end
    return false
end

local function processSubject(kind, obj, fList, offset, workerIndex)
    if not obj or not obj.Parent then return end
    local name = obj.Name or "?"
    heldSubjects[workerIndex] = obj

    say(kind .. ": " .. name .. " (held)", "info")
    hold(obj)

    -- NEW: pets are fed/drunk directly (no f-24/f-9 furniture) before furniture loop
    if kind == "Pet" then
        setGoal("Feeding " .. name .. " (food)", { "PetObjectAPI/CreatePetObject" })
        feedPet(obj, "food")
        if TasksMode then
            setGoal("Drinking " .. name .. " (drink)", { "PetObjectAPI/CreatePetObject" })
            feedPet(obj, "drink")
        end
    end

    local n = #fList
    for i = 1, n do
        if not TasksMode then break end
        local f = fList[((i - 1 + offset) % n) + 1]
        setGoal("Pass " .. passNumber .. " | " .. kind .. " " .. name .. " -> " .. f.label, { f.id })

        if kind == "Pet" then
            callAPI("HousingAPI/ActivateFurniture", { player, f.id, f.mode, { cframe = f.cframe }, obj })
        else
            callAPI("InteractablesAPI/MakeBabyUseFurniture", { obj, f.id, f.mode }, true)
        end

        local t = 0
        while t < FURNITURE_DWELL and TasksMode do
            setNow(string.format("P%d %s %s on %s — %.0f/%ds",
                passNumber, kind, name, f.label, t, FURNITURE_DWELL))
            task.wait(1); t += 1
        end
        task.wait(BETWEEN_FURNITURE)

        if kind == "Pet" then
            hold(obj)
            if i < n then
                if detachPet(obj, f.cframe, kind .. " " .. name .. " @ " .. f.label) then
                    say(kind .. " " .. name .. ": detached from " .. f.label, "ok")
                else
                    say(kind .. " " .. name .. ": could not detach from " .. f.label, "warn")
                    break
                end
                task.wait(0.3)
            end
        elseif kind == "Baby" and i < n then
            local fC = f.cframe
            if fC and stillOnFurniture(obj, fC, DETACH_RADIUS) then
                say(kind .. " " .. name .. ": waiting to detach from " .. f.label, "warn")
                local waited = 0
                local detached = false
                while waited < UNSTICK_TIMEOUT and TasksMode do
                    hold(obj)
                    task.wait(1.5); waited += 1.5
                    if not stillOnFurniture(obj, fC, DETACH_RADIUS) then detached = true; break end
                end
                if not detached then
                    say(kind .. " " .. name .. ": unstick failed, ejecting", "warn")
                    break
                end
                say(kind .. " " .. name .. ": detached from " .. f.label, "ok")
            end
            task.wait(0.3)
        end
    end

    eject(obj)
    say(kind .. ": " .. name .. " ejected", "ok")
    heldSubjects[workerIndex] = nil
    task.wait(BETWEEN_SUBJECTS)
end

local function workerLoop(workerIndex)
    while TasksMode do
        local item = table.remove(queue, 1)
        if not item then break end
        activeWorkers += 1
        local ok, err = pcall(function()
            processSubject(item.kind, item.obj, item.flist, workerIndex, workerIndex)
        end)
        if not ok then
            say("Worker error: " .. tostring(err), "bad")
            pcall(eject, item.obj)
            heldSubjects[workerIndex] = nil
        end
        activeWorkers -= 1
        passDone += 1
        say(string.format("Pass %d: %d/%d done", passNumber, passDone, passTotal), "ok")
    end
end

local function runOnePass()
    passNumber += 1
    passDone, passTotal = 0, 0
    table.clear(queue)
    table.clear(heldSubjects)

    local babies = otherPlayers()
    for _, p in ipairs(babies) do
        if p.Character then
            table.insert(queue, { kind = "Baby", obj = p.Character, flist = BABY_FURNITURE })
        end
    end
    for _, pet in ipairs(petsOnServer()) do
        table.insert(queue, { kind = "Pet", obj = pet, flist = PET_FURNITURE })
    end
    passTotal = #queue

    if passTotal == 0 then
        say("Pass " .. passNumber .. ": nobody on server, waiting...", "warn")
        return
    end

    say(string.format("Pass %d: %d subjects (%d babies, %d pets), %d workers",
        passNumber, passTotal, #babies, passTotal - #babies, MAX_CONCURRENT), "info")

    for i = 1, MAX_CONCURRENT do
        task.spawn(workerLoop, i)
    end

    while TasksMode and (#queue > 0 or activeWorkers > 0) do
        setNow(string.format("Pass %d | Active: %d | Left: %d | Done: %d/%d",
            passNumber, activeWorkers, #queue, passDone, passTotal))
        task.wait(1)
    end
    ejectAllHeld()
end

local function startAllTasks()
    TasksMode = true
    while TasksMode do
        runOnePass()
        if TasksMode then
            say("Pass " .. passNumber .. " finished, next pass in " .. PASS_COOLDOWN .. "s", "ok")
            local t = 0
            while t < PASS_COOLDOWN and TasksMode do task.wait(0.5); t += 0.5 end
        end
    end
    table.clear(queue)
    ejectAllHeld()
    say("Task runner stopped, all subjects ejected", "ok")
end

