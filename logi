local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

local function clickButton(button)
    if button and button.Visible and button.Active and button:IsA("GuiButton") then
        if firesignal then
            firesignal(button.MouseButton1Down)
            task.wait(0.05)
            firesignal(button.MouseButton1Up)
            firesignal(button.MouseButton1Click)
        else
            button.MouseButton1Click:Fire()
        end
        print("Clicked: " .. button:GetFullName())
        return true
    end
    return false
end

local function getButtons()
    local dialog = PlayerGui:FindFirstChild("DialogApp")
        and PlayerGui.DialogApp:FindFirstChild("Dialog")
    if not dialog then return {} end

    local buttons = {}

    -- 1. ArachnophobiaModeDialog.Off
    local arach = dialog:FindFirstChild("ArachnophobiaModeDialog")
    if arach then
        local btns = arach:FindFirstChild("Buttons")
        if btns then table.insert(buttons, btns:FindFirstChild("Off")) end
    end

    -- 2. SpawnChooserDialog Home button
    local spawn = dialog:FindFirstChild("SpawnChooserDialog")
    if spawn then
        local upper = spawn:FindFirstChild("UpperCardContainer")
        if upper then
            local choices = upper:FindFirstChild("ChoicesContent")
            if choices then
                local home = choices:FindFirstChild("Choices")
                if home then table.insert(buttons, home:FindFirstChild("Button")) end
            end
        end
    end

    -- 3. ThemeColorDialog Response child #8
    local theme = dialog:FindFirstChild("ThemeColorDialog")
    if theme then
        local info = theme:FindFirstChild("Info")
        if info then
            local response = info:FindFirstChild("Response")
            if response then
                local kids = response:GetChildren()
                if kids[8] then table.insert(buttons, kids[8]) end
            end
        end
        -- 4. ThemeColorDialog ButtonTemplate
        local btns = theme:FindFirstChild("Buttons")
        if btns then table.insert(buttons, btns:FindFirstChild("ButtonTemplate")) end
    end

    -- 5. ExitButton
    table.insert(buttons, dialog:FindFirstChild("ExitButton"))

    return buttons
end

while task.wait(2) do
    pcall(function()
        for _, b in ipairs(getButtons()) do
            if clickButton(b) then
                task.wait(2) -- small pause after a click
            end
        end
    end)
end
