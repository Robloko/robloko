local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

local function getButtons()
    local buttons = {}

    -- 1. ArachnophobiaModeDialog "Off"
    local b1 = PlayerGui:FindFirstChild("DialogApp")
        and PlayerGui.DialogApp:FindFirstChild("Dialog")
        and PlayerGui.DialogApp.Dialog:FindFirstChild("ArachnophobiaModeDialog")
        and PlayerGui.DialogApp.Dialog.ArachnophobiaModeDialog:FindFirstChild("Buttons")
        and PlayerGui.DialogApp.Dialog.ArachnophobiaModeDialog.Buttons:FindFirstChild("Off")
    if b1 then table.insert(buttons, b1) end

    -- 2. SpawnChooserDialog Home button
    local b2 = PlayerGui:FindFirstChild("DialogApp")
        and PlayerGui.DialogApp.Dialog:FindFirstChild("SpawnChooserDialog")
        and PlayerGui.DialogApp.Dialog.SpawnChooserDialog:FindFirstChild("UpperCardContainer")
        and PlayerGui.DialogApp.Dialog.SpawnChooserDialog.UpperCardContainer:FindFirstChild("ChoicesContent")
        and PlayerGui.DialogApp.Dialog.SpawnChooserDialog.UpperCardContainer.ChoicesContent:FindFirstChild("Choices")
        and PlayerGui.DialogApp.Dialog.SpawnChooserDialog.UpperCardContainer.ChoicesContent.Choices:FindFirstChild("Home")
        and PlayerGui.DialogApp.Dialog.SpawnChooserDialog.UpperCardContainer.ChoicesContent.Choices.Home:FindFirstChild("Button")
    if b2 then table.insert(buttons, b2) end

    -- 3. ThemeColorDialog Response child #8
    local b3 = PlayerGui:FindFirstChild("DialogApp")
        and PlayerGui.DialogApp.Dialog:FindFirstChild("ThemeColorDialog")
        and PlayerGui.DialogApp.Dialog.ThemeColorDialog:FindFirstChild("Info")
        and PlayerGui.DialogApp.Dialog.ThemeColorDialog.Info:FindFirstChild("Response")
    if b3 then
        local children = b3:GetChildren()
        if #children >= 8 then
            table.insert(buttons, children[8])
        end
    end

    -- 4. ExitButton
    local b4 = PlayerGui:FindFirstChild("DialogApp")
        and PlayerGui.DialogApp:FindFirstChild("ExitButton")
    if b4 then table.insert(buttons, b4) end

    return buttons
end

local function clickButton(button)
    if firesignal then
        firesignal(button.Activated)
        firesignal(button.MouseButton1Down)
        task.wait(0.05)
        firesignal(button.MouseButton1Up)
        firesignal(button.MouseButton1Click)
    else
        button.MouseButton1Click:Fire()
        button.Activated:Fire()
    end
    print("Clicked: " .. button:GetFullName())
end

while task.wait(0.5) do
    pcall(function()
        for _, button in ipairs(getButtons()) do
            if button:IsA("GuiButton") and button.Visible and button.Active then
                clickButton(button)
                task.wait(1)
            end
        end
    end)
end
