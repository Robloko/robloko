-- ================= STATUS / LOG =================
local ui = {}
local uiLog = nil
local status = { now = "Ready", goal = "Pick an action", queue = {} }

local function renderStatus()
    if ui.now then
        pcall(function()
            ui.now.Text = status.now
            ui.goal.Text = status.goal
            ui.queue.Text = #status.queue > 0 and ("Next: " .. table.concat(status.queue, "\n         ")) or ""
        end)
    end
end

local function setGoal(text, queue)
    status.goal = text or ""
    status.queue = queue or {}
    renderStatus()
end

local function setNow(text)
    status.now = text or ""
    renderStatus()
end

local function say(text, tone)
    setNow(text)
    if uiLog then pcall(uiLog, tone or "info", text) end
    print("[COCOON] " .. tostring(text))
end

-- ================= SERVER COUNTERS =================
local function countPlayers()
    local n = 0
    for _ in Players:GetPlayers() do n += 1 end
    return n
end

local function countPets()
    local petsFolder = workspace:FindFirstChild("Pets")
    if not petsFolder then return 0 end
    local n = 0
    for _ in petsFolder:GetChildren() do n += 1 end
    return n
end

local function otherPlayers()
    local list = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player then table.insert(list, p) end
    end
    return list
end

local function petsOnServer()
    local petsFolder = workspace:FindFirstChild("Pets")
    if not petsFolder then return {} end
    return petsFolder:GetChildren()
end

-- ================= API HELPERS =================
local function api(name)
    return ReplicatedStorage:WaitForChild("API"):FindFirstChild(name)
end

local function callAPI(name, args, fire)
    local node = api(name)
    if not node then
        say("API missing: " .. name, "bad")
        return false
    end
    local ok, err = pcall(function()
        if fire then node:FireServer(unpack(args)) else node:InvokeServer(unpack(args)) end
    end)
    if not ok then say("Call failed " .. name .. ": " .. tostring(err), "bad") end
    return ok
end

-- ================= BUTTON 1: CREATE FAMILY + INVITE ALL =================
local FamilyMode = false

local function createFamilyAndInvite()
    FamilyMode = true
    say("Creating family...", "info")
    local args = FAMILY_NAME and { FAMILY_NAME } or {}
    local created = callAPI("FamilyAPI/CreateFamily", args)
    if not created then
        say("Family creation failed (maybe already in a family?)", "bad")
        FamilyMode = false
        return
    end
    say("Family created. Inviting everyone...", "ok")
    task.wait(1)

    local targets = otherPlayers()
    setGoal("Inviting " .. #targets .. " player(s)", {})
    for i, p in ipairs(targets) do
        if not FamilyMode then break end
        setGoal("Inviting " .. #targets .. " player(s)", { p.Name })
        callAPI("FamilyAPI/InvitePlayer", { p })
        say("Family invite -> " .. p.Name, "ok")
        task.wait(INVITE_DELAY)
    end
    say("Family invite pass finished", "ok")
    FamilyMode = false
end

-- ================= BUTTON 2: DO ALL TASKS =================
local TasksMode = false

local function runPetTask(pet, task)
    setGoal("Pet task: " .. task.label, { pet.Name or "Pet" })
    callAPI(task.api, task.args(pet), task.fire)
    task.wait(ACTION_DELAY)
end

local function runBabyTask(char, task)
    setGoal("Baby task: " .. task.label, { char.Name or "Baby" })
    callAPI(task.api, task.args(char), false)
    task.wait(ACTION_DELAY)
end

local function holdAndEject(character)
    setGoal("Hold + eject baby", { character.Name or "Baby" })
    callAPI("AdoptAPI/HoldBaby", { character }, false)
    task.wait(ACTION_DELAY)
    callAPI("AdoptAPI/EjectBaby", { character }, true)
    task.wait(ACTION_DELAY)
end

local function doAllTasksOnce()
    -- 1. Players: baby care + hold/eject
    local targets = otherPlayers()
    say("Players found: " .. #targets, "info")
    for _, p in ipairs(targets) do
        if not TasksMode then return false end
        local char = p.Character
        if char then
            say("Handling player: " .. p.Name, "info")
            holdAndEject(char)
            for _, task in ipairs(BABY_TASKS) do
                runBabyTask(char, task)
            end
        else
            say("No character for " .. p.Name, "warn")
        end
        task.wait(ACTION_DELAY)
    end

    -- 2. Pets: full care chain
    local pets = petsOnServer()
    say("Pets found: " .. #pets, "info")
    for _, pet in ipairs(pets) do
        if not TasksMode then return false end
        say("Handling pet: " .. (pet.Name or "Pet"), "info")
        for _, task in ipairs(PET_TASKS) do
            if not TasksMode then return false end
            runPetTask(pet, task)
        end
        task.wait(PET_LOOP_GAP)
    end
    return true
end

local function startAllTasks()
    TasksMode = true
    while TasksMode do
        setGoal("Running task pass on all players + pets", {})
        local ok = doAllTasksOnce()
        if not ok then break end
        say("Task pass complete. Repeating in 5 s...", "ok")
        task.wait(5)
    end
    say("Task loop stopped", "warn")
end

