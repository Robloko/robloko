    local petsLabel = text(statsBg, (width - 16) / 2 + 3, 3, (width - 26) / 2, 16, "🐾 Pets: 0", 12, THEME.ok, true)

    task.spawn(function()
        while frame.Parent do
            pcall(function()
                playersLabel.Text = "👥 Players: " .. countPlayers()
                petsLabel.Text = "🐾 Pets: " .. countPets()
            end)
            task.wait(1.5)
        end
    end)

    -- ============ STATUS ============
    text(frame, 8, 57, 26, 13, "Now", 10, THEME.accent, true)
    ui.now = text(frame, 34, 57, width - 42, 13, status.now, 11, THEME.text, true)
    ui.goal = text(frame, 8, 72, width - 16, 12, status.goal, 10, THEME.dim)
    local logBox = create("TextLabel", { Position = UDim2.fromOffset(8, 86), Size = UDim2.fromOffset(width - 16, 40),
        BackgroundTransparency = 1, Text = "", RichText = true, TextColor3 = THEME.dim, Font = Enum.Font.Gotham, TextSize = 10,
        TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, TextWrapped = false,
        ClipsDescendants = true }, frame)
    renderStatus()
    local shown = {}
    local TONES = { ok = "#5ac878", bad = "#e65a5a", warn = "#d6a046", info = "#9a9aae" }
    uiLog = function(tone, message)
        local safe = string.gsub(string.gsub(string.gsub(tostring(message), "&", "&amp;"), "<", "&lt;"), ">", "&gt;")
        table.insert(shown, '<font color="' .. (TONES[tone] or TONES.info) .. '">' .. safe .. "</font>")
        while #shown > 3 do table.remove(shown, 1) end
        logBox.Text = table.concat(shown, "\n")
    end
    create("Frame", { Position = UDim2.fromOffset(8, 129), Size = UDim2.new(1, -16, 0, 1), BackgroundColor3 = THEME.line,
        BorderSizePixel = 0 }, frame)

    -- ============ BUTTONS ============
    local famBtn = toggleButton(frame, 8, 140, width - 16, "CREATE FAMILY + INVITE ALL [OFF]", THEME.fam, function(b)
        if FamilyMode then
            FamilyMode = false
            b.Text = "CREATE FAMILY + INVITE ALL [OFF]"
            b.BackgroundColor3 = THEME.fam
            say("Family builder stopped", "warn")
            return
        end
        b.Text = "CREATE FAMILY + INVITE ALL [ON]"
        b.BackgroundColor3 = THEME.ok
        task.spawn(createFamilyAndInvite)
        task.spawn(function()
            while FamilyMode and frame.Parent do task.wait(0.5) end
            if b.Parent then
                b.Text = "CREATE FAMILY + INVITE ALL [OFF]"
                b.BackgroundColor3 = THEME.fam
            end
        end)
    end)

    local taskBtn = toggleButton(frame, 8, 178, width - 16, "DO ALL TASKS (PLAYERS + PETS) [OFF]", THEME.task, function(b)
        if TasksMode then
            TasksMode = false
            b.Text = "DO ALL TASKS (PLAYERS + PETS) [OFF]"
            b.BackgroundColor3 = THEME.task
            say("Task runner stopped", "warn")
            return
        end
        b.Text = "DO ALL TASKS (PLAYERS + PETS) [ON]"
        b.BackgroundColor3 = THEME.ok
        task.spawn(startAllTasks)
        task.spawn(function()
            while TasksMode and frame.Parent do task.wait(0.5) end
            if b.Parent then
                b.Text = "DO ALL TASKS (PLAYERS + PETS) [OFF]"
                b.BackgroundColor3 = THEME.task
            end
        end)
    end)

    text(frame, 8, 216, width - 16, 14, "Players = hold/eject/dirty/bored", 10, THEME.dim)
    text(frame, 8, 230, width - 16, 14, "Pets = dirty/food/drink/toilet/sleep/bored/hold/eject", 10, THEME.dim)
    text(frame, 8, 248, width - 16, 14, "Targets: every player on server (not you)", 10, THEME.dim)
    create("Frame", { Position = UDim2.fromOffset(8, 268), Size = UDim2.new(1, -16, 0, 1), BackgroundColor3 = THEME.line,
        BorderSizePixel = 0 }, frame)
    text(frame, 8, 274, width - 16, 14, "COCOON v2 — family / pet / baby automation", 10, THEME.dim)
end

