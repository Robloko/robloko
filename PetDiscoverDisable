wait(10)
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

local function clickDoneButton()
    local button = PlayerGui:FindFirstChild("PetDiscoveryApp")
        and PlayerGui.PetDiscoveryApp:FindFirstChild("Frame")
        and PlayerGui.PetDiscoveryApp.Frame:FindFirstChild("NewPetsPage")
        and PlayerGui.PetDiscoveryApp.Frame.NewPetsPage:FindFirstChild("FooterButtons")
        and PlayerGui.PetDiscoveryApp.Frame.NewPetsPage.FooterButtons:FindFirstChild("Done")
        and PlayerGui.PetDiscoveryApp.Frame.NewPetsPage.FooterButtons.Done:FindFirstChild("DepthButton")

    if button then
        if button.Visible and button.Active and button:IsA("GuiButton") then

            if firesignal then
                firesignal(button.MouseButton1Down)
                task.wait(0.05)
                firesignal(button.MouseButton1Up)
                firesignal(button.MouseButton1Click)
                print("Successfully clicked Done!")
            else
                button.MouseButton1Click:Fire()
                print("Successfully clicked Done!")
            end

            task.wait(2)
        end
    end
end

while task.wait(0.5) do
    pcall(clickDoneButton)
end
