-- ================= TRADE LICENSE (from cocoon2.txt) =================
local function hasLicense()
    return itemsOf("toys", { trade_license = true })[1] ~= nil
end

local function inLicenseZone()
    local data = getPlayerData()
    local wrapper = data and data.char_wrapper_raw
    local location = type(wrapper) == "table" and type(wrapper.location) == "table" and wrapper.location
    return type(location) == "table" and location.destination_id == "TradeLicenseZone"
end

-- fires a game remote; a RemoteFunction is waited on for at most 10 s
local function send(remoteName, ...)
    local remote = ReplicatedStorage:WaitForChild("API"):FindFirstChild(remoteName)
    if not remote then
        return false
    end
    local args = table.pack(...)
    if not remote:IsA("RemoteFunction") then
        return pcall(function() remote:FireServer(table.unpack(args, 1, args.n)) end)
    end
    local finished = false
    task.spawn(function()
        pcall(function() remote:InvokeServer(table.unpack(args, 1, args.n)) end)
        finished = true
    end)
    waitUntil(function() return finished end, 10)
    return true
end

-- Takes the Trade License test. Returns nil when the license is there, else false + why.
local function getLicense()
    if hasLicense() then
        return nil
    end
    local reported = ReplicatedStorage:WaitForChild("API"):FindFirstChild("TradeAPI/QuizAnswerReported")
    if not reported then
        return false, "quiz remote not found"
    end
    local reports = {}
    local connection = reported.OnClientEvent:Connect(function(correct, finished, index)
        table.insert(reports, { correct = correct, finished = finished })
    end)
    local function finish(...)
        connection:Disconnect()
        return ...
    end
    if not inLicenseZone() then
        say("Heading to the Trade License booth...")
        if not interiorsM then
            pcall(function()
                interiorsM = require(ReplicatedStorage.ClientModules.Core.InteriorsM.InteriorsM)
            end)
        end
        if not interiorsM then
            return finish(false, "travel module not found")
        end
        task.spawn(pcall, interiorsM.enter, "TradeLicenseZone", "MainDoor", {})
        if not waitUntil(inLicenseZone, ARRIVAL_TIMEOUT) then
            return finish(false, "could not reach the Trade License booth")
        end
        task.wait(2)
    end
    local function quiz()
        local data = getPlayerData()
        local manager = data and data.trade_license_quiz_manager
        return type(manager) == "table" and type(manager.quiz) == "table" and manager or nil
    end
    if not quiz() then
        send("TradeAPI/BeginQuiz")
    end
    if not waitUntil(function() return quiz() ~= nil end, 15) then
        return finish(false, "the quiz did not start")
    end
    local lastIndex = 0
    for _ = 1, 8 do
        if hasLicense() then
            break
        end
        waitUntil(function()
            local now = quiz()
            return now == nil or (tonumber(now.question_index) or 1) > lastIndex
        end, 5)
        local manager = quiz()
        if not manager then
            break
        end
        local index = math.max(tonumber(manager.question_index) or 1, lastIndex + 1)
        lastIndex = index
        local question = manager.quiz[index] or manager.quiz[tostring(index)]
        if type(question) ~= "table" or (question.answer ~= "safe" and question.answer ~= "not safe") then
            return finish(false, "no answer for question " .. index)
        end
        task.wait(2)
        say("Question " .. index .. ": " .. (question.answer == "safe" and "Safe!" or "Not safe!"))
        local before = #reports
        send("TradeAPI/AnswerQuizQuestion", question.answer)
        if not waitUntil(function() return #reports > before end, 10) then
            return finish(false, "no answer from the server")
        end
        if reports[#reports].correct ~= true then
            return finish(false, "wrong answer (a new quiz next time)")
        end
        if reports[#reports].finished == true then
            break
        end
    end
    if waitUntil(hasLicense, 10) then
        send("TradeAPI/EndQuiz")
        return finish(nil)
    end
    return finish(false, "no license yet")
end

-- ================= POTION RELEASER =================
local function findPetAgePotion()
    local data = getPlayerData()
    if data and data.inventory and data.inventory.food then
        for uniqueId, itemData in pairs(data.inventory.food) do
            if itemData.id == "pet_age_potion" then
                return uniqueId
            end
        end
    end
    return nil
end

local function safelyUnequipFood(itemId)
    pcall(function()
        ReplicatedStorage:WaitForChild("API"):WaitForChild("ToolAPI/Unequip"):InvokeServer(itemId)
    end)
end

local function equipTool(itemId)
    local ok = pcall(function()
        ReplicatedStorage:WaitForChild("API"):WaitForChild("ToolAPI/Equip"):InvokeServer(itemId, {
            use_sound_delay = true,
            equip_as_last = false
        })
    end)
    return ok
end

local function findPetsNeedingPotions()
    local petsNeedingPotions = {}
    local data = getPlayerData()
    if data and data.inventory and data.inventory.pets then
        for petUniqueId, petData in pairs(data.inventory.pets) do
            if petData.id and petData.properties then
                local petName = string.lower(petData.id)
                local petAge = petData.properties.age or 0
                for _, targetPet in ipairs(TARGET_PETS_FOR_POTIONS) do
                    if petName == targetPet and petAge < POTION_TARGET_AGE then
                        table.insert(petsNeedingPotions, {
                            uid = petUniqueId,
                            name = petData.id,
                            age = petAge,
                        })
                        break
                    end
                end
            end
        end
    end
    table.sort(petsNeedingPotions, function(a, b)
        return a.age < b.age
    end)
    return petsNeedingPotions
end

local function getPetAge(petUniqueId)
    local data = getPlayerData()
    if data and data.inventory and data.inventory.pets then
        for uid, petData in pairs(data.inventory.pets) do
            if uid == petUniqueId or petData.unique == petUniqueId then
                return petData.properties and petData.properties.age or 0, petData.id or "Unknown"
            end
        end
    end
    return nil, nil
end

local function usePotionOnPet(petUniqueId)
    local currentAge, petName = getPetAge(petUniqueId)
    if not currentAge or currentAge >= POTION_TARGET_AGE then
        say("Pet no longer needs potion: " .. tostring(petName), "warn")
        return false
    end

    if not equipTool(petUniqueId) then
        say("Failed to equip pet: " .. tostring(petName), "bad")
        return false
    end
    say("Equipped pet: " .. tostring(petName))
    task.wait(1)

    local potionId = findPetAgePotion()
    if not potionId then
        say("No potions found!", "bad")
        return false
    end
    if not equipTool(potionId) then
        say("Failed to equip potion", "bad")
        return false
    end
    task.wait(1)

    local startOk = pcall(function()
        ReplicatedStorage:WaitForChild("API"):WaitForChild("ToolAPI/ServerUseTool"):InvokeServer(potionId, "START")
    end)
    if not startOk then
        safelyUnequipFood(potionId)
        say("Failed to start using potion", "bad")
        return false
    end
    task.wait(1)

    local consumeOk = pcall(function()
        ReplicatedStorage:WaitForChild("API"):WaitForChild("PetObjectAPI/CreatePetObject"):InvokeServer(
            "__Enum_PetObjectCreatorType_2",
            {
                additional_consume_uniques = {},
                pet_unique = petUniqueId,
                unique_id = potionId,
            }
        )
    end)
    if not consumeOk then
        safelyUnequipFood(potionId)
        say("Failed to create pet object for consumption", "bad")
        return false
    end

    say("Waiting 9 s for potion to feed " .. tostring(petName) .. "...")
    local startTime = tick()
    repeat
        task.wait(0.1)
    until tick() - startTime >= 9
    say("Potion feed complete for " .. tostring(petName), "ok")

    safelyUnequipFood(potionId)
    return true
end

local function startPotionReleaser()
    while PotionMode do
        local petsNeedingPotions = findPetsNeedingPotions()
        if #petsNeedingPotions == 0 then
            say("No pets need potions. Waiting 30 s...", "warn")
            task.wait(30)
            continue
        end
        if not findPetAgePotion() then
            say("No potions available", "bad")
            task.wait(30)
            continue
        end

        say(#petsNeedingPotions .. " pets need potions")
        for _, petData in ipairs(petsNeedingPotions) do
            if not PotionMode then
                break
            end
            local currentAge = getPetAge(petData.uid)
            if currentAge and currentAge >= POTION_TARGET_AGE then
                say(petData.name .. " no longer needs potion (age: " .. currentAge .. ")", "warn")
