    end
    say("No trade license: taking the test (try " .. attempt .. " of 2)", "warn")
    local ok, result, why = pcall(getLicense)
    if hasLicense() then
        say("Trade license obtained", "ok")
    else
        say("Trade license failed: " .. tostring(ok and why or result), "bad")
    end
end

mainWindow()
say("Loaded. Targets: " .. table.concat(TARGET_PLAYER_NAMES, ", "), "ok")
