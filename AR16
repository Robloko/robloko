            local hit = workspace:Raycast(Vector3.new(x, origin.Y + 6, z), Vector3.new(0, -30, 0), rayParams)
            if not (hit and hit.Instance and hit.Instance.CanCollide) then
                return nil
            end
            local stand = Vector3.new(x, hit.Position.Y + hip + 0.3, z)
            -- the body: from just above the floor to the head
            local parts = workspace:GetPartBoundsInBox(CFrame.new(stand + Vector3.new(0, 0.5, 0)), Vector3.new(2.5, 4.5, 2.5),
                boxParams)
            for _, part in ipairs(parts) do
                if part.CanCollide then
                    return nil
                end
            end
            return stand
        end
        for _, radius in ipairs({ 4, 8, 12 }) do
            for step = 0, 7 do
                local angle = step * math.pi / 4
                local spot = freeAt(origin.X + math.cos(angle) * radius, origin.Z + math.sin(angle) * radius)
                if spot then
                    local moved = pcall(function()
                        root.AssemblyLinearVelocity = Vector3.zero
                        root.AssemblyAngularVelocity = Vector3.zero
                        character:PivotTo(CFrame.new(spot))
                        humanoid:ChangeState(Enum.HumanoidStateType.Landed)
                    end)
                    if moved then
                        return radius
                    end
                end
            end
        end
        return nil
    end
    function Interaction.settle(maxWait)
        local player = game:GetService("Players").LocalPlayer
        local character = player and player.Character
        local root = character and character:FindFirstChild("HumanoidRootPart")
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        if not (root and humanoid) then
            return "no character"
        end
        if humanoid.Sit or humanoid.SeatPart then
            return "ok"
        end
        local floor = floorUnder(root, character)
        if not floor and (tonumber(maxWait) or 0) > 0 then
            local wasAnchored = root.Anchored
            pcall(function()
                root.Anchored = true
            end)
            task.spawn(pcall, function()
                player:RequestStreamAroundAsync(root.Position, 2)
            end)
            local untilAt = os.clock() + maxWait
            while not floor and os.clock() < untilAt and root.Parent do
                task.wait(0.1)
                floor = floorUnder(root, character)
            end
            if not wasAnchored then
                pcall(function()
                    root.Anchored = false
                end)
            end
        end
        if not floor then
            return "no floor"
        end
        local stand = floor + (humanoid.HipHeight or 2) + root.Size.Y * 0.5
        local lifted = false
        if root.Position.Y < stand - 1.2 then
            lifted = pcall(function()
                root.AssemblyLinearVelocity = Vector3.zero
                root.AssemblyAngularVelocity = Vector3.zero
                local look = root.CFrame.LookVector * Vector3.new(1, 0, 1)
                local at = Vector3.new(root.Position.X, stand + 0.5, root.Position.Z)
                character:PivotTo(look.Magnitude > 0.1 and CFrame.lookAt(at, at + look) or CFrame.new(at))
            end)
        end
        pcall(function()
            local state = humanoid:GetState()
            if state == Enum.HumanoidStateType.FallingDown or state == Enum.HumanoidStateType.Ragdoll or lifted then
                humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
            end
        end)
        return lifted and "lifted" or "ok"
    end
    function Interaction:keepNear(provider)
        local stats = { corrections = 0 }
        local running = true
        local players = game:GetService("Players")
        local function myRoot()
            local character = players.LocalPlayer.Character
            return character and character:FindFirstChild("HumanoidRootPart"), character
        end
        local startRoot = myRoot()
        local startSpot = startRoot and startRoot.Position or nil
        local lastSpot = nil
        local released = false
        local function hold(spot)
            local root, character = myRoot()
            if not root or released then
                return
            end
            local here = root.Position
            local fx, fy, fz = here.X - spot.X, here.Y - spot.Y, here.Z - spot.Z
            if fx * fx + fy * fy + fz * fz > 250 * 250 then
                released = true
                return
            end
            pcall(function()
                root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            end)
            local now = root.Position
            local dx, dy, dz = now.X - spot.X, now.Y - spot.Y, now.Z - spot.Z
            if dx * dx + dy * dy + dz * dz <= 1 then
                return
            end
            if pcall(function()
                character:PivotTo(CFrame.new(spot.X, spot.Y, spot.Z))
            end) then
                stats.corrections += 1
            end
        end
        local function step()
            local position, mode = provider()
            if position == false then
                released = true
                return
            end
            if position ~= nil and type(position.X) == "number" and type(position.Y) == "number" and type(position.Z) == "number" then
                if mode == "below" then
                    lastSpot = Vector3.new(position.X, position.Y - GameConstants.Event.HoldBelowStuds, position.Z)
                else
                    local root = myRoot()
                    local from = root and root.Position or position
                    local off = tonumber(mode) or 10
                    local dx, dz = from.X - position.X, from.Z - position.Z
                    local length = math.sqrt(dx * dx + dz * dz)
                    local x = length > 0.1 and position.X + dx / length * off or position.X + off
                    local z = length > 0.1 and position.Z + dz / length * off or position.Z
                    lastSpot = Vector3.new(x, startSpot and startSpot.Y or from.Y, z)
                end
            end
            if lastSpot then
                hold(lastSpot)
            end
        end
        local connection
        local okSignal = pcall(function()
            connection = game:GetService("RunService").Heartbeat:Connect(function()
                if running then
                    step()
                end
            end)
        end)
        if not okSignal or not connection then
            task.spawn(function()
                while running do
                    step()
                    task.wait(0.05)
                end
            end)
        end
        local function stop(back)
            if not running then
                return
            end
            running = false
            if connection then
                connection:Disconnect()
                connection = nil
            end
            local root, character = myRoot()
            local stillHeld = false
            if root and lastSpot and not released then
                local here = root.Position
                local dx, dy, dz = here.X - lastSpot.X, here.Y - lastSpot.Y, here.Z - lastSpot.Z
                stillHeld = dx * dx + dy * dy + dz * dz <= 30 * 30
            end
            if back ~= false and stillHeld and startSpot then
                pcall(function()
                    root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                    character:PivotTo(CFrame.new(startSpot.X, startSpot.Y + 2, startSpot.Z))
                end)
            end
        end
        return stop, stats, step
    end
    function Interaction:releaseAnchor(root, character, reason)
        if not root or not root.Anchored then
            return true
        end
        local below
        pcall(function()
            local params = RaycastParams.new()
            params.FilterType = Enum.RaycastFilterType.Exclude
            params.FilterDescendantsInstances = { character }
            local hit = workspace:Raycast(root.Position, Vector3.new(0, -25, 0), params)
            below = hit and hit.Position
        end)
        if not below then
            self._logger:debug("Action", "Root anchored, no ground under it yet: leaving it")
            return false
        end
        local ok = pcall(function()
            root.Anchored = false
        end)
        self._logger:info("Action", "My character was left anchored by the game (" .. tostring(reason) .. "): released it"
            .. (ok and "" or " (failed)"))
        return ok and not root.Anchored
    end
    function Interaction:walkAround(seconds, done, tick)
        local character = game:GetService("Players").LocalPlayer.Character
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        local root = character and character:FindFirstChild("HumanoidRootPart")
        if not humanoid or not root then
            return false
        end
        self._logger:debug("Action", "Walking long diagonal legs for up to " .. seconds .. " s")
        if root.Anchored then
            local waited = 0
            while root.Anchored and waited < 3 do
                task.wait(0.5)
                waited += 0.5
            end
            self:releaseAnchor(root, character, "before walking")
        end
        local start = root.Position
        local fx, fz = 0, -1
        pcall(function()
            local look = root.CFrame.LookVector
            local length = math.sqrt(look.X * look.X + look.Z * look.Z)
            if length > 0.1 then
                fx, fz = look.X / length, look.Z / length
            end
        end)
        local rx, rz = -fz, fx
        local LEG = 30
        local points = {
            Vector3.new(start.X + (fx - rx) * LEG, start.Y, start.Z + (fz - rz) * LEG),
            Vector3.new(start.X + (fx + rx) * LEG, start.Y, start.Z + (fz + rz) * LEG),
            Vector3.new(start.X, start.Y, start.Z),
        }
        local elapsed, index = 0, 0
        while elapsed < seconds do
            if done() then
                return true
            end
            index = index % #points + 1
            local target = points[index]
            local legTime, still, last = 0, 0, root.Position
            while legTime < 5 and elapsed < seconds do
                humanoid:MoveTo(target)
                task.wait(0.5)
                legTime += 0.5
                elapsed += 0.5
                if tick then
                    tick()
                end
                if done() then
                    return true
                end
                local p = root.Position
                if math.sqrt((p.X - target.X) ^ 2 + (p.Z - target.Z) ^ 2) < 4 then
                    break
                end
                if math.sqrt((p.X - last.X) ^ 2 + (p.Z - last.Z) ^ 2) < 0.5 then
                    still += 0.5
                    if still == 1 then
                        local diag = {}
                        pcall(function()
                            table.insert(diag, "anchored=" .. tostring(root.Anchored))
                            table.insert(diag, "sit=" .. tostring(humanoid.Sit))
                            table.insert(diag, "platformStand=" .. tostring(humanoid.PlatformStand))
                            table.insert(diag, "walkSpeed=" .. tostring(humanoid.WalkSpeed))
                            table.insert(diag, "state=" .. tostring(humanoid:GetState()))
                        end)
                        self.walkDiag = table.concat(diag, " ")
                        self:releaseAnchor(root, character, "while walking")
                        pcall(function()
                            if humanoid.Sit then
                                humanoid.Sit = false
                            end
                            if humanoid.PlatformStand then
                                humanoid.PlatformStand = false
                            end
                            local dx, dz = target.X - p.X, target.Z - p.Z
                            local length = math.sqrt(dx * dx + dz * dz)
                            if length > 0.1 then
                                humanoid:Move(Vector3.new(dx / length, 0, dz / length), false)
                            end
                        end)
                    elseif still >= 2.5 then
                        break
                    end
                else
                    still = 0
                    self.walkDiag = nil
                end
                last = p
            end
        end
        return done()
    end
    function Interaction:moveTo(spotName)
        local spot = GameConstants.Spots[spotName]
        if not spot then
            error("Interaction: spot is not in the allowlist: " .. tostring(spotName), 2)
        end
        local character = game:GetService("Players").LocalPlayer.Character
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        local root = character and character:FindFirstChild("HumanoidRootPart")
        if not humanoid or not root then
            return false, "no character"
        end
        self._sent += 1
        self._state:set("farm.actionsSent", self._sent, "Interaction")
        local waited = 0
        while root.Anchored and waited < 10 do
            task.wait(0.5)
            waited += 0.5
        end
        local target = Vector3.new(spot.x, spot.y, spot.z)
        local function distance()
            local p = root.Position
            return math.sqrt((p.X - spot.x) ^ 2 + (p.Z - spot.z) ^ 2)
        end
        local function walkTo(point, limit)
            humanoid:MoveTo(point)
            local t = 0
            while t < limit do
                task.wait(0.25)
                t += 0.25
                local p = root.Position
                if math.sqrt((p.X - point.X) ^ 2 + (p.Z - point.Z) ^ 2) < 4 then
                    return true
                end
            end
            return false
        end
        self._logger:debug("Action", string.format("Walking to %s (%.0f, %.0f), %.0f studs", spotName, spot.x, spot.z, distance()))
        local waypoints
        pcall(function()
            local path = game:GetService("PathfindingService"):CreatePath({ AgentCanJump = true })
            path:ComputeAsync(root.Position, target)
            if path.Status == Enum.PathStatus.Success then
                waypoints = path:GetWaypoints()
            end
        end)
        local started = os.clock()
        if waypoints then
            for _, waypoint in ipairs(waypoints) do
                if waypoint.Action == Enum.PathWaypointAction.Jump then
                    humanoid.Jump = true
                end
                walkTo(waypoint.Position, 4)
                if os.clock() - started > 90 then
                    break
                end
            end
        else
            self._logger:debug("Action", "No path found: walking straight")
            for _ = 1, 12 do
                if walkTo(target, 8) or distance() < 10 then
                    break
                end
            end
        end
        if distance() < 15 then
            return true
        end
        return false, string.format("could not walk there (still %.0f studs away)", distance())
    end
    local function describeArgs(...)
        local parts = {}
        for index = 1, select("#", ...) do
            local value = select(index, ...)
            if typeof(value) == "Instance" then
                table.insert(parts, "<" .. value.Name .. ">")
            elseif type(value) == "table" then
                table.insert(parts, "{...}")
            else
                table.insert(parts, tostring(value))
            end
        end
        return table.concat(parts, ", ")
    end
    --[[
        v3.0.75: the house calls (Box Lure, Transfer Thingy) only in the exact shapes of the user's recorded calls:
        lure          (me, "<furniture>", "UseBlock", { bait_unique = "<item>" } | false, my character)
        price         (me, "<furniture>", "UseBlock", { price = 100, set_price = true }, my character)
        buyMannequin  ({ { kind = "mannequins_2024_mannequin", properties = { cframe = <CFrame> } } })
        buyOutfit     (<another player>, "<furniture>", "<outfit version>", <price 1..Farm.Transfer.MaxOutfitPrice>)
        deleteOutfit  ("player", "<name>", nil)
        pay           (<another player>, "<furniture>", "UseBlock", 50, my character)
    ]]
    Interaction.maxOutfitPrice = 100
    function Interaction.isCFrame(value)
        local kind = typeof(value)
        return kind == "CFrame"
    end
    function Interaction.checkHouseCall(kind, n, a, b, c, d, e)
        local Players = game:GetService("Players")
        local me = Players.LocalPlayer
        local H = GameConstants.House
        local function onlyKeys(t, keys)
            if type(t) ~= "table" then
                return false
            end
            for k in pairs(t) do
                if keys[k] == nil then
                    return false
                end
            end
            return true
        end
        local function furnitureKey(v)
            return type(v) == "string" and v ~= "" and #v <= 64
        end
        local function otherPlayer(v)
            local kind = typeof(v)
            return kind == "Instance" and v:IsA("Player") and v ~= me and v.Parent == Players
        end
        if kind == "lure" then
            local baitOk = d == false or (onlyKeys(d, { bait_unique = true }) and type(d.bait_unique) == "string" and d.bait_unique ~= "")
            if n == 5 and a == me and furnitureKey(b) and c == H.LureUseBlock and baitOk and e == me.Character then
                return true
            end
            return "not the recorded Box Lure call"
        elseif kind == "price" then
            if n == 5 and a == me and furnitureKey(b) and c == "UseBlock" and onlyKeys(d, { price = true, set_price = true })
                and d.price == H.SalePrice and d.set_price == true and e == me.Character then
                return true
            end
            return "not the recorded price call"
        elseif kind == "buyMannequin" then
            local entry = type(a) == "table" and a[1]
            if n == 1 and type(a) == "table" and #a == 1 and onlyKeys(entry, { kind = true, properties = true })
                and entry.kind == H.MannequinKind and onlyKeys(entry.properties, { cframe = true })
                and Interaction.isCFrame(entry.properties.cframe) then
                return true
            end
            return "only one mannequin (" .. H.MannequinKind .. ") per call"
        elseif kind == "buyLure" then
            local entry = type(a) == "table" and a[1]
            if n == 1 and type(a) == "table" and #a == 1 and onlyKeys(entry, { kind = true, properties = true })
                and entry.kind == H.LureKind and onlyKeys(entry.properties, { cframe = true })
                and Interaction.isCFrame(entry.properties.cframe) then
                return true
            end
            return "only one Box Lure (" .. H.LureKind .. ") per call"
        elseif kind == "buyOutfit" then
            if n == 4 and otherPlayer(a) and furnitureKey(b) and type(c) == "string" and #c >= 8 and #c <= 64
                and type(d) == "number" and d >= 1 and d <= Interaction.maxOutfitPrice and d == math.floor(d) then
                return true
            end
            return "not a mannequin purchase within Farm.Transfer.MaxOutfitPrice"
        elseif kind == "deleteOutfit" then
            if n == 3 and a == "player" and type(b) == "string" and b ~= "" and c == nil then
                return true
            end
            return "not the recorded outfit delete"
        elseif kind == "pay" then
            if n == 5 and otherPlayer(a) and furnitureKey(b) and c == "UseBlock" and d == H.PayAmount and e == me.Character then
                return true
            end
            return "not the recorded Cash Register payment"
        end
        return "unknown house call"
    end
    function Interaction:send(actionName, ...)
        local action = GameConstants.Actions[actionName]
        if not action then
            error("Interaction: action is not in the allowlist: " .. tostring(actionName), 2)
        end
        if action.emptyOnly then
            local first = ...
            if select("#", ...) ~= 1 or type(first) ~= "table" or next(first) ~= nil then
                error("Interaction: " .. actionName .. " may only be sent with an empty table", 2)
            end
        end
        if action.maxArgs and select("#", ...) > action.maxArgs then
            error("Interaction: " .. actionName .. " is sent with at most " .. action.maxArgs .. " argument(s)", 2)
        end
        if action.allowedFirstArg then
            local first = ...
            if not action.allowedFirstArg[first] then
                error("Interaction: " .. actionName .. " may not be sent with " .. tostring(first), 2)
            end
        end
        if action.leaveOnly then
            local first, second = ...
            if select("#", ...) ~= 2 or type(first) ~= "string" or string.sub(first, 1, 15) ~= "ghost_clusters:" or second ~= false then
                error("Interaction: " .. actionName .. " may only be sent as (\"ghost_clusters::<id>\", false)", 2)
            end
        end
        if action.allowedMessages then
            local _, message = ...
            if not action.allowedMessages[message] then
                error("Interaction: " .. actionName .. " may not send message " .. tostring(message), 2)
            end
        end
        if action.recordedArgs then
            -- only the arguments copied from a recorded manual install (GameConstants.Event.SkelicornArgs)
            local recorded = type(GameConstants.Event.SkelicornArgs) == "table" and GameConstants.Event.SkelicornArgs[action.recordedArgs]
            if type(recorded) ~= "table" then
                error("Interaction: " .. actionName .. " has no recorded arguments yet", 2)
            end
            local function match(want, got, depth)
                if want == "$LEVER" then -- the lever's unique id: different for every player
                    return type(got) == "string" and got ~= ""
                end
                if type(want) == "table" and type(got) == "table" and depth < 3 then
                    for k, v in pairs(want) do
                        if not match(v, got[k], depth + 1) then
                            return false
                        end
                    end
                    for k in pairs(got) do
                        if want[k] == nil then
                            return false
                        end
                    end
                    return true
                end
                return want == got
            end
            local n = select("#", ...)
            local same = n == #recorded
            for i = 1, n do
                if not match(recorded[i], (select(i, ...)), 0) then
                    same = false
                end
            end
            if not same then
                error("Interaction: " .. actionName .. " may only be sent with the recorded arguments", 2)
            end
        end
        if action.noArgs and select("#", ...) ~= 0 then
            error("Interaction: " .. actionName .. " is sent without arguments", 2)
        end
        if action.joinPrefix then
            local first, second = ...
            local p = action.joinPrefix
            if type(first) ~= "string" or not (first == p or string.sub(first, 1, #p + 2) == p .. "::") or second ~= true then
                error("Interaction: " .. actionName .. " may only be sent as (\"" .. p .. "[::<id>]\", true)", 2)
            end
        end
        if action.hauntletMessage then
            local sessionId, message, value = ...
            local okSession = type(sessionId) == "string" and string.sub(sessionId, 1, 10) == "hauntlet::"
            local okDoor = message == "try_pick_door" and (value == 1 or value == 2 or value == 3)
            local okItem = message == "try_use_item" and type(value) == "string" and GameConstants.Event.HauntletItems[value] == true
            if select("#", ...) ~= 3 or not okSession or not (okDoor or okItem) then
                error("Interaction: " .. actionName .. " may not send " .. tostring(message) .. " " .. tostring(value), 2)
            end
        end
        if action.petModel then -- v3.0.77: only one pet model (the walk finds MY pet's model)
            local first = ...
            local kind = typeof(first)
            if select("#", ...) ~= 1 or kind ~= "Instance" or not first:IsA("Model") then
                error("Interaction: " .. actionName .. " is sent with one pet model only", 2)
            end
        end
        if action.houseCall then
            local okCheck, why = pcall(Interaction.checkHouseCall, action.houseCall, select("#", ...), ...)
            if not okCheck or why ~= true then
                error("Interaction: " .. actionName .. " refused: " .. tostring(why), 2)
            end
        end
        local folderName = action.folder and GameConstants.Remotes[action.folder] or GameConstants.Remotes.Folder
        local apiFolder = ReplicatedStorage:FindFirstChild(folderName)
        local remote = apiFolder and apiFolder:FindFirstChild(action.remote)
        if not remote then
            self._logger:error("Action", "Remote not found: " .. action.remote)
            return false, "remote not found"
        end
        self._sent += 1
        self._state:set("farm.actionsSent", self._sent, "Interaction")
        self._logger:debug("Action", "Send " .. action.remote .. "(" .. describeArgs(...) .. ")")
        if remote:IsA("RemoteFunction") then
            local finished, callOk, result = false, false, nil
            local args = table.pack(...)
            task.spawn(function()
                callOk, result = pcall(function()
                    return remote:InvokeServer(table.unpack(args, 1, args.n))
                end)
                finished = true
            end)
            local deadline = Util.now() + (action.answersWhenDone and 2 or INVOKE_TIMEOUT_SECONDS)
            while not finished and Util.now() < deadline do
                task.wait(0.1)
            end
            if not finished and action.answersWhenDone then
                return true, "pending"
            end
            if not finished then
                self._logger:warn("Action", action.remote .. " did not answer within " .. INVOKE_TIMEOUT_SECONDS .. " s")
                return false, "no answer from server"
            end
            if not callOk then
                self._logger:warn("Action", action.remote .. " failed: " .. tostring(result))
                return false, tostring(result)
            end
            return true, result
        end
        if remote:IsA("RemoteEvent") then
            local ok, err = pcall(function(...)
                remote:FireServer(...)
            end, ...)
            if not ok then
                self._logger:warn("Action", action.remote .. " failed: " .. tostring(err))
                return false, tostring(err)
            end
            return true
        end
        self._logger:error("Action", action.remote .. " is a " .. remote.ClassName .. ", not a remote")
        return false, "not a remote"
    end
    return Interaction
end
