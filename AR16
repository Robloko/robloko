-- ================= PET RECYCLER =================
local function findPetsToRecycle()
    local toRecycle = {}
    local data = getPlayerData()
    local inPen = penPets()
    if data and data.inventory and data.inventory.pets then
        for petUniqueId, petData in pairs(data.inventory.pets) do
            if petData.id then
                local id = string.lower(petData.id)
                local matched = false
                for _, target in ipairs(TARGET_PETS_FOR_RECYCLE) do
                    if id == target then
                        table.insert(toRecycle, { uid = petUniqueId, name = petData.id })
                        matched = true
                        break
                    end
                end
                -- neon-only targets (neon ant / neon mouse), not mega, not in pen
                local props = petData.properties or {}
                if not matched and props.neon and not props.mega_neon
                    and not (inPen and inPen[petUniqueId]) then
                    for _, target in ipairs(TARGET_NEON_PETS_FOR_RECYCLE) do
                        if id == target then
                            table.insert(toRecycle, { uid = petUniqueId, name = "neon " .. petData.id })
                            break
                        end
                    end
                end
            end
        end
    end
    return toRecycle
end

