-- ================= TRANSFER (ALT -> Main: Cash Register + mannequin outfits) =================
-- The exact calls recorded with SimpleSpy:
--   HousingAPI/ActivateFurniture(<Main>, "<register>", "UseBlock", 50, my character)
--   AvatarAPI/BuyMannequinOutfit(<Main>, "<mannequin>", "<outfit version>", 100)
-- Furniture keys and outfit versions change, so they are read from the Main's house on every trip.
local TRANSFER_MAIN = "Veronnau"
local TRANSFER_PAY = 50          -- one Cash Register payment (the game's max)
local TRANSFER_MAX_OUTFIT = 100  -- a mannequin outfit costing more is never bought
local TRANSFER_PER_WINDOW = 3    -- the game takes 3 per register / mannequin, then rests ~2 min
local TRANSFER_REST = 125
local UUID = "^%x%x%x%x%x%x%x%x%-%x%x%x%x%-%x%x%x%x%-%x%x%x%x%-%x%x%x%x%x%x%x%x%x%x%x%x$"

-- outfit version = a UUID in the mannequin's data (a key named "...version..." wins), price = a number under "price"
local function outfitOf(piece, model)
    local version, price
    local function consider(key, value)
        key = string.lower(tostring(key))
        if type(value) == "string" and string.match(value, UUID) and (version == nil or string.find(key, "version", 1, true)) then
            version = value
        elseif type(value) == "number" and key == "price" then
            price = value
        end
    end
    local function scan(t, depth)
        for key, value in pairs(t) do
            consider(key, value)
            if type(value) == "table" and depth < 3 then
                scan(value, depth + 1)
            end
        end
    end
    if type(piece) == "table" then
        scan(piece, 0)
    end
    pcall(function()
        for key, value in pairs(model:GetAttributes()) do
            consider(key, value)
        end
    end)
    return version, price
end

-- the Main's drawn furniture (holders "<Main>/..."); empty = I am not in the Main's house
local function mainFurniture(main)
    local folder = workspace:FindFirstChild("HouseInteriors")
    folder = folder and folder:FindFirstChild("furniture")
    local data = getPlayerData()
    local interior = data and data.house_interior
    local pieces = type(interior) == "table" and type(interior.furniture) == "table" and interior.furniture or {}
    local list = {}
    for _, holder in ipairs(folder and folder:GetChildren() or {}) do
        if string.sub(holder.Name, 1, #main.Name + 1) == main.Name .. "/" then
            for _, model in ipairs(holder:GetChildren()) do
                local key = model:IsA("Model") and model:GetAttribute("furniture_unique")
                if type(key) == "string" then
                    table.insert(list, { key = key, model = model, piece = pieces[key] })
                end
            end
        end
    end
    return list
end

local function transferCycle()
    local main = Players:FindFirstChild(TRANSFER_MAIN)
    if not main then
        say("Transfer: " .. TRANSFER_MAIN .. " is not in this server", "warn")
        return
    elseif main == player then
        say("Transfer: this account is the Main", "warn")
        return
    elseif money() < TRANSFER_PAY then
        say("Transfer: not enough Bucks", "warn")
        return
    end
    if #mainFurniture(main) == 0 then
        if not interiorsM then
            pcall(function() interiorsM = require(ReplicatedStorage.ClientModules.Core.InteriorsM.InteriorsM) end)
        end
        if not interiorsM then
            say("Transfer: travel module not found", "bad")
            return
        end
        say("Heading to " .. main.Name .. "'s house...")
        task.spawn(pcall, interiorsM.enter, "housing", "MainDoor", { house_owner = main })
        if not waitUntil(function() return #mainFurniture(main) > 0 end, ARRIVAL_TIMEOUT) then
            say("Transfer: could not reach " .. main.Name .. "'s house", "bad")
            return
        end
        task.wait(2) -- the rest of the furniture is drawn a moment after the first piece
    end
    local api = ReplicatedStorage:WaitForChild("API")
    local sent = 0
    for _, f in ipairs(mainFurniture(main)) do
        local id = type(f.piece) == "table" and string.lower(tostring(f.piece.id or "")) or ""
        local register = f.model.Name == "CashRegister" or string.find(id, "cash_register", 1, true) ~= nil
        local version, price
        if id == "mannequins_2024_mannequin" then
            version, price = outfitOf(f.piece, f.model)
            price = price or TRANSFER_MAX_OUTFIT -- not readable: the usual price; a wrong one is refused and nothing is paid
        end
        local amount = register and TRANSFER_PAY or (version and price >= 1 and price <= TRANSFER_MAX_OUTFIT and price) or nil
        for _ = 1, amount and TRANSFER_PER_WINDOW or 0 do
            if not TransferMode or money() < amount or not f.model.Parent then
                break
            end
            pcall(function() player.Character:PivotTo(f.model:GetPivot() * CFrame.new(0, 0, -4)) end)
            local before = money()
            task.spawn(pcall, function()
                if register then
                    api:FindFirstChild("HousingAPI/ActivateFurniture"):InvokeServer(main, f.key, "UseBlock", TRANSFER_PAY, player.Character)
                else
                    api:FindFirstChild("AvatarAPI/BuyMannequinOutfit"):InvokeServer(main, f.key, version, amount)
                end
            end)
            -- paid only when my Bucks really dropped; otherwise this piece is resting (or refused): next piece
            if not waitUntil(function() return money() <= before - amount end, 6) then
                break
            end
            sent += amount
            say(string.format("Transfer: %d Bucks to %s (%s)", amount, main.Name, register and "Cash Register" or "mannequin " .. f.key), "ok")
            task.wait(1.5)
        end
    end
    say(string.format("Transfer: %d Bucks sent this round, next in %d s", sent, TRANSFER_REST), sent > 0 and "ok" or "info")
end

local function startTransfer()
    while TransferMode do
        local ok, err = pcall(transferCycle)
        if not ok then
            say("Transfer error: " .. tostring(err), "bad")
        end
        waitUntil(function() return not TransferMode end, TRANSFER_REST)
    end
end

