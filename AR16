        local mine = myName and allData[myName]
        if type(mine) == "table" then
            return mine, "ClientData.get_data()[playerName]"
        end
        if allData[GameConstants.DataKeys.Ailments] ~= nil or allData[GameConstants.DataKeys.Money] ~= nil then
