    function EventTasks.leverState(manager)
        local installed, activated = false, false
        local function scan(t, depth)
            for k, v in pairs(t) do
                local key = string.lower(tostring(k))
                if type(v) == "table" then
                    if depth < 2 then
                        scan(v, depth + 1)
                    end
                elseif v == true or (type(v) == "number" and v > 0) then
                    if string.find(key, "install") or string.find(key, "deliver") or string.find(key, "placed")
                        or string.find(key, "insert") then
                        installed = true
                    end
                    if string.find(key, "activ") or string.find(key, "pull") then
                        activated = true
                    end
                end
            end
        end
        if type(manager) == "table" then
            -- v3.0.46 (LeverTest + UseSpy 2026-10-18): "default" = no lever in the machine, Deliver -> "deactivated"
            -- = in but not pulled, Activate -> "activated" = pulled. (Before: "default" was read as "in", so a lever
            -- in the backpack was never delivered.) Another state = in and pulled (never blocks the farm on a guess)
            local leverState = manager.lever_state
            if type(leverState) == "string" then
                local lower = string.lower(leverState)
                if lower == "default" or lower == "" or lower == "none" or lower == "missing" then
                    return false, false
                end
                if lower == "deactivated" then
                    return true, false
                end
                return true, true
            end
            scan(manager, 0)
        end
        return installed, activated
    end
