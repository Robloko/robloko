        held = held or 0
        if placed >= E.NestTwigs then
            return "COMPLETE", placed, held
        elseif placed + held >= E.NestTwigs then
            return "BUILD_NEST", placed, held
        elseif (keys or 0) > 0 then
            return "COLLECT_TWIGS", placed, held
        end
        return "WAIT_KEY", placed, held
    end
