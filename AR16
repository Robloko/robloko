-- ---------- CRYSTAL: age potions -> 4x ant/mouse -> neon ----------
local CRYSTAL_FUSE_KINDS = { "basic_egg_2022_ant", "basic_egg_2022_mouse" }

local function potionCount()
    local data = getPlayerData()
    local n = 0
    for _, item in pairs(data and data.inventory and data.inventory.food or {}) do
        if item.id == "pet_age_potion" then
            n += 1
        end
    end
    return n
end

local function neonFuseSet(fusionSet)
    return pcall(function()
        local api = ReplicatedStorage.API:FindFirstChild("PetAPI/DoNeonFusion")
            or ReplicatedStorage.API:FindFirstChild("PetAPI/NeonFusion")
            or ReplicatedStorage.API:FindFirstChild("PetAPI/FuseNeon")
            or ReplicatedStorage.API:FindFirstChild("NeonAPI/Fuse")
        if not api then
            error("neon fusion API not found")
        end
        return api:InvokeServer(fusionSet)
    end)
end

-- For ant, then mouse: pick 4 non-neon pets (age-6 ones first, then the
-- oldest young ones), age the young ones with potions, then fuse to neon.
-- Pets in the pet pen or equipped are not touched.
local function crystalAgeAndFuse()
    local made = 0
    for _, kind in ipairs(CRYSTAL_FUSE_KINDS) do
        if not CrystalMode then
            break
        end
        local inPen = penPets()
        local grown, young = {}, {}
        for _, pet in ipairs(itemsOf("pets", function(id) return string.lower(id) == kind end)) do
            local props = type(pet.properties) == "table" and pet.properties or {}
            if not props.neon and not props.mega_neon and not inPen[pet.unique]
                and not isEquipped(pet.unique) and not isEgg(pet.id) then
                local age = tonumber(props.age) or 1
                if age >= POTION_TARGET_AGE then
                    table.insert(grown, pet.unique)
                else
                    table.insert(young, { unique = pet.unique, age = age })
                end
            end
        end
        table.sort(young, function(a, b) return a.age > b.age end)

        local needed = math.max(0, 4 - #grown)
        local potions = potionCount()
        if #grown + #young < 4 then
            say(prettyKind(kind) .. ": only " .. (#grown + #young) .. "/4 for neon", "info")
        elseif potions < needed then
            say(prettyKind(kind) .. ": need " .. needed .. " age potions, have " .. potions, "warn")
        else
            -- age up the young ones
            local ok = true
            for i = 1, needed do
                if not CrystalMode then
                    ok = false
                    break
                end
                say("Aging " .. prettyKind(kind) .. " " .. i .. "/" .. needed .. " with potion")
                usePotionOnPet(young[i].unique)
                task.wait(1)
                local age = getPetAge(young[i].unique)
                if age and age >= POTION_TARGET_AGE then
                    table.insert(grown, young[i].unique)
                else
                    say("Potion did not age " .. prettyKind(kind) .. " to 6", "bad")
                    ok = false
                    break
                end
            end
            -- fuse 4 grown into neon
            if ok and #grown >= 4 then
                local set = { grown[1], grown[2], grown[3], grown[4] }
                say("Fusing 4 " .. prettyKind(kind) .. " into NEON...")
                local fused, result = neonFuseSet(set)
                if fused then
                    say("Created NEON " .. prettyKind(kind) .. "!", "ok")
                    made += 1
                    task.wait(3)
                else
                    say("Neon fusion failed: " .. tostring(result), "bad")
                end
            end
        end
    end
    return made
end

local function startCrystal()
    while CrystalMode do
        -- Age up 4 ant / 4 mouse with potions and fuse them to neon
        crystalAgeAndFuse()

        setGoal(string.format("Crystal: tickets %d/%d, crystal eggs %d", penTickets(), CRYSTAL_PRICE, crystalEggCount()))

        -- Buy whenever there are enough tickets (no recycling needed)
        if penTickets() >= CRYSTAL_PRICE then
            local boughtNow = buyCrystalEggs()
            if boughtNow > 0 then
                say("Bought " .. boughtNow .. " crystal egg(s) with saved tickets", "ok")
            end
        end

        local pets = findPetsToRecycle()
        if #pets < CRYSTAL_MIN_PETS then
            say(#pets .. "/" .. CRYSTAL_MIN_PETS .. " recycle pets, " .. penTickets() .. "/" .. CRYSTAL_PRICE
                .. " tickets. Waiting 30 s...", "warn")
            task.wait(30)
            continue
        end
        say(#pets .. " recycle pets found - going to Nursery", "ok")
        if not recyclePets(pets) then
            say("Crystal recycle failed. Retrying in 10 s...", "warn")
            task.wait(10)
            continue
        end
        task.wait(2)
        local bought = buyCrystalEggs()
        if bought > 0 then
            say("Crystal cycle done: bought " .. bought .. " crystal egg(s)", "ok")
        else
            say("Recycled. Tickets " .. penTickets() .. "/" .. CRYSTAL_PRICE .. " - saving for crystal egg", "info")
        end
        task.wait(5)
    end
end

