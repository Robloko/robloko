        -- respawn and the game's doors did nothing): the remote route is allowed for a short rescue window that the
        -- task manager opens after 4 failed trips in a row in one place (Travel.remoteRescueUntil)
        local remoteOk = self._farmConfig and (self._farmConfig.RemoteRoute == true or Util.now() < (self.remoteRescueUntil or 0))
