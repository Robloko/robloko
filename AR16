        if farm.PetOrder == "potion" and not focus then
            local best = gameData:potionFarmPet()
            for _, pet in ipairs(gameData:equippedPetList()) do
                if pet.unique and tostring(pet.unique) == tostring(best) then
                    return pet.unique
                end
            end
        end
        return nil
    end
