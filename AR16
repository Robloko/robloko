        end
        if type(clientData.get_data) ~= "function" then
            return nil, "ClientData.get_data is not a function"
        end
        local callOk, allData = pcall(clientData.get_data)
        if not callOk then
            return nil, "ClientData.get_data() failed: " .. tostring(allData)
