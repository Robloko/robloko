                return self:goTo("MainMap") and self:goTo(destination)
            end)
            self._viaMainMap = nil
            if okMain and arrivedNow then
                return true
            end
        end
        return false, "still in " .. tostring(self._state:get("player.interior")) .. " after " .. ARRIVAL_TIMEOUT_SECONDS .. " s"
    end
