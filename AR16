    function EventTasks.cryptPlan(crypt, preferTwig)
        if type(crypt) ~= "table" or type(crypt.floors) ~= "table" then
            return nil, "crypt data not known yet"
        end
        if preferTwig then
            local twig = EventTasks.reachableTwigGrave(crypt)
            if twig then
