-- ================= MODES =================
local EggMode = false
local PetMode = false

-- ================= HELPERS =================
local function debugPrint(msg)
    print("[AutoGiver] " .. msg)
end

local function findFirstAvailablePlayer()
    for _, name in ipairs(TARGET_PLAYER_NAMES) do
        local p = Players:FindFirstChild(name)
        if p then return p end
    end
    return nil
end

local function getPlayerData()
    local ok, clientData = pcall(require, ReplicatedStorage.ClientModules.Core.ClientData)
    if not ok then return nil end
    local ok2, data = pcall(clientData.get_data, clientData)
    if not ok2 then return nil end
    return data and data[player.Name] or nil
end

-- Find items (searches pets AND gifts inventories) matching target list
local function findTargetItems(targetList)
    local found = {}
    local data = getPlayerData()
    if not data or not data.inventory then return found end

    for _, invType in ipairs({"pets", "gifts"}) do
        if data.inventory[invType] then
            for uid, itemData in pairs(data.inventory[invType]) do
                if itemData.id then
                    local id = string.lower(itemData.id)
                    for _, target in ipairs(targetList) do
                        if id == target then
                            table.insert(found, {uid = uid, name = itemData.id})
                            break
                        end
                    end
                end
            end
        end
    end
    return found
end

-- ================= EGG TRADING (eggs can only be traded) =================
local function addEggsToTrade(eggs)
    local maxEggs = math.min(#eggs, 18) -- trade limit
    local added = 0

    for i = 1, maxEggs do
        local success = pcall(function()
            ReplicatedStorage:WaitForChild("API"):WaitForChild("TradeAPI/AddItemToOffer"):FireServer(eggs[i].uid)
        end)
        if success then
            added = added + 1
            debugPrint("Added egg " .. i .. "/" .. maxEggs .. ": " .. eggs[i].name)
        end
        task.wait(0.2)
    end
    return added
end

local function tradeEggsWithPlayer(targetPlayer)
    debugPrint("Sending trade request to " .. targetPlayer.Name)

    -- Send trade request
    local ok1 = pcall(function()
        ReplicatedStorage:WaitForChild("API"):WaitForChild("TradeAPI/SendTradeRequest"):FireServer(targetPlayer)
    end)
    if not ok1 then
        debugPrint("Failed to send trade request")
        return false
    end
    task.wait(3)

    -- Accept trade request
    local ok2 = pcall(function()
        return ReplicatedStorage:WaitForChild("API"):WaitForChild("TradeAPI/AcceptOrDeclineTradeRequest"):InvokeServer(targetPlayer, true)
    end)
    if not ok2 then
        debugPrint("Failed to accept trade request")
        return false
    end
    debugPrint("Trade accepted")
    task.wait(3)

    -- Add eggs to trade
    local eggs = findTargetItems(TARGET_EGGS)
    if #eggs == 0 then
        debugPrint("No eggs to trade")
        return false
    end
    local added = addEggsToTrade(eggs)
    if added == 0 then
        debugPrint("No eggs added to trade")
        return false
    end
    task.wait(3)

    -- Accept negotiation
    local ok3 = pcall(function()
        ReplicatedStorage:WaitForChild("API"):WaitForChild("TradeAPI/AcceptNegotiation"):FireServer()
    end)
    if not ok3 then
        debugPrint("Failed to accept negotiation")
        return false
    end
    task.wait(6)

    -- Confirm trade
    local ok4 = pcall(function()
        ReplicatedStorage:WaitForChild("API"):WaitForChild("TradeAPI/ConfirmTrade"):FireServer()
    end)
    if ok4 then
        debugPrint("Trade completed: " .. added .. " eggs traded to " .. targetPlayer.Name)
        return true
    else
        debugPrint("Failed to confirm trade")
        return false
    end
end

local function startEggTrader()
    while EggMode do
        local eggs = findTargetItems(TARGET_EGGS)
        if #eggs == 0 then
            debugPrint("No eggs left! Stopping.")
            EggMode = false
            break
        end

        local target = findFirstAvailablePlayer()
        if not target then
            debugPrint("No target player. Waiting...")
            task.wait(10)
            continue
        end

        local success = tradeEggsWithPlayer(target)
        if success then
            task.wait(math.random(8, 12))
        else
            debugPrint("Trade failed. Retrying in 15 seconds...")
            task.wait(15)
        end
    end
end

-- ================= PET GIVING (instant GiveItem) =================
local function givePet(targetPlayer, uid)
    local success, result = pcall(function()
        return ReplicatedStorage:WaitForChild("API"):WaitForChild("TradeAPI/GiveItem"):InvokeServer(targetPlayer, uid)
    end)
    if success then
        debugPrint("Gave pet to " .. targetPlayer.Name)
        return true
    else
        debugPrint("Failed to give pet: " .. tostring(result))
        return false
    end
end

local function startPetGiver()
    while PetMode do
        local target = findFirstAvailablePlayer()
        if not target then
            debugPrint("No target player. Waiting...")
            task.wait(10)
            continue
        end

        local pets = findTargetItems(TARGET_PETS)
        if #pets == 0 then
            debugPrint("No target pets left! Stopping.")
            PetMode = false
            break
        end

        if givePet(target, pets[1].uid) then
            task.wait(9)
        else
            task.wait(3)
        end
    end
end

-- ================= UI =================
local function createUI()
    local screenGui = Instance.new("ScreenGui")
    screenGui.Name = "SimpleAutoGiverUI"
    screenGui.Parent = player:WaitForChild("PlayerGui")

    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(0, 180, 0, 105)
    frame.Position = UDim2.new(0, 10, 1, -115)
    frame.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    frame.BorderSizePixel = 0
    frame.Parent = screenGui

    Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 6)

    -- Draggable
    local dragging, dragStart, startPos = false, nil, nil
    frame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            dragStart = input.Position
            startPos = frame.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)
    frame.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement and dragging then
            local delta = input.Position - dragStart
            frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)

    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(1, 0, 0, 22)
    title.BackgroundTransparency = 1
    title.TextColor3 = Color3.fromRGB(255, 255, 255)
    title.Text = "Auto Giver"
    title.Font = Enum.Font.SourceSansBold
    title.TextSize = 14
    title.Parent = frame

    -- Egg button (TRADE)
    local eggButton = Instance.new("TextButton")
    eggButton.Size = UDim2.new(0.85, 0, 0, 28)
    eggButton.Position = UDim2.new(0.075, 0, 0, 28)
    eggButton.BackgroundColor3 = Color3.fromRGB(200, 150, 0)
    eggButton.TextColor3 = Color3.fromRGB(255, 255, 255)
    eggButton.Text = "TRADE EGGS [OFF]"
    eggButton.Font = Enum.Font.SourceSansBold
    eggButton.TextSize = 13
    eggButton.Parent = frame
    Instance.new("UICorner", eggButton).CornerRadius = UDim.new(0, 4)

    -- Pet button (GIVE)
    local petButton = Instance.new("TextButton")
    petButton.Size = UDim2.new(0.85, 0, 0, 28)
    petButton.Position = UDim2.new(0.075, 0, 0, 64)
    petButton.BackgroundColor3 = Color3.fromRGB(0, 120, 200)
    petButton.TextColor3 = Color3.fromRGB(255, 255, 255)
    petButton.Text = "GIVE PETS [OFF]"
    petButton.Font = Enum.Font.SourceSansBold
    petButton.TextSize = 13
    petButton.Parent = frame
    Instance.new("UICorner", petButton).CornerRadius = UDim.new(0, 4)

    eggButton.MouseButton1Click:Connect(function()
        EggMode = not EggMode
        eggButton.Text = EggMode and "TRADE EGGS [ON]" or "TRADE EGGS [OFF]"
        eggButton.BackgroundColor3 = EggMode and Color3.fromRGB(0, 170, 0) or Color3.fromRGB(200, 150, 0)
        if EggMode then
            coroutine.wrap(startEggTrader)()
            debugPrint("Egg trader started")
        else
            debugPrint("Egg trader stopped")
        end
    end)

    petButton.MouseButton1Click:Connect(function()
        PetMode = not PetMode
        petButton.Text = PetMode and "GIVE PETS [ON]" or "GIVE PETS [OFF]"
        petButton.BackgroundColor3 = PetMode and Color3.fromRGB(0, 170, 0) or Color3.fromRGB(0, 120, 200)
        if PetMode then
            coroutine.wrap(startPetGiver)()
            debugPrint("Pet giver started")
        else
            debugPrint("Pet giver stopped")
        end
    end)
end

createUI()
