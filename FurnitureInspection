-- COMPACT FURNITURE INSPECTOR (names + counts only)
-- Target: workspace.HouseInteriors.furniture[<houseKey>].<Model>

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local player = Players.LocalPlayer

local counts = {}

local hi = Workspace:FindFirstChild("HouseInteriors")
local furniture = hi and hi:FindFirstChild("furniture")
if not furniture then
    warn("[Inspector] furniture folder missing")
    return
end

for _, house in ipairs(furniture:GetChildren()) do
    if house:IsA("Folder") or house:IsA("Model") then
        for _, model in ipairs(house:GetChildren()) do
            if model:IsA("Model") then
                local key = model.Name:lower()
                counts[key] = counts[key] or { display = model.Name, total = 0 }
                counts[key].total += 1
            end
        end
    end
end

local list = {}
for _, e in pairs(counts) do table.insert(list, e) end
table.sort(list, function(a, b) return a.display:lower() < b.display:lower() end)

print(string.format("FURNITURE (%s):", player.Name))
for _, e in ipairs(list) do
    print(string.format("  %s x%d", e.display, e.total))
end
