-- FURNITURE INSPECTOR (correct nesting)
-- Target: workspace.HouseInteriors.furniture[<houseKey>].<FurnitureModel>.UseBlocks[.UseBlock]
-- Place in a LocalScript or run via executor.

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local player = Players.LocalPlayer

local TRACKED_NAMES = {
    "ModernShower",
    "BasicBed",
    "PetFoodBowl",
    "PetWaterBowl",
    "CheapPetBathtub",
    "Piano",
    "AilmentsRefresh2024LitterBox",
}
local trackedSet = {}
for _, n in ipairs(TRACKED_NAMES) do trackedSet[n:lower()] = n end

local function sep(c, n) return string.rep(c or "=", n or 74) end

local function findActivationPart(model)
    -- exact order the PetFarm script uses
    local ub = model:FindFirstChild("UseBlocks")
    if ub then
        for _, pname in ipairs({"UseBlock", "Seat1"}) do
            local p = ub:FindFirstChild(pname)
            if p and p:IsA("BasePart") then return p, "UseBlocks/" .. p.Name end
        end
    end
    for _, pname in ipairs({"UseBlock", "Seat1"}) do
        local p = model:FindFirstChild(pname)
        if p and p:IsA("BasePart") then return p, p.Name end
    end
    for _, d in ipairs(model:GetDescendants()) do
        if d:IsA("BasePart") then return d, "(fallback) " .. d.Name end
    end
    return nil, nil
end

local function report()
    print(sep("="))
    print("FURNITURE INSPECTION  →  workspace.HouseInteriors.furniture[<houseKey>]")
    print("Player: " .. player.Name .. "   Time: " .. os.date("%Y-%m-%d %H:%M:%S"))
    print(sep("="))

    local hi = Workspace:FindFirstChild("HouseInteriors")
    if not hi then warn("HouseInteriors not found.") return end

    local furniture = hi:FindFirstChild("furniture")
    if not furniture then
        warn("'furniture' folder not found inside HouseInteriors.")
        print("Children of HouseInteriors:")
        for _, c in ipairs(hi:GetChildren()) do
            print(string.format("   - %s (%s)", c.Name, c.ClassName))
        end
        return
    end

    print("furniture class: " .. furniture.ClassName)
    local houseKeys = furniture:GetChildren()
    print(string.format("House keys under furniture: %d", #houseKeys))
    for _, hk in ipairs(houseKeys) do
        print(string.format("   • [%s]  (%s)", hk.Name, hk.ClassName))
    end
    print("")

    local foundTracked = {}   -- [trackedName] = { houseKey, modelPath, partPath }
    local totalModels = 0
    local totalPartsReported = 0

    for _, houseKeyFolder in ipairs(houseKeys) do
        -- Accept Folder or Model as the house container
        if houseKeyFolder:IsA("Folder") or houseKeyFolder:IsA("Model") then
            print(sep("-"))
            print(string.format("🏠 House key: %s  (%s)", houseKeyFolder.Name, houseKeyFolder.ClassName))

            local models = {}
            for _, child in ipairs(houseKeyFolder:GetChildren()) do
                if child:IsA("Model") then
                    table.insert(models, child)
                end
            end

            if #models == 0 then
                print("   (no Model children)")
            else
                table.sort(models, function(a, b) return a.Name:lower() < b.Name:lower() end)
                for _, model in ipairs(models) do
                    totalModels += 1
                    local lower = model.Name:lower()
                    local trackedName = trackedSet[lower]
                    local tag = trackedName and "  ✅ TRACKED" or ""

                    local part, partPath = findActivationPart(model)
                    if part then totalPartsReported += 1 end

                    local posInfo = part and string.format("@ %.1f, %.1f, %.1f", part.Position.X, part.Position.Y, part.Position.Z) or "@ <none>"
                    print(string.format("   • %-35s %s%s", model.Name, posInfo, tag))
                    if part then
                        print(string.format("       part path: %s.%s.%s", houseKeyFolder.Name, model.Name, partPath))
                    else
                        print(string.format("       ❌ no BasePart found under %s", model.Name))
                    end

                    if trackedName and not foundTracked[trackedName] then
                        foundTracked[trackedName] = {
                            houseKey = houseKeyFolder.Name,
                            model = model.Name,
                            partPath = partPath,
                        }
                    end
                end
            end
        end
    end

    print("")
    print(sep("="))
    print("SUMMARY")
    print(sep("-"))
    print(string.format("Total furniture models: %d   with usable parts: %d", totalModels, totalPartsReported))
    print("")
    print("Tracked furniture status:")
    for _, name in ipairs(TRACKED_NAMES) do
        local f = foundTracked[name]
        if f then
            print(string.format("   ✅ %-32s %s.%s.%s", name, f.houseKey, f.model, f.partPath))
        else
            print(string.format("   ❌ %-32s NOT FOUND", name))
        end
    end
    print(sep("="))
end

report()
