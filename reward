local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

local function clickRewardsButton()
    local button = PlayerGui:FindFirstChild("MinigameRewardsApp")
        and PlayerGui.MinigameRewardsApp:FindFirstChild("Body")
        and PlayerGui.MinigameRewardsApp.Body:FindFirstChild("Button")

    -- Checks if button exists and is a GuiButton, but ignores if it is visible or active
    if button and button:IsA("GuiButton") then
        if firesignal then
            firesignal(button.MouseButton1Down)
            task.wait(0.05)
            firesignal(button.MouseButton1Up)
            firesignal(button.MouseButton1Click)
            print("Successfully force-clicked MinigameRewards Button!")
        else
            button.MouseButton1Click:Fire()
            print("Successfully force-clicked MinigameRewards Button!")
        end
    end
end

-- Loops exactly once every 5 minutes (300 seconds)
while true do
    pcall(clickRewardsButton)
    task.wait(300) 
end
