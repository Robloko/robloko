local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

local function clickRewardsButton()
    local button = PlayerGui:FindFirstChild("MinigameRewardsApp")
        and PlayerGui.MinigameRewardsApp:FindFirstChild("Body")
        and PlayerGui.MinigameRewardsApp.Body:FindFirstChild("Button")

    if button then
        if button.Visible and button.Active and button:IsA("GuiButton") then

            if firesignal then
                firesignal(button.MouseButton1Down)
                task.wait(0.05)
                firesignal(button.MouseButton1Up)
                firesignal(button.MouseButton1Click)
                print("Successfully clicked MinigameRewards Button!")
            else
                button.MouseButton1Click:Fire()
                print("Successfully clicked MinigameRewards Button!")
            end

            task.wait(2)
        end
    end
end

while task.wait(0.5) do
    pcall(clickRewardsButton)
end
