local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

local clicked = false -- reset when popup hides

task.spawn(function()
    while task.wait(0.5) do
        pcall(function()
            local button = PlayerGui:FindFirstChild("MinigameRewardsApp")
                and PlayerGui.MinigameRewardsApp:FindFirstChild("Body")
                and PlayerGui.MinigameRewardsApp.Body:FindFirstChild("Button")

            if not button or not button.Visible then
                clicked = false -- popup closed, allow next click
                return
            end

            if not clicked and button.Active and button:IsA("GuiButton") then
                if firesignal then
                    firesignal(button.MouseButton1Down)
                    task.wait(0.05)
                    firesignal(button.MouseButton1Up)
                    firesignal(button.MouseButton1Click)
                else
                    button.MouseButton1Click:Fire()
                end
                clicked = true
                print("Clicked MinigameRewards Button (once)")
            end
        end)
    end
end)
