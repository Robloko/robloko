-- ================= NEON FUSER =================
local function doNeonFusion()
    local data = getPlayerData()
    if not data or not data.inventory or not data.inventory.pets then
        say("No pet data available", "bad")
        return 0
    end

    local fullGrownPets = {}
    for id, pet in pairs(data.inventory.pets) do
        local isNeon = pet.properties and pet.properties.neon or false
        local isMega = pet.properties and pet.properties.mega or false
        local age = pet.properties and pet.properties.age or 0
        local petName = pet.id
        if petName and not isNeon and not isMega and age == 6 then
            fullGrownPets[petName] = fullGrownPets[petName] or {}
            table.insert(fullGrownPets[petName], id)
        end
    end

    local fused = 0
    for petType, petList in pairs(fullGrownPets) do
        while #petList >= 4 do
            local fusionSet = {}
            for i = 1, 4 do
                table.insert(fusionSet, petList[1])
                table.remove(petList, 1)
            end
            say("Fusing 4 Full Grown " .. petType .. " into NEON...")
            local success, err = pcall(function()
                local neonAPI = ReplicatedStorage.API:FindFirstChild("PetAPI/DoNeonFusion")
                if neonAPI then
                    return neonAPI:InvokeServer(fusionSet)
                end
                local altAPI = ReplicatedStorage.API:FindFirstChild("PetAPI/NeonFusion")
                    or ReplicatedStorage.API:FindFirstChild("PetAPI/FuseNeon")
                    or ReplicatedStorage.API:FindFirstChild("NeonAPI/Fuse")
                if altAPI then
                    return altAPI:InvokeServer(fusionSet)
                end
                error("neon fusion API not found")
            end)
            if success and err ~= nil then
                say("Created NEON " .. petType .. "!", "ok")
                fused += 1
                task.wait(3)
            else
                say("Fusion failed for " .. petType .. ": " .. tostring(err), "bad")
                for _, id in ipairs(fusionSet) do
                    table.insert(petList, id)
                end
                break
            end
        end
    end
    return fused
end

local function startNeonFuser()
    while NeonMode do
        local fused = doNeonFusion()
        if fused == 0 then
            say("No 4x full-grown (age 6) pets to fuse. Waiting 30 s...", "warn")
            task.wait(30)
        else
            say("NEON fusion pass complete: " .. fused .. " created", "ok")
            task.wait(5)
        end
    end
end

