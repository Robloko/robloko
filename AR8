-- ==================================================================
-- PET PEN SYSTEM (PetFarm-style: neon fusion, purge trash,
-- remove age-6 pets, refill priority:
--   1. NEON pets under age 6
--   2. inventory recycler eggs FIRST, then other priority pets/eggs
--   3. buy recycler egg with TICKETS, else cracked egg with Bucks
-- Empty slots are ALWAYS filled.)
-- ==================================================================
local penPrioritySet = {}
for _, v in ipairs(PEN_PRIORITY_EGGS) do penPrioritySet[string.lower(v)] = true end

local function penSnapshot()
    local data = getPlayerData()
    if not data or not data.idle_progression_manager or not data.idle_progression_manager.active_pets then
        return {}
    end
    local snapshot = {}
    for uniqueId, _ in pairs(data.idle_progression_manager.active_pets) do
        local pet = data.inventory and data.inventory.pets and data.inventory.pets[uniqueId]
        if pet then
            table.insert(snapshot, {
                unique_id = uniqueId,
                name = pet.id,
                age = pet.properties and pet.properties.age or 0,
                neon = pet.properties and pet.properties.neon or false,
            })
        end
    end
    return snapshot
end

local function penAddPet(uniqueId)
    local ok = pcall(function()
        ReplicatedStorage:WaitForChild("API"):WaitForChild("IdleProgressionAPI/AddPet"):FireServer(uniqueId)
    end)
    return ok
end

local function penRemovePet(uniqueId)
    local ok = pcall(function()
        ReplicatedStorage:WaitForChild("API"):WaitForChild("IdleProgressionAPI/RemovePet"):FireServer(uniqueId)
    end)
    return ok
end

-- Remove everything from the pen that isn't a NEON or a priority pet
local function penPurgeTrash()
    local data = getPlayerData()
    if not data or not data.idle_progression_manager or not data.idle_progression_manager.active_pets then
        return 0
    end
    local removed = 0
    for uniqueId, _ in pairs(data.idle_progression_manager.active_pets) do
        local pet = data.inventory and data.inventory.pets and data.inventory.pets[uniqueId]
        if pet and pet.id and pet.properties then
            local isNeon = pet.properties.neon or false
            local cleanName = string.lower(pet.id)
            if not isNeon and not penPrioritySet[cleanName] then
                say("Purging trash from pen: " .. prettyKind(pet.id), "info")
                penRemovePet(uniqueId)
                removed += 1
                task.wait(0.7)
            end
        end
    end
    return removed
end

-- Buy one egg: recycler egg ONLY if we have tickets, else cracked egg with Bucks
local function penBuyOneEgg()
    local tickets = penTickets()

    -- 1) recycler egg with tickets (only if tickets above reserve)
    if PEN_USE_RECYCLER_FIRST and tickets > PEN_TICKET_RESERVE then
        say("Buying a recycler egg with tickets (" .. tickets .. " left)", "info")
        local before = #itemsOf("pets", nil)
        pcall(function()
            ReplicatedStorage:WaitForChild("API"):FindFirstChild("ShopAPI/BuyItem"):InvokeServer(
                "pets", PEN_RECYCLER_EGG, { buy_count = 1 })
        end)
        if waitUntil(function() return #itemsOf("pets", nil) > before end, 8) then
            return PEN_RECYCLER_EGG
        end
        pcall(function()
            ReplicatedStorage:WaitForChild("API"):FindFirstChild("RecyclerAPI/BuyEgg"):InvokeServer(
                PEN_RECYCLER_EGG, { buy_count = 1 })
        end)
        if waitUntil(function() return #itemsOf("pets", nil) > before end, 5) then
            return PEN_RECYCLER_EGG
        end
        say("Recycler purchase failed, falling back to cracked egg", "warn")
    end

    -- 2) no tickets (or recycler failed): cracked egg with Bucks
    if canAfford(PEN_CRACKED_PRICE) then
        say("Buying a Cracked Egg (" .. PEN_CRACKED_PRICE .. " Bucks)", "info")
        local before = #itemsOf("pets", nil)
        pcall(function()
            ReplicatedStorage:WaitForChild("API"):FindFirstChild("ShopAPI/BuyItem"):InvokeServer(
                "pets", PEN_CRACKED_EGG, { buy_count = 1 })
        end)
        if waitUntil(function() return #itemsOf("pets", nil) > before end, 8) then
            return PEN_CRACKED_EGG
        end
        return nil
    end

    return nil
end

-- Fill empty pen slots: 1) NEON pets under age 6,
-- 2) inventory priority pets/eggs (recycler egg first, list order),
-- 3) ALWAYS buy eggs (tickets -> recycler egg, else Bucks -> cracked egg)
local function penAddPriorityPets(snapshot)
    local data = getPlayerData()
    if not data or not data.inventory or not data.inventory.pets then
        return 0
    end
    local slotsOpen = PEN_SLOTS - #snapshot
    if slotsOpen <= 0 then
        return 0
    end

    local inPen = {}
    for _, pet in ipairs(snapshot) do
        inPen[pet.unique_id] = true
    end

    local added = 0
    local addedSet = {}

    -- Priority 1: NEON pets (must be under age 6)
    for uniqueId, petData in pairs(data.inventory.pets) do
        local petAge = petData.properties and petData.properties.age or 0
        if petData.properties and petData.properties.neon and petAge < 6
            and not inPen[uniqueId] and added < slotsOpen and not addedSet[uniqueId] then
            penAddPet(uniqueId)
            say("Added NEON to pen: " .. prettyKind(petData.id) .. " (Age " .. petAge .. ")", "ok")
            added += 1
            addedSet[uniqueId] = true
            inPen[uniqueId] = true
            task.wait(0.6)
        end
    end

    -- Priority 2: exact priority pet/egg match in list order
    -- (pet_recycler_2025_basic_egg is FIRST in the list, so inventory
    --  recycler eggs are always used before any other priority pet)
    for _, eggName in ipairs(PEN_PRIORITY_EGGS) do
        for uniqueId, petData in pairs(data.inventory.pets) do
            local petAge = petData.properties and petData.properties.age or 0
            if string.lower(petData.id or "") == string.lower(eggName) and petAge < 6
                and not inPen[uniqueId] and added < slotsOpen and not addedSet[uniqueId] then
                penAddPet(uniqueId)
                say("Added PRIORITY to pen: " .. prettyKind(petData.id) .. " (Age " .. petAge .. ")", "ok")
                added += 1
                addedSet[uniqueId] = true
                inPen[uniqueId] = true
                task.wait(0.6)
            end
        end
    end

    -- Priority 3: ALWAYS auto-buy eggs to fill remaining empty slots
    while added < slotsOpen and PenMode do
        local eggKind = penBuyOneEgg()
        if not eggKind then
            say("No tickets and not enough Bucks (" .. money() .. ") - can't buy more eggs", "warn")
            break
        end

        task.wait(3) -- wait for server to replicate the purchase
        local newData = getPlayerData()
        if not (newData and newData.inventory and newData.inventory.pets) then
            break
        end

        local foundEgg = false
        for uniqueId, petData in pairs(newData.inventory.pets) do
            local petAge = petData.properties and petData.properties.age or 0
            if string.lower(petData.id or "") == string.lower(eggKind) and petAge < 6
                and not inPen[uniqueId] and not addedSet[uniqueId] then
                penAddPet(uniqueId)
                say("Added PURCHASED " .. prettyKind(eggKind) .. " to pen", "ok")
                added += 1
                addedSet[uniqueId] = true
                inPen[uniqueId] = true
                foundEgg = true
                task.wait(0.6)
                break
            end
        end
        if not foundEgg then
            say("Bought egg but couldn't find it in inventory - stopping auto-buy", "warn")
            break
        end
    end

    say("Pen refill: added " .. added .. " pet(s) this cycle", "info")
    return added
end

local function startPenFiller()
    say("Pet Pen started (PetFarm-style cycles)", "ok")
    while PenMode do
        local snapshot = penSnapshot()
        setGoal(string.format("Pet Pen %d/%d  (tickets %d, bucks %d)",
            #snapshot, PEN_SLOTS, penTickets(), money()))

        -- 0. Commit progression FIRST to update pet ages locally
        if PEN_COMMIT_FIRST then
            pcall(function()
                ReplicatedStorage.API["IdleProgressionAPI/CommitAllProgression"]:FireServer()
            end)
            say("Committed progression to refresh age data", "info")
            task.wait(3)
        end

        -- 1. Neon fusion pass (4x age-6 non-neon pets of the same type)
        local fusions = doNeonFusion()
        if fusions > 0 then
            task.wait(5)
        end

        -- 2. Purge non-priority trash from the pen
        penPurgeTrash()
        task.wait(2)

        -- 3. Remove aged (6+) pets from the pen
        snapshot = penSnapshot()
        for _, pet in ipairs(snapshot) do
            if pet.age >= 6 then
                say("Removing aged pet from pen: " .. prettyKind(pet.name) .. " (Age " .. pet.age .. ")", "info")
                penRemovePet(pet.unique_id)
                task.wait(0.7)
            end
        end

        -- 4. Refill (inventory recycler eggs first, then tickets->recycler,
        --    else Bucks->cracked egg, until all slots are full)
        task.wait(2)
        snapshot = penSnapshot()
        penAddPriorityPets(snapshot)

        setGoal(string.format("Pet Pen %d/%d  (tickets %d, bucks %d)",
            #penSnapshot(), PEN_SLOTS, penTickets(), money()))
        task.wait(PEN_CYCLE_SECONDS)
    end
    say("Pet Pen stopped", "warn")
end

