local function getPlayerData()
    local ok, clientData = pcall(function()
        return require(ReplicatedStorage.ClientModules.Core.ClientData)
    end)
    if not ok then
        return nil
    end
    local ok2, data = pcall(function() return clientData.get_data() end)
    if not ok2 then
        return nil
    end
    return data and data[player.Name] or nil
end

local function findTargetItems(targetList)
    local found = {}
    local data = getPlayerData()
    if not data or not data.inventory then
        return found
    end
    for _, invType in ipairs({ "pets", "gifts" }) do
        if data.inventory[invType] then
            for uid, itemData in pairs(data.inventory[invType]) do
                if itemData.id then
                    local id = string.lower(itemData.id)
                    for _, target in ipairs(targetList) do
                        if id == target then
                            table.insert(found, { uid = uid, name = itemData.id, amount = itemData.amount or 1 })
                            break
                        end
                    end
                end
            end
        end
    end
    return found
end

local function findGifts()
    local gifts = {}
    local data = getPlayerData()
    if data and data.inventory and data.inventory.gifts then
        for uid, giftData in pairs(data.inventory.gifts) do
            if giftData.id and string.lower(giftData.id) == GIFT_TYPE then
                table.insert(gifts, { uid = uid, amount = giftData.amount or 1 })
            end
        end
    end
    return gifts
end

